{%- comment -%}
  tapi-product-reviews — renders ACTIVE customer reviews for a product from the
  custom.reviews list (product_review metaobjects), a star summary, and Product
  JSON-LD aggregateRating + review (only when at least one review exists).

  Reviews are written by the whatsapp-automation service (Flow B); only ACTIVE
  (consented + moderation-passed) reviews are linked to the product, so this list
  needs no client-side filtering. Follows the theme's tapi-* conventions: inline
  SVG stars, no emoji, brand tokens, no em/en dash.

  Wire into sections/main-product-tapi.liquid with:
    {% render 'tapi-product-reviews', product: product %}
{%- endcomment -%}

{%- assign reviews = product.metafields.custom.reviews.value -%}
{%- assign count = reviews | size -%}

{%- if count > 0 -%}
  {%- assign total = 0 -%}
  {%- for r in reviews -%}
    {%- assign total = total | plus: r.rating.value -%}
  {%- endfor -%}
  {%- assign avg = total | times: 1.0 | divided_by: count -%}
  {%- assign avg_rounded = avg | round: 1 -%}

  <section class="tapi-reviews" aria-label="Customer reviews">
    <div class="tapi-reviews__head">
      <h2 class="tapi-reviews__title">What buyers say</h2>
      <div class="tapi-reviews__summary">
        <span class="tapi-reviews__stars" aria-hidden="true">
          {%- assign full = avg | round -%}
          {%- for i in (1..5) -%}
            <svg viewBox="0 0 20 20" class="tapi-star {% if i <= full %}is-on{% endif %}" width="18" height="18"><path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 15l-5.2 2.6 1-5.8L1.5 7.7l5.9-.9z"/></svg>
          {%- endfor -%}
        </span>
        <span class="tapi-reviews__avg">{{ avg_rounded }} out of 5</span>
        <span class="tapi-reviews__count">({{ count }} {% if count == 1 %}review{% else %}reviews{% endif %})</span>
      </div>
    </div>

    <ul class="tapi-reviews__list" data-tapi-reviews>
      {%- for r in reviews -%}
        <li class="tapi-review {% if forloop.index > 5 %}tapi-review--more is-hidden{% endif %}">
          <div class="tapi-review__top">
            <span class="tapi-reviews__stars" aria-label="{{ r.rating.value }} out of 5">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 20 20" class="tapi-star {% if i <= r.rating.value %}is-on{% endif %}" width="14" height="14"><path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 15l-5.2 2.6 1-5.8L1.5 7.7l5.9-.9z"/></svg>
              {%- endfor -%}
            </span>
            {%- if r.verified_buyer.value -%}<span class="tapi-review__verified">Verified buyer</span>{%- endif -%}
          </div>
          <p class="tapi-review__body">{{ r.body.value | escape | newline_to_br }}</p>
          <p class="tapi-review__meta">
            {{ r.author_name.value | escape }}
            {%- if r.fit.value and r.fit.value != 'not_sure' -%} · Fit: {{ r.fit.value | replace: '_', ' ' }}{%- endif -%}
            {%- if r.submitted_at.value -%} · {{ r.submitted_at.value | date: '%d %b %Y' }}{%- endif -%}
          </p>
        </li>
      {%- endfor -%}
    </ul>

    {%- if count > 5 -%}
      <button type="button" class="tapi-reviews__more button button--outline" data-tapi-reviews-more>Show more reviews</button>
    {%- endif -%}
  </section>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "aggregateRating": { "@type": "AggregateRating", "ratingValue": "{{ avg_rounded }}", "reviewCount": "{{ count }}" },
    "review": [
      {%- for r in reviews limit: 20 -%}
      {
        "@type": "Review",
        "reviewRating": { "@type": "Rating", "ratingValue": "{{ r.rating.value }}", "bestRating": "5" },
        "author": { "@type": "Person", "name": {{ r.author_name.value | json }} },
        "reviewBody": {{ r.body.value | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  </script>

  <style>
  .tapi-reviews { margin-block: var(--section-pad-md, 4.5rem); }
  .tapi-reviews__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 1rem 2rem; margin-bottom: 2.4rem; }
  .tapi-reviews__title { margin: 0; font-family: var(--font-heading-family, inherit); }
  .tapi-reviews__summary { display: flex; align-items: center; gap: 0.8rem; font-size: var(--fs-sm, 1.4rem); }
  .tapi-reviews__stars { display: inline-flex; gap: 1px; }
  .tapi-star { fill: rgba(var(--color-foreground), 0.18); }
  .tapi-star.is-on { fill: var(--tapi-gold, #c9a24b); }
  .tapi-reviews__count { color: rgba(var(--color-foreground), 0.6); }
  .tapi-reviews__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem; }
  .tapi-review { border-top: 1px solid rgba(var(--color-foreground), 0.1); padding-top: 1.6rem; }
  .tapi-review.is-hidden { display: none; }
  .tapi-review__top { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.6rem; }
  .tapi-review__verified { font-size: 1.1rem; color: var(--tapi-green, #4a6b4a); background: rgba(74,107,74,0.08); padding: 0.2rem 0.7rem; border-radius: 999px; }
  .tapi-review__body { margin: 0 0 0.6rem; line-height: 1.6; }
  .tapi-review__meta { margin: 0; font-size: 1.2rem; color: rgba(var(--color-foreground), 0.6); }
  .tapi-reviews__more { margin-top: 2rem; }
  </style>

  <script>
    (function () {
      var btn = document.querySelector('[data-tapi-reviews-more]');
      if (!btn) return;
      btn.addEventListener('click', function () {
        document.querySelectorAll('.tapi-review--more').forEach(function (el) { el.classList.remove('is-hidden'); });
        btn.remove();
      });
    })();
  </script>
{%- endif -%}
