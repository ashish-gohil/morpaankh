{
  "version": "5.1",
  "screens": [
    {
      "id": "RATE",
      "title": "Rate your order",
      "terminal": true,
      "success": true,
      "data": {
        "first_name": {
          "type": "string",
          "__example__": "Aarav"
        },
        "percent_text": {
          "type": "string",
          "__example__": "5%"
        },
        "min_order_text": {
          "type": "string",
          "__example__": "Rs 1,500"
        },
        "show_product": {
          "type": "boolean",
          "__example__": true
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "Bandhan kurta set"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Tell us honestly how it turned out. A fair word helps the next person more than a kind one. As a thank you we will send you a code for ${data.percent_text} off your next order of ${data.min_order_text} or more, whatever you rate us."
          },
          {
            "type": "Dropdown",
            "name": "product",
            "label": "Which product are you reviewing?",
            "required": true,
            "visible": "${data.show_product}",
            "data-source": "${data.products}"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "rating",
            "label": "How would you rate your order?",
            "required": true,
            "data-source": [
              {
                "id": "5",
                "title": "5: Loved it"
              },
              {
                "id": "4",
                "title": "4: Good"
              },
              {
                "id": "3",
                "title": "3: Okay"
              },
              {
                "id": "2",
                "title": "2: Not great"
              },
              {
                "id": "1",
                "title": "1: Poor"
              }
            ]
          },
          {
            "type": "RadioButtonsGroup",
            "name": "fit",
            "label": "How was the fit?",
            "required": false,
            "data-source": [
              {
                "id": "too_tight",
                "title": "Too tight"
              },
              {
                "id": "just_right",
                "title": "Just right"
              },
              {
                "id": "too_loose",
                "title": "Too loose"
              },
              {
                "id": "not_sure",
                "title": "Not sure"
              }
            ]
          },
          {
            "type": "TextArea",
            "name": "review",
            "label": "Your review",
            "required": true,
            "helper-text": "What did you like, and what could be better? Please be honest.",
            "max-length": 600
          },
          {
            "type": "TextInput",
            "name": "display_name",
            "label": "Name to show with your review",
            "required": false,
            "init-value": "${data.first_name}",
            "helper-text": "Only used if you choose to show your name below."
          },
          {
            "type": "RadioButtonsGroup",
            "name": "publish",
            "label": "May we show your review on our website?",
            "required": true,
            "data-source": [
              {
                "id": "name",
                "title": "Yes, with my name"
              },
              {
                "id": "anon",
                "title": "Yes, but keep me anonymous"
              },
              {
                "id": "no",
                "title": "No, keep it private"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Submit review",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "product": "${form.product}",
                "rating": "${form.rating}",
                "fit": "${form.fit}",
                "review": "${form.review}",
                "display_name": "${form.display_name}",
                "publish": "${form.publish}"
              }
            }
          }
        ]
      }
    }
  ]
}