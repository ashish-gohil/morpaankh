# whatsapp-automation — configuration
# Copy to .env for local dev. In AWS, non-secret values are Lambda env vars
# (set by CDK / a runtime config item) and secrets come from Secrets Manager.
# NEVER commit a real .env. Defaults are safe: everything OFF, DRY_RUN=true.

# ---- global safety ----------------------------------------------------------
DRY_RUN=true                     # true = compute + log, never call a provider for real
AWS_REGION=ap-south-1

# Backends: 'memory' for local/tests (no AWS), 'aws' inside Lambda.
DYNAMO_BACKEND=memory
QUEUE_BACKEND=memory
SECRETS_BACKEND=env              # 'env' reads the *_SECRET vars below; 'aws' reads Secrets Manager

# ---- allowlists (comma-separated) -------------------------------------------
# While testing, ONLY these can receive real sends / be processed.
SEND_ALLOWLIST=                  # e164 phones, e.g. +919812345678,+919812345679
ORDER_ALLOWLIST=                 # numeric Shopify order ids allowed even if flagged 'test'
OWNER_ALERT_PHONES=              # e164 phones for Flow D alerts + digest

# ---- store / public ---------------------------------------------------------
SHOP_DOMAIN=yaaijv-6p.myshopify.com
SHOPIFY_API_VERSION=2026-07
GRAPH_VERSION=v25.0              # Meta Graph API version (account uses v25.0)
PUBLIC_BASE_URL=                 # https://... the API Gateway / custom domain base

# ---- per-flow flags (OFF by default). startAt = ISO8601; only newer orders processed.
FLOW_A_ENABLED=false
FLOW_A_START_AT=
FLOW_B_ENABLED=false
FLOW_B_START_AT=
FLOW_C_ENABLED=false
FLOW_C_START_AT=
FLOW_D_ENABLED=false
FLOW_D_START_AT=

# ---- AWS resource ids (set by CDK outputs; memory backends ignore them) ------
TABLE_NAME=wa-automation
QUEUE_URL=
DLQ_URL=
SECRETS_ID=wa-automation/secrets
CONFIG_BACKEND=env               # 'aws' reads hot-swappable flags from the CONFIG#GLOBAL table item

# ---- SECRETS (local dev only, when SECRETS_BACKEND=env) ----------------------
# In AWS these live in one Secrets Manager JSON, never in env. Leave blank locally
# to stay in DRY_RUN. Real values are provided by you (see README manual steps).
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Delhivery One (client-credentials OAuth). NEVER put real values in this tracked
# file; put them in .env (gitignored) or Secrets Manager. Rotate the client secret
# if it was ever shared in plain text.
DELHIVERY_CLIENT_ID=
DELHIVERY_CLIENT_SECRET=
DELHIVERY_AUTH_URL=
DELHIVERY_REALM=
DELHIVERY_CLIENT_CMS=
DELHIVERY_MCP_URL=
DELHIVERY_PUSH_SECRET=
DELHIVERY_API=one            # 'one' (Delhivery One) or 'express' (static token)
PAY_TOKEN_KEY=                   # HMAC key for /p/{token} signed tokens
FLOW_TOKEN_KEY=                  # HMAC key for WhatsApp Flow tokens
