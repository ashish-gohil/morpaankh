# meta-outcomes configuration. Copy to .env and fill in. NO SECRETS IN CODE.
# Everything the service needs is read from the environment at startup.

# ---- Mode -------------------------------------------------------------------
# dry-run prints every Meta call it WOULD make and writes nothing to Meta.
# Set to "false" only when you are ready to send live.
DRY_RUN=true

# ---- Shopify ----------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=yaaijv-6p.myshopify.com
# App automation token (atkn_...) from the Dev Dashboard app, or a classic
# Admin API token (shpat_...). Used as X-Shopify-Access-Token.
SHOPIFY_ADMIN_TOKEN=
# App client secret (shpss_...). Verifies the X-Shopify-Hmac-Sha256 header on
# app-registered webhooks. Without it every webhook is rejected.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_API_VERSION=2026-07

# ---- Meta -------------------------------------------------------------------
# Dataset / pixel id (Events Manager). Known for this store.
META_DATASET_ID=2138165280468636
# System User access token with: ads_management (Custom Audiences) and access to
# the dataset above (Conversions API). Never logged.
META_ACCESS_TOKEN=
# Ad account that owns the two Custom Audiences (act_ prefix optional).
META_AD_ACCOUNT_ID=
# Business Manager id (discovered from the dataset; confirm it is right).
META_BUSINESS_ID=1728084641501165
# Optional: while verifying, paste the Events Manager "Test events" code so
# DeliveredPurchase shows up in the Test Events tab instead of live.
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v21.0

# Custom event name sent when an order becomes money. Do not reuse "Purchase".
META_DELIVERED_EVENT_NAME=DeliveredPurchase

# Audience names, kept in sync by the service.
META_AUDIENCE_DELIVERED=MP - Delivered Buyers
META_AUDIENCE_LOST=MP - Cancelled or RTO

# ---- Classifier tuning ------------------------------------------------------
# Override the "this parcel came back" matcher without a code change if the
# courier ever changes its note wording. JS RegExp source, case-insensitive.
# Leave blank to use the built-in default.
META_RETURN_REGEX=

# ---- Backfill ---------------------------------------------------------------
# First run replays orders created on/after this date (inclusive).
BACKFILL_SINCE=2026-08-01

# ---- Storage ----------------------------------------------------------------
# Where the idempotency ledger lives (which order is in which state already).
STATE_DB_PATH=./data/state.json

# ---- Server -----------------------------------------------------------------
# Public HTTPS base URL Shopify delivers webhooks to (a tunnel or a deployment).
# Not needed for backfill or dry-run; required for live webhook registration.
PUBLIC_BASE_URL=
PORT=8080
