# ---- Shopify (custom app: Admin API) ----
SHOPIFY_STORE_DOMAIN=sawri-bawri.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_SECRET=your_custom_app_api_secret      # used to verify webhook HMAC
SHOPIFY_API_VERSION=2024-10

# ---- Shiprocket ----
SHIPROCKET_EMAIL=you@morpaankh.in
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_LOCATION=Primary                 # exact pickup nickname in Shiprocket
SHIPROCKET_WEBHOOK_TOKEN=choose_a_long_random_string  # set this same value as x-api-key on the Shiprocket webhook
SHIPROCKET_CHANNEL_ID=                              # optional
SHIPROCKET_AUTO_AWB=true                            # auto-assign AWB + schedule pickup on order create
SHIPROCKET_TRACKING_BASE=https://shiprocket.co/tracking/

# ---- Parcel defaults (used when product has no weight) ----
DEFAULT_WEIGHT_KG=0.5
DEFAULT_LENGTH_CM=30
DEFAULT_BREADTH_CM=25
DEFAULT_HEIGHT_CM=5

# ---- Behaviour ----
NOTIFY_CUSTOMER=true
PORT=3000
STOREFRONT_BASE_URL=https://www.morpaankh.in

# ---- Automations (scheduled by node-workflow; all optional) ----
AUTOMATION_SHARED_SECRET=          # unset = /automations routes return 503; set a long random string
AUTOMATION_DRY_RUN=false           # true = full run, nothing sent, nothing tagged
ACR_MIN_AGE_MINUTES=60             # abandoned checkout: wait this long before messaging
ACR_MAX_AGE_HOURS=48               # ...and never message checkouts older than this
ACR_EMAIL_ENABLED=false            # keep false while Shopify native abandoned email is ON
REQUIRE_MARKETING_CONSENT=true     # marketing templates only to SUBSCRIBED phone numbers
COD_MIN_AGE_MINUTES=20
REVIEW_DELAY_DAYS=3
REVIEW_MAX_AGE_DAYS=30

# ---- Meta WhatsApp Cloud API (docs/whatsapp-templates.md) ----
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TPL_LANG=en
WHATSAPP_TPL_ABANDONED=abandoned_checkout_reminder
WHATSAPP_TPL_COD_CONFIRM=cod_order_confirmation
WHATSAPP_TPL_SHIPPED=order_shipped
WHATSAPP_TPL_DELIVERED=order_delivered
WHATSAPP_TPL_REVIEW=review_request

# ---- Brevo transactional email (free 300/day) ----
BREVO_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=care@morpaankh.in
BREVO_SENDER_NAME=MorPaankh
