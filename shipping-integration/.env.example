# ---- Shopify (custom app: Admin API) ----
SHOPIFY_STORE_DOMAIN=sawri-bawri.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_SECRET=your_custom_app_api_secret      # used to verify webhook HMAC
SHOPIFY_API_VERSION=2024-10

# ---- Shiprocket ----
SHIPROCKET_EMAIL=you@morpaankh.in
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_LOCATION=Primary                 # exact pickup nickname in Shiprocket
SHIPROCKET_WEBHOOK_TOKEN=choose_a_long_random_string  # set this same value as x-api-key on the Shiprocket webhook
SHIPROCKET_CHANNEL_ID=                              # optional
SHIPROCKET_AUTO_AWB=true                            # auto-assign AWB + schedule pickup on order create
SHIPROCKET_TRACKING_BASE=https://shiprocket.co/tracking/

# ---- Parcel defaults (used when product has no weight) ----
DEFAULT_WEIGHT_KG=0.5
DEFAULT_LENGTH_CM=30
DEFAULT_BREADTH_CM=25
DEFAULT_HEIGHT_CM=5

# ---- Behaviour ----
NOTIFY_CUSTOMER=true
PORT=3000
