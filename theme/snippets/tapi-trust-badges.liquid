{% doc %}
  Reusable trust-badge row shown at the point of purchase (the single highest-
  impact placement for conversion). Every line is a stable brand truth, so the
  content is fixed here rather than merchant-typed — nothing to keep in sync and
  nothing that can drift into an unhonest claim.

  Delivery and Cash on Delivery are deliberately NOT here. They live in the
  .tapi-assure block directly under the buy button (sections/main-product-tapi),
  which states them in full and keeps COD gated on the payment-perks setting.
  Repeating them here put the same promise on screen twice, a few pixels apart.

  @param {string} [layout] - 'pdp' (default) or 'compact'.
  @example
  {% render 'tapi-trust-badges', layout: 'pdp' %}
{% enddoc %}
{%- assign tb_layout = layout | default: 'pdp' -%}
<ul class="tapi-trust tapi-trust--{{ tb_layout }}" role="list">
  <li class="tapi-trust__item">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8a9 9 0 0116-3.5M21 16a9 9 0 01-16 3.5"/><path d="M20.5 3v4.5H16M3.5 21v-4.5H8"/></svg>
    <span class="tapi-trust__label"><strong>7-day returns</strong> on defects &amp; wrong items</span>
  </li>
  <li class="tapi-trust__item">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2l8 3v6c0 5-3.5 8-8 11-4.5-3-8-6-8-11V5z"/><path d="M9 12l2 2 4-4"/></svg>
    <span class="tapi-trust__label"><strong>Secure payment</strong> UPI · cards · netbanking</span>
  </li>
</ul>
