{% doc %}
  Tapi-branded product card. Replaces Dawn's card-product when needed.
  @param {object} product - The product to render.
  @example
  {% render 'card-product-tapi', product: product %}
{% enddoc %}
{%- assign m = product.metafields.tapi -%}
<article class="tapi-card">
  <a href="{{ product.url }}" class="tapi-card__media" aria-label="{{ product.title }}">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 800 | image_tag:
         loading: 'lazy', widths: '300, 600, 900',
         sizes: '(min-width: 750px) 25vw, 50vw',
         alt: product.featured_image.alt | default: product.title }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
    {%- if product.tags contains 'new' -%}
      <span class="tapi-tag tapi-tag--charcoal">New</span>
    {%- elsif product.tags contains 'bestseller' -%}
      <span class="tapi-tag tapi-tag--sage">Bestseller</span>
    {%- elsif product.tags contains 'festive' -%}
      <span class="tapi-tag tapi-tag--terracotta">Festive</span>
    {%- endif -%}
  </a>
  <div class="tapi-card__info">
    <h3 class="card__heading"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div class="tapi-card__row">
      <span class="card__subtitle">{{ m.subtitle | default: m.blend | truncate: 36 }}</span>
      <span class="price">{{ product.price | money }}</span>
    </div>
    <div class="tapi-meta">
      {%- if m.rating -%}<span>★ {{ m.rating }}</span>{%- endif -%}
      {%- if m.gsm -%}<span>{{ m.gsm }} GSM</span>{%- endif -%}
      {%- if product.available == false -%}<span style="color: var(--tapi-terracotta);">Sold out</span>{%- endif -%}
    </div>
  </div>
</article>

{% stylesheet %}
  .tapi-card { display: flex; flex-direction: column; gap: 1.2rem; }
  .tapi-card__media { position: relative; display: block; overflow: hidden; aspect-ratio: 3 / 4; background: var(--tapi-cream-2); }
  .tapi-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1200ms cubic-bezier(0.22,1,0.36,1); }
  .tapi-card__media:hover img { transform: scale(1.04); }
  .tapi-card__media .tapi-tag { position: absolute; top: 12px; left: 12px; }
  .tapi-card__info { display: flex; flex-direction: column; gap: 0.6rem; }
  .tapi-card__row { display: flex; justify-content: space-between; align-items: baseline; gap: 1.2rem; }
  .tapi-card .card__heading a { color: inherit; text-decoration: none; transition: color 240ms; }
  .tapi-card:hover .card__heading a { color: var(--tapi-terracotta); }
  .tapi-card .card__subtitle { font-size: 1.2rem; color: var(--tapi-warm-grey); }
  .tapi-card .tapi-meta { display: flex; gap: 1rem; font-size: 1.1rem; color: var(--tapi-muted); font-variant-numeric: tabular-nums; }
  .tapi-card .tapi-tag { display: inline-flex; height: 24px; padding: 0 10px; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 500; border-radius: 9999px; align-items: center; }
  .tapi-card .tapi-tag--charcoal { background: var(--tapi-charcoal); color: var(--tapi-cream); }
  .tapi-card .tapi-tag--sage { background: var(--tapi-sage-wash); color: var(--tapi-sage-deep); }
  .tapi-card .tapi-tag--terracotta { background: var(--tapi-terracotta-wash); color: var(--tapi-terracotta-deep); }
{% endstylesheet %}
