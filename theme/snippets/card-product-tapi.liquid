{% doc %}
  Tapi-branded product card with dual-image cross-fade hover, quick-view CTA, one
  glass status chip (bestseller/festive), compare-at savings %, an on-image glass
  size bar (sold-out sizes dimmed), and color dots from tapi.color_options.
  @param {object} product - The product to render.
  @example
  {% render 'card-product-tapi', product: product %}
{% enddoc %}
{%- assign m = product.metafields.tapi -%}
{%- assign img1 = product.featured_image -%}
{%- assign img2 = product.media[1].preview_image | default: product.images[1] -%}
{%- assign compare = product.compare_at_price -%}
{%- assign price = product.price -%}
{%- assign saving_pct = 0 -%}
{%- if compare > price -%}
  {%- assign diff = compare | minus: price -%}
  {%- assign saving_pct = diff | times: 100.0 | divided_by: compare | round -%}
{%- endif -%}
{%- comment -%} One status chip max (bestseller wins, else festive). "New" is
    intentionally NOT shown as a badge anywhere: the "New in" heading already
    signals it and the grids order newest-first. {%- endcomment -%}
{%- assign status_label = '' -%}
{%- if product.tags contains 'bestseller' -%}
  {%- assign status_label = 'Bestseller' -%}
{%- elsif product.tags contains 'festive' -%}
  {%- assign status_label = 'Festive' -%}
{%- endif -%}

{%- comment -%} Size availability for the on-image size bar. Find the "Size"
    option, then list which of its values have at least one in-stock variant so
    the card can dim the sold-out sizes without a PDP visit. {%- endcomment -%}
{%- assign size_opt = null -%}
{%- for opt in product.options_with_values -%}
  {%- assign oname = opt.name | downcase -%}
  {%- if oname == 'size' -%}{%- assign size_opt = opt -%}{%- endif -%}
{%- endfor -%}
{%- assign avail_sizes = ',' -%}
{%- if size_opt -%}
  {%- assign size_pos = size_opt.position | minus: 1 -%}
  {%- for v in product.variants -%}
    {%- if v.available -%}
      {%- assign avail_sizes = avail_sizes | append: v.options[size_pos] | append: ',' -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

<article class="tapi-card">
  <a class="tapi-card__media" href="{{ product.url }}" aria-label="{{ product.title }}">
    <div class="tapi-card__img tapi-card__img--front">
      {%- if img1 -%}
        {%- comment -%} Shopify's CDN auto-negotiates WebP for JPEG AND PNG masters
          off the Accept header, so no format override is needed here — a forced
          `format: 'pjpg'` is a no-op the CDN ignores (verified: it neither shrank the
          WebP for modern browsers nor stopped the raw-PNG fallback for the rest).
          PNG masters that photographs were uploaded as should be re-exported to
          JPEG/WebP at the SOURCE; that shrinks the raw fallback and the derived WebP
          alike. {%- endcomment -%}
        {{ img1 | image_url: width: 800 | image_tag:
           loading: 'lazy', widths: '200, 340, 450, 600, 800',
           sizes: '(min-width: 750px) 25vw, 50vw',
           alt: img1.alt | default: product.title }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    {%- if img2 -%}
      <div class="tapi-card__img tapi-card__img--back" aria-hidden="true">
        {{ img2 | image_url: width: 800 | image_tag:
           loading: 'lazy', widths: '200, 340, 450, 600, 800',
           sizes: '(min-width: 750px) 25vw, 50vw',
           alt: '' }}
      </div>
    {%- endif -%}

    <div class="tapi-card__quick" aria-hidden="true">
      <span class="tapi-card__quick-btn">Quick view <em>→</em></span>
    </div>

    {%- comment -%} Size bar: glass strip along the bottom of the photo listing
        every size, sold-out ones dimmed + struck, so shoppers scan fit without
        opening each PDP. Skipped when the whole product is sold out (the Sold
        out chip covers that) or when there is no Size option. aria-hidden — the
        PDP carries the accessible size picker. {%- endcomment -%}
    {%- if product.available and size_opt and size_opt.values.size > 0 -%}
      <div class="tapi-card__sizes" aria-hidden="true">
        {%- for sv in size_opt.values -%}
          {%- assign svkey = ',' | append: sv | append: ',' -%}
          <span class="tapi-card__size{% unless avail_sizes contains svkey %} tapi-card__size--sold{% endunless %}">{{ sv }}</span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} One small glass status chip (bestseller/festive), bottom-right
        of the photo, floating just above the size bar. {%- endcomment -%}
    {%- if status_label != blank -%}
      <span class="tapi-tag tapi-tag--glass tapi-card__tag" aria-hidden="true">{{ status_label }}</span>
    {%- endif -%}

    {%- comment -%} Sold out rides bottom-left ON the photo. {%- endcomment -%}
    {%- if product.available == false -%}
      <span class="tapi-card__state tapi-card__state--soldout">Sold out</span>
    {%- endif -%}
  </a>

  {% render 'tapi-wishlist-button', product: product, variant: 'card' %}

  {%- comment -%} Discount % badge, top-left — always first / most prominent. {%- endcomment -%}
  {%- if saving_pct > 0 -%}
  <div class="tapi-card__badges">
    <span class="tapi-card__savings">–{{ saving_pct }}%</span>
  </div>
  {%- endif -%}

  <div class="tapi-card__info">
    <div class="tapi-card__row">
      <h3 class="tapi-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
      <div class="tapi-card__price">
        <span class="tapi-card__price-now">{{ product.price | money }}</span>
        {%- if compare > price -%}
          <span class="tapi-card__price-was">{{ compare | money }}</span>
        {%- endif -%}
      </div>
    </div>

    <div class="tapi-card__row tapi-card__row--meta">
      <span class="tapi-card__subtitle">{{ m.subtitle | default: m.blend | truncate: 36 }}</span>
      {%- if m.color_options != blank -%}
        <div class="tapi-card__dots" aria-label="Color options">
          {%- for c in m.color_options.value limit: 5 -%}
            <span class="tapi-card__dot" style="background: {{ c.hex }};" title="{{ c.name }}"></span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</article>

{% stylesheet %}
  /* Flat editorial card (2026-07-16 boxy pass): no surface, no border, no
     radius, no shadow — the square-cornered photograph IS the card, sitting
     nearly flush against its neighbours (hairline column gaps set in
     tapi-ux.css / theme-variables.css). Title + price rest directly on the
     page cream, flush with the image's left edge. Hover stays with the
     media (cross-fade + quick view), not a lift — flat tiles don't float. */
  .tapi-card {
    display: flex; flex-direction: column; gap: 1.2rem; position: relative;
    height: 100%; /* fill the grid/rail row so card bottoms align across a section */
  }
  .tapi-card__media {
    position: relative; display: block; overflow: hidden;
    aspect-ratio: 3 / 4; background: var(--mor-cream-2);
  }
  .tapi-card__img { position: absolute; inset: 0; }
  .tapi-card__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1200ms cubic-bezier(0.22,1,0.36,1); }
  .tapi-card__img--front { z-index: 1; transition: opacity 600ms cubic-bezier(0.22,1,0.36,1); }
  .tapi-card__img--back  { z-index: 0; opacity: 0; transform: scale(1.04); transition: opacity 600ms cubic-bezier(0.22,1,0.36,1), transform 1200ms cubic-bezier(0.22,1,0.36,1); }
  .tapi-card:hover .tapi-card__img--front { opacity: 0; }
  .tapi-card:hover .tapi-card__img--front img { transform: scale(1.03); }
  .tapi-card:hover .tapi-card__img--back  { opacity: 1; transform: scale(1); }

  /* Top-left stack: one glass status chip over the (rare) discount badge. */
  .tapi-card__badges { position: absolute; top: 0; left: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 4px; z-index: 2; pointer-events: none; }
  .tapi-card__savings {
    display: inline-flex; align-items: center; height: 15px; padding: 0 4px;
    font-size: 9px; line-height: 1; letter-spacing: 0.06em; font-weight: 600; border-radius: 0;
    background: var(--mor-accent); color: var(--mor-cream); font-variant-numeric: tabular-nums;
  }
  /* Very small, boxy, borderless glass chip — mirrors the frosted header
     (translucent cream-2 + backdrop blur), a touch more see-through. */
  .tapi-tag {
    display: inline-flex; align-items: center; height: 15px; padding: 0 4px;
    font-size: 9px; line-height: 1; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600;
    border-radius: 0;
  }
  .tapi-tag--glass {
    background: rgba(250, 248, 244, 0.74);
    -webkit-backdrop-filter: saturate(1.05) blur(14px);
    backdrop-filter: saturate(1.05) blur(14px);
    color: var(--mor-charcoal);
  }
  /* Status chip: flush to the card's right edge (zero right margin), just above
     the size bar; rounded on the inner side only; fades on hover. */
  .tapi-card__tag { position: absolute; right: 0; bottom: 24px; z-index: 2; border-radius: 0; pointer-events: none; transition: opacity var(--mor-dur-base, 240ms) var(--mor-ease); }
  .tapi-card__media:hover .tapi-card__tag { opacity: 0; }

  .tapi-card__quick {
    position: absolute; inset: 0; z-index: 3;
    display: flex; align-items: flex-end; justify-content: center;
    padding: 16px; pointer-events: none;
  }
  .tapi-card__quick-btn {
    width: 100%; max-width: 280px;
    background: var(--mor-primary); color: var(--mor-cream);
    height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    font-size: var(--fs-xs); letter-spacing: 0.06em; text-transform: uppercase; font-weight: 500;
    border-radius: var(--mor-radius-sm);
    transform: translateY(120%); opacity: 0;
    transition: transform 480ms var(--mor-ease), opacity var(--mor-dur-slow) var(--mor-ease);
  }
  .tapi-card__quick-btn em { font-style: normal; transition: transform 1000ms cubic-bezier(0.22,1,0.36,1); }
  .tapi-card:hover .tapi-card__quick-btn { transform: translateY(0); opacity: 1; }
  .tapi-card:hover .tapi-card__quick-btn em { transform: translateX(6px); }

  /* ---- Info block: one clean two-line unit on every grid (mobile + desktop) ----
     Line 1 = product name (clamped to 2 lines, NATURAL height — no reserved dead
     space, which is what used to float the price a full line below short names).
     Line 2 = price. Then a compact colour-dots line and, only when relevant, the
     availability cue (low stock / sold out). Material/blend, rating and GSM are
     deferred to the PDP so the browse grid stays scannable. Intra-card gaps are
     deliberately small (3-6px) so each card reads as ONE unit, well inside the
     larger grid row-gap (Gestalt proximity — cards look clearly separated). */
  /* Flush-left with the image edge; the small right inset guarantees a long
     title never touches the neighbouring card's text across the hairline gap. */
  .tapi-card__info { display: flex; flex-direction: column; gap: 0.5rem; padding: 0 1rem 0 0; flex: 1; }
  .tapi-card__row { display: flex; flex-direction: column; align-items: flex-start; gap: 0.3rem; }
  /* Dots pin to the card's bottom edge, so when titles wrap differently the
     slack sits between price and dots, and the last line aligns row-wide. */
  .tapi-card__row--meta { flex-direction: row; align-items: center; gap: 0.8rem; margin-top: auto; }
  .tapi-card__title {
    font-family: var(--font-heading-family); font-size: var(--fs-lg); margin: 0; font-weight: 500;
    letter-spacing: -0.008em; line-height: 1.25;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
  }
  .tapi-card__title a { color: var(--mor-charcoal); text-decoration: none; transition: color var(--mor-dur-base) var(--mor-ease); }
  .tapi-card:hover .tapi-card__title a { color: var(--mor-accent); }
  /* Each price is an unbreakable unit: when the column is too narrow for both,
     the compare price drops to its own line whole, never mid-number. */
  .tapi-card__price { display: flex; align-items: baseline; gap: 0.9rem; flex-wrap: wrap; row-gap: 0.1rem; }
  .tapi-card__price-now { font-family: var(--font-body-family); font-size: var(--fs-base); font-weight: 600; letter-spacing: 0.01em; color: var(--mor-charcoal); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .tapi-card__price-was { font-size: var(--fs-xs); color: var(--tapi-muted); text-decoration: line-through; font-variant-numeric: tabular-nums; white-space: nowrap; }
  /* Defer material/blend, rating and GSM across the board for a clean two-line card. */
  .tapi-card__subtitle { display: none; }
  .tapi-card__dots { display: flex; gap: 5px; align-items: center; }
  .tapi-card__dot { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--tapi-hairline-2); transition: transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1); }
  .tapi-card__dot:hover { transform: scale(1.2); }
  .tapi-card__row--meta:not(:has(.tapi-card__dots)) { display: none; }

  /* Availability chip on the photo, bottom-left. Frosted cream like the
     wishlist heart so on-photo controls share one technique; sold out goes
     solid charcoal (terminal state, strongest weight). Fades on hover with
     the tags so the Quick view CTA owns the bottom of the image. */
  .tapi-card__state {
    position: absolute; bottom: 12px; left: 12px; z-index: 2;
    display: inline-flex; align-items: center; gap: 6px;
    height: 24px; padding: 0 10px;
    font-size: var(--fs-xs); letter-spacing: 0.06em; font-weight: 500; text-transform: uppercase;
    border-radius: var(--mor-radius-pill);
    pointer-events: none;
    transition: opacity var(--mor-dur-base, 240ms) var(--mor-ease);
  }
  .tapi-card__state--soldout {
    background: var(--tapi-charcoal);
    color: var(--tapi-cream);
  }
  .tapi-card__media:hover .tapi-card__state { opacity: 0; }

  /* Size bar — glass strip across the bottom of the photo (same frosted
     treatment as the header, a touch more transparent). Sizes read at a glance;
     sold-out ones dim + strike. Non-interactive (taps fall through to the PDP
     link). Fades + drops on hover so the Quick view CTA owns the bottom on
     desktop; on touch there is no Quick view, so it always shows. */
  .tapi-card__sizes {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 2;
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center;
    gap: 0.4rem 0.9rem; padding: 7px 10px;
    background: rgba(239, 230, 212, 0.38);
    -webkit-backdrop-filter: saturate(1.08) blur(14px);
    backdrop-filter: saturate(1.08) blur(14px);
    pointer-events: none;
    transition: opacity var(--mor-dur-base, 240ms) var(--mor-ease), transform 480ms var(--mor-ease);
  }
  .tapi-card__size {
    font-size: var(--fs-2xs); letter-spacing: 0.04em; font-weight: 600; line-height: 1;
    color: var(--mor-charcoal); text-transform: uppercase; font-variant-numeric: tabular-nums;
  }
  .tapi-card__size--sold { opacity: 0.42; text-decoration: line-through; }
  .tapi-card__media:hover .tapi-card__sizes { opacity: 0; transform: translateY(100%); }

  @media (hover: none) and (pointer: coarse) {
    .tapi-card__quick { display: none; }
    .tapi-card:active { transform: scale(0.99); }
    .tapi-card:hover .tapi-card__img--front { opacity: 1; }
    .tapi-card:hover .tapi-card__img--back  { opacity: 0; }
    /* No Quick view on touch, so the availability chip never hides */
    .tapi-card__media:hover .tapi-card__state { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tapi-card, .tapi-card:hover, .tapi-card:active { transform: none; transition: none; }
  }

  /* ---- Mobile: same two-line card, just a tighter type scale for 2-up grids --- */
  @media (max-width: 749px) {
    .tapi-card { gap: 1rem; }
    .tapi-card__title { font-size: var(--fs-base); line-height: 1.3; letter-spacing: -0.004em; }
    .tapi-card__price { gap: 0.6rem; }
    .tapi-card__price-now { font-size: var(--fs-base); }
    .tapi-card__price-was { font-size: var(--fs-xs); }
    /* Tighter insets + a more compact size bar on small 2-up cards. */
    .tapi-card__state { bottom: 8px; left: 8px; }
    .tapi-card__badges { top: 0; left: 0; }
    .tapi-card__tag { right: 0; bottom: 22px; }
    .tapi-card__sizes { padding: 6px 8px; gap: 0.3rem 0.7rem; }
  }
{% endstylesheet %}
