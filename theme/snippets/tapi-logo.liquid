{% doc %}
  Renders the Mor Paankh peacock-feather mark + wordmark as inline SVG.
  Color inherits from the surrounding container so the same snippet
  works on cream and on charcoal backgrounds. Placeholder until the
  final logo asset is provided.
  @param {number} [size] - Font-size for the wordmark in px (default 24)
  @param {boolean} [as_link] - Render as <a href="/"> instead of <span>.
    Default false because callers (e.g. header.liquid) already wrap this
    in their own <a class="header__heading-link">. Nested <a> tags break
    layout on non-homepage routes. Pass true for standalone use (footer).
  @example
  {% render 'tapi-logo' %}
  {% render 'tapi-logo', size: 22 %}
  {% render 'tapi-logo', size: 22, as_link: true %}
{% enddoc %}
{%- assign sz = size | default: 24 -%}
{%- if as_link -%}
<a href="{{ routes.root_url }}" class="tapi-logo" aria-label="{{ shop.name }}"
   style="display:inline-flex; align-items:center; color: inherit; text-decoration: none; line-height: 1;">
{%- else -%}
<span class="tapi-logo" aria-label="{{ shop.name }}"
      style="display:inline-flex; align-items:center; color: inherit; line-height: 1;">
{%- endif -%}
  <svg viewBox="0 0 44 44" width="{{ sz | times: 1.5 }}" height="{{ sz | times: 1.5 }}" role="img" aria-hidden="true" style="margin-right: 12px; flex: 0 0 auto;">
    {%- comment -%} Peacock-feather "eye": teardrop with concentric inner pupil {%- endcomment -%}
    <path d="M22 4 C 30 12, 36 20, 32 30 C 30 36, 26 40, 22 40 C 18 40, 14 36, 12 30 C 8 20, 14 12, 22 4 Z"
          stroke="currentColor" stroke-width="1.1" fill="none" stroke-linejoin="round"/>
    <ellipse cx="22" cy="22" rx="7" ry="9" stroke="currentColor" stroke-width="1" fill="none"/>
    <ellipse cx="22" cy="22" rx="3" ry="4" fill="currentColor"/>
  </svg>
  <span style="font-family: var(--font-heading-family); font-size: {{ sz }}px; font-weight: 500; letter-spacing: -0.012em; color: inherit; white-space: nowrap;">
    Mor <em style="font-weight: 500; font-style: italic;">Paankh</em>
  </span>
{%- if as_link -%}
</a>
{%- else -%}
</span>
{%- endif -%}
