{% doc %}
  Renders the Tapi & Co. ripple-mark + wordmark as inline SVG.
  Color inherits from the surrounding container so the same snippet
  works on cream and on charcoal backgrounds.
  @param {string} [size] - Font-size for the wordmark in px (default 24)
  @example
  {% render 'tapi-logo' %}
  {% render 'tapi-logo', size: 22 %}
{% enddoc %}
{%- assign sz = size | default: 24 -%}
<a href="{{ routes.root_url }}" class="tapi-logo" aria-label="{{ shop.name }}"
   style="display:inline-flex; align-items:center; color: inherit; text-decoration: none; line-height: 1;">
  <svg viewBox="0 0 44 44" width="{{ sz | times: 1.4 }}" height="{{ sz | times: 1.4 }}" role="img" aria-hidden="true" style="margin-right: 12px; flex: 0 0 auto;">
    <circle cx="22" cy="22" r="21" stroke="currentColor" stroke-width="1" fill="none"/>
    <path d="M9 18 C 14 14, 18 22, 22 18 S 30 14, 35 18" stroke="currentColor" stroke-width="1.1" fill="none" stroke-linecap="round"/>
    <path d="M9 23 C 14 19, 18 27, 22 23 S 30 19, 35 23" stroke="currentColor" stroke-width="1.1" fill="none" stroke-linecap="round"/>
    <path d="M9 28 C 14 24, 18 32, 22 28 S 30 24, 35 28" stroke="currentColor" stroke-width="1.1" fill="none" stroke-linecap="round"/>
  </svg>
  <span style="font-family: var(--font-heading-family); font-size: {{ sz }}px; font-weight: 500; letter-spacing: -0.012em; color: inherit;">
    Tapi <em style="font-weight: 400; font-style: italic;">&amp;</em> Co.
  </span>
</a>
