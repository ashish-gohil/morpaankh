{% doc %}
  Renders the Mor Paankh logo: the illustrated peacock-feather mark
  (mor-paankh-mark.png — gold chandrak + flowing barbs, transparent bg,
  reads clean on cream / charcoal / terracotta) followed by the
  "Mor Paankh" wordmark. The wordmark colour inherits from the
  surrounding container; the mark artwork is full-colour and fixed.
  @param {number} [size] - Nominal lockup size in px (default 24). The mark
    height ≈ size × 1.8 (artwork is pre-trimmed, ratio 362:440); the uppercase
    wordmark renders at ≈ size × 0.88 to optically match the caps height.
  @param {boolean} [as_link] - Render as <a href="/"> instead of <span>.
    Default false because callers (e.g. header.liquid) already wrap this
    in their own <a class="header__heading-link">. Nested <a> tags break
    layout on non-homepage routes. Pass true for standalone use (footer).
  @example
  {% render 'tapi-logo' %}
  {% render 'tapi-logo', size: 22 %}
  {% render 'tapi-logo', size: 22, as_link: true %}
{% enddoc %}
{%- assign sz = size | default: 24 -%}
{%- assign mark_h = sz | times: 1.95 | round -%}
{%- assign gap = sz | times: 0.4 | round -%}
{%- assign word_size = sz | times: 0.88 | round -%}
{%- if as_link -%}
<a href="{{ routes.root_url }}" class="tapi-logo" aria-label="{{ shop.name }}"
   style="display:inline-flex; align-items:center; color: inherit; text-decoration: none; line-height: 1;">
{%- else -%}
<span class="tapi-logo" aria-label="{{ shop.name }}"
      style="display:inline-flex; align-items:center; color: inherit; line-height: 1;">
{%- endif -%}
  <svg class="tapi-logo__mark" width="{{ mark_h }}" height="{{ mark_h }}" viewBox="0 0 100 100"
       aria-hidden="true" focusable="false"
       style="height: {{ mark_h }}px; width: {{ mark_h }}px; margin-right: {{ gap }}px; flex: 0 0 auto; display: block;">
    <circle cx="50" cy="50" r="46.5" fill="none" stroke="currentColor" stroke-width="1.3"/>
    <circle cx="50" cy="50" r="42" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.55"/>
    <g fill="none" stroke="#7A8761" stroke-width="1.8" stroke-linecap="round">
      <path d="M50 57 L 33 50"/><path d="M50 62 L 34.5 56"/><path d="M50 67 L 36 62"/><path d="M50 72 L 38 68"/><path d="M50 77 L 40.5 73.5"/><path d="M50 82 L 43 79"/>
      <path d="M50 57 L 67 50"/><path d="M50 62 L 65.5 56"/><path d="M50 67 L 64 62"/><path d="M50 72 L 62 68"/><path d="M50 77 L 59.5 73.5"/><path d="M50 82 L 57 79"/>
    </g>
    <path d="M50 54 L 50 87" fill="none" stroke="#5A6748" stroke-width="2.1" stroke-linecap="round"/>
    <path d="M50 14 C 62 24 62 44 50 54 C 38 44 38 24 50 14 Z" fill="none" stroke="#7A8761" stroke-width="2.1" stroke-linejoin="round"/>
    <path d="M50 20 C 57 27 57 41 50 48 C 43 41 43 27 50 20 Z" fill="none" stroke="#B7472A" stroke-width="1.8" stroke-linejoin="round"/>
    <path d="M50 28 C 53.6 32 53.6 40 50 44 C 46.4 40 46.4 32 50 28 Z" fill="#B08947"/>
  </svg>
  <span class="tapi-logo__word" style="font-family: 'Marcellus', var(--font-heading-family), serif; font-size: {{ word_size }}px; font-weight: 400; letter-spacing: 0.15em; text-transform: uppercase; color: inherit; white-space: nowrap;">Mor Paankh</span>
{%- if as_link -%}
</a>
{%- else -%}
</span>
{%- endif -%}
