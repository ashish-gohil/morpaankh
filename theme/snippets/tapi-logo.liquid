{% doc %}
  Renders the Tapi & Co. ripple-mark + wordmark as inline SVG.
  @param {string} [size] - Font-size for the wordmark in px (default 24)
  @example
  {% render 'tapi-logo' %}
  {% render 'tapi-logo', size: 22 %}
{% enddoc %}
{%- assign sz = size | default: 24 -%}
<a href="{{ routes.root_url }}" class="tapi-logo" aria-label="{{ shop.name }}" style="display:inline-flex; align-items:center; color: var(--tapi-charcoal);">
  <svg viewBox="0 0 44 44" width="32" height="32" role="img" aria-hidden="true" style="margin-right: 10px;">
    <circle cx="22" cy="22" r="21" stroke="currentColor" stroke-width="1" fill="none"/>
    <path d="M9 18 C 14 14, 18 22, 22 18 S 30 14, 35 18" stroke="currentColor" stroke-width="1.1" fill="none" stroke-linecap="round"/>
    <path d="M9 23 C 14 19, 18 27, 22 23 S 30 19, 35 23" stroke="currentColor" stroke-width="1.1" fill="none" stroke-linecap="round"/>
    <path d="M9 28 C 14 24, 18 32, 22 28 S 30 24, 35 28" stroke="currentColor" stroke-width="1.1" fill="none" stroke-linecap="round"/>
  </svg>
  <span style="font-family: var(--font-heading-family); font-size: {{ sz }}px; font-weight: 500; letter-spacing: -0.012em;">
    Tapi <em style="font-weight: 400;">&amp;</em> Co.
  </span>
</a>
