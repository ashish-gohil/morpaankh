{% doc %}
  Top-of-page rotating marquee. Reads shop.metafields.tapi.trust_items
  (list metafield, pipe-separated fallback string), falls back to defaults.
  @example
  {% render 'trust-marquee' %}
{% enddoc %}
{%- liquid
  assign items = shop.metafields.tapi.trust_items.value
  if items == blank
    assign items = 'Free delivery on prepaid orders|First order? ₹200 off over ₹1,000 with code WELCOME200|Buy 2, get 10% off. Buy 3, get 15% off|What you see is what arrives' | split: '|'
  endif
-%}
<aside class="tapi-marquee" aria-label="Brand promises">
  <div class="tapi-marquee__track" aria-hidden="true">
    {%- for i in items -%}<span>● {{ i }}</span>{%- endfor -%}
    {%- for i in items -%}<span>● {{ i }}</span>{%- endfor -%}
  </div>
</aside>
