{% comment %}
  Tapi search modal — slide-down panel with curated empty state
  (Trending / Collections / Bestsellers) + live predictive results.

  Accepts:
  - input_id: {String} Id for the search input element (required)

  Uses Dawn's <predictive-search> web component for live AJAX results
  (calls /search/suggest.json under the hood) but replaces the modal
  shell, input row, and result template to match the Tapi design.
{% endcomment %}

{%- liquid
  # Resolve "Bestsellers" source collection — prefer `best-sellers`, fall back to `all`, then first.
  assign bs_collection = collections['best-sellers']
  if bs_collection == empty or bs_collection.products_count == 0
    assign bs_collection = collections['all']
  endif
  if bs_collection == empty or bs_collection.products_count == 0
    assign bs_collection = collections.first
  endif
-%}

<details-modal class="header__search tapi-search">
  <details>
    <summary
      class="header__icon header__icon--search header__icon--summary link focus-inset modal__toggle"
      aria-haspopup="dialog"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <span>
        <span class="svg-wrapper">{{- 'icon-search.svg' | inline_asset_content -}}</span>
        <span class="svg-wrapper header__icon-close">{{- 'icon-close.svg' | inline_asset_content -}}</span>
      </span>
    </summary>

    <div
      class="search-modal modal__content tapi-search-modal"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <div class="modal-overlay tapi-search-backdrop"></div>

      <div class="search-modal__content tapi-search-panel" tabindex="-1">

        {%- if settings.predictive_search_enabled -%}
          <predictive-search class="search-modal__form tapi-search-form" data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- else -%}
          <search-form class="search-modal__form tapi-search-form">
        {%- endif -%}

        <form action="{{ routes.search_url }}" method="get" role="search" class="search tapi-search-form-inner">
          <div class="tapi-search-bar">
            <span class="tapi-search-bar__icon svg-wrapper" aria-hidden="true">
              {{- 'icon-search.svg' | inline_asset_content -}}
            </span>
            <input
              class="search__input field__input tapi-search-bar__input"
              id="{{ input_id }}"
              type="search"
              inputmode="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ section.settings.search_placeholder | default: 'Search by piece, fabric or color' }}"
              {%- if settings.predictive_search_enabled -%}
                role="combobox"
                aria-expanded="false"
                aria-owns="predictive-search-results"
                aria-controls="predictive-search-results"
                aria-haspopup="listbox"
                aria-autocomplete="list"
                autocorrect="off"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
              {%- endif -%}
            >
            <label class="visually-hidden" for="{{ input_id }}">{{ 'general.search.search' | t }}</label>
            <input type="hidden" name="options[prefix]" value="last">
            {%- comment -%} Search products + collections only, so pages/articles (e.g. /pages/llms) never appear in results. {%- endcomment -%}
            <input type="hidden" name="type" value="product,collection">

            <button
              type="reset"
              class="tapi-search-bar__reset{% if search.terms == blank %} hidden{% endif %}"
              aria-label="{{ 'general.search.reset' | t }}"
            >
              <span class="svg-wrapper">{{- 'icon-reset.svg' | inline_asset_content -}}</span>
            </button>
          </div>

          <div class="tapi-search-grid">
            {%- comment -%} Left rail: quick searches + the merchant's own category nav {%- endcomment -%}
            <aside class="tapi-search-aside">
              <section class="tapi-search-block">
                {%- comment -%}
                  "Quick searches", not "Trending": the theme has no access to real
                  search volume, so calling an editor-set list trending would be a
                  claim we cannot back. Every default below is a term verified to
                  return products on this catalog. Fabric and print terms on
                  purpose, since the category rail underneath already covers
                  silhouettes. GSM is deliberately absent: Shopify's search does
                  not index metafields, so "120 GSM" returns nothing.
                {%- endcomment -%}
                <h2 class="eyebrow tapi-search-block__title" data-default-title>Quick searches</h2>
                <h2 class="eyebrow tapi-search-block__title" data-query-title hidden>Suggested</h2>
                <ul class="tapi-search-list" data-default-trending>
                  {%- assign quick_csv = section.settings.search_quick_terms | default: 'Cotton, Mulmul, Chanderi, Block print, Anarkali, Lehenga' -%}
                  {%- assign quick_arr = quick_csv | split: ',' -%}
                  {%- for term in quick_arr limit: 6 -%}
                    {%- assign t = term | strip -%}
                    {%- if t == blank -%}{% continue %}{%- endif -%}
                    <li class="tapi-search-list__item">
                      <a href="{{ routes.search_url }}?q={{ t | url_encode }}&amp;type=product,collection" class="tapi-search-list__link link-u">
                        <span class="tapi-search-list__bullet" aria-hidden="true"></span>
                        <span class="tapi-search-list__label serif">{{ t }}</span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
                {%- comment -%} Live "Suggested" queries from predictive search land here {%- endcomment -%}
                <ul class="tapi-search-list tapi-search-list--suggested" data-query-suggested hidden></ul>
              </section>

              {%- comment -%}
                Category rail is driven by the main menu's own dropdown rather than
                by iterating `collections`. That iteration returned the first six
                collections by title, which (a) silently omitted real categories
                further down the alphabet (One Piece, Short Kurti, Lehenga Sets)
                and (b) would surface any internal or ops-only collection the
                moment one is published to the online store. The menu is what the
                merchant already curates, so this rail can never drift from the nav.
              {%- endcomment -%}
              {%- liquid
                assign nav_menu = section.settings.menu
                if nav_menu == blank
                  assign nav_menu = linklists.main-menu
                endif
                assign nav_links = '' | split: ','
                for link in nav_menu.links
                  if link.links.size > 0
                    assign nav_links = link.links
                    break
                  endif
                endfor
              -%}
              {%- capture cat_rail -%}
                {%- for link in nav_links -%}
                  {%- assign c_handle = link.url | split: '/collections/' | last | split: '?' | first -%}
                  {%- if c_handle == 'all' or c_handle == 'frontpage' -%}{% continue %}{%- endif -%}
                  {%- assign c = collections[c_handle] -%}
                  {%- if c == empty or c.products_count == 0 -%}{% continue %}{%- endif -%}
                  {%- comment -%} Skip whatever the Bestsellers rail on the right already shows. {%- endcomment -%}
                  {%- if c.handle == bs_collection.handle -%}{% continue %}{%- endif -%}
                  <li class="tapi-search-list__item">
                    <a href="{{ c.url }}" class="tapi-search-list__link tapi-search-list__link--compact link-u">
                      <span class="tapi-search-list__label">{{ c.title }}</span>
                      <span class="tapi-search-list__count tnum">{{ c.products_count }}</span>
                    </a>
                  </li>
                {%- endfor -%}
              {%- endcapture -%}
              {%- if cat_rail != blank -%}
                <section class="tapi-search-block">
                  <h2 class="eyebrow tapi-search-block__title">Collections</h2>
                  <ul class="tapi-search-list tapi-search-list--compact">{{ cat_rail }}</ul>
                </section>
              {%- endif -%}
            </aside>

            {%- comment -%} Right rail: Bestsellers (default) | Matches (query active) {%- endcomment -%}
            <div class="tapi-search-main">
              <section class="tapi-search-default" data-default-products>
                <h2 class="eyebrow tapi-search-block__title">Bestsellers</h2>
                {%- if bs_collection and bs_collection.products_count > 0 -%}
                  <ul class="tapi-search-products">
                    {%- for product in bs_collection.products limit: 5 -%}
                      <li class="tapi-search-products__item">
                        <a href="{{ product.url }}" class="tapi-search-product">
                          <div class="tapi-search-product__thumb">
                            {%- if product.featured_media != blank -%}
                              {{ product.featured_media | image_url: width: 200 | image_tag:
                                loading: 'lazy',
                                widths: '128,200,256',
                                sizes: '64px',
                                class: 'tapi-search-product__img',
                                alt: product.featured_media.alt | default: product.title
                              }}
                            {%- else -%}
                              <span class="tapi-search-product__placeholder"></span>
                            {%- endif -%}
                          </div>
                          <div class="tapi-search-product__meta">
                            <span class="tapi-search-product__name serif">{{ product.title | escape }}</span>
                            {%- comment -%}
                              Same two switches the live matches rail obeys, so the
                              two lists never disagree. Vendor off also stops
                              "Morpaankh" repeating under every row of a single
                              brand catalog.
                            {%- endcomment -%}
                            {%- if settings.predictive_search_show_vendor and product.vendor != blank -%}
                              <span class="tapi-search-product__sub">{{ product.vendor }}</span>
                            {%- endif -%}
                          </div>
                          <div class="tapi-search-product__right">
                            {%- if settings.predictive_search_show_price -%}
                              <span class="tapi-search-product__price serif tnum">{{ product.price | money }}</span>
                            {%- endif -%}
                            <span class="tapi-search-product__cta">View <span class="tapi-cta-arrow">→</span></span>
                          </div>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  <p class="tapi-search-empty">
                    Start typing to see matching pieces.
                  </p>
                {%- endif -%}
              </section>

              {%- if settings.predictive_search_enabled -%}
                <section class="tapi-search-live predictive-search predictive-search--header" tabindex="-1" data-predictive-search hidden>
                  {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
                </section>
                <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
              {%- endif -%}
            </div>
          </div>
        </form>

        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- else -%}
          </search-form>
        {%- endif -%}

      </div>

      {%- comment -%}
        Modal close lives at the dialog level (not in the search bar) so it pins
        to the panel's top-right corner and stays put while results scroll. It
        must remain a button[type="button"] — details-modal.js binds close() to
        the first such button in the modal.
      {%- endcomment -%}
      <button
        type="button"
        class="tapi-search-close"
        aria-label="{{ 'accessibility.close' | t }}"
      >
        <span class="svg-wrapper" aria-hidden="true">{{- 'icon-close.svg' | inline_asset_content -}}</span>
      </button>
    </div>
  </details>
</details-modal>
