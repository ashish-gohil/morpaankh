{%- comment -%}
  Full-screen, story-style shoppable video player. Markup only — wired by
  assets/tapi-story.js, styled by assets/tapi-story.css. Rendered once inside any
  [data-story-scope] (the Watch & Buy rail, the PDP video bubble). The scope's
  [data-story-tile] elements form the playlist; this overlay plays them.
{%- endcomment -%}
<div class="tapi-story" data-story hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Shoppable video">
  <div class="tapi-story__backdrop" data-story-close></div>
  <div class="tapi-story__stage">
    <div class="tapi-story__bars" data-story-bars aria-hidden="true"></div>

    <div class="tapi-story__top">
      <button type="button" class="tapi-story__icon" data-story-mute aria-label="Unmute">
        <svg class="tapi-story__ic-muted" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M23 9l-6 6M17 9l6 6"/></svg>
        <svg class="tapi-story__ic-sound" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" hidden><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a9 9 0 0 1 0 14"/></svg>
      </button>
      <button type="button" class="tapi-story__icon" data-story-close aria-label="Close video">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <video class="tapi-story__video" data-story-video playsinline muted preload="none"></video>

    <button type="button" class="tapi-story__tap tapi-story__tap--prev" data-story-prev aria-label="Previous video"></button>
    <button type="button" class="tapi-story__tap tapi-story__tap--next" data-story-next aria-label="Next video"></button>

    <div class="tapi-story__card" data-story-card>
      <div class="tapi-story__card-top">
        <a class="tapi-story__thumb" data-story-link href="#" tabindex="-1" aria-hidden="true">
          {% # theme-check-disable RemoteAsset %}
          <img data-story-img src="" alt="" width="52" height="66" loading="lazy">
          {% # theme-check-enable RemoteAsset %}
        </a>
        <div class="tapi-story__meta">
          <span class="tapi-story__title" data-story-title></span>
          <span class="tapi-story__price" data-story-price></span>
        </div>
        <a class="tapi-story__view" data-story-link href="#" aria-label="View product page">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
        </a>
      </div>
      <div class="tapi-story__sizes" data-story-sizes></div>
      <button type="button" class="tapi-story__atc" data-story-atc data-label="Add to cart" disabled>Add to cart</button>
    </div>
  </div>
</div>
