{{ 'pdp-video.css' | asset_url | stylesheet_tag }}
{{ 'pdp-offers.css' | asset_url | stylesheet_tag }}
{{ 'pdp-trust.css' | asset_url | stylesheet_tag }}
{{ 'tapi-offers.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tapi-offers.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign m = product.metafields.tapi
  assign current_variant = product.selected_or_first_available_variant
  assign saving = 0
  if current_variant.compare_at_price > current_variant.price
    assign saving = current_variant.compare_at_price | minus: current_variant.price
  endif
  assign low_stock_threshold = 3
  # Conditional-state flags — used to skip rendering empty blocks so the info
  # column (a flex stack with a uniform 2.4rem gap) never carries a phantom gap.
  assign has_fabric = false
  if m.gsm or m.blend or m.weave or m.fit_type or m.opacity_note or m.breathability or m.wash_care or m.neckline or m.length or m.occasion
    assign has_fabric = true
  endif
  assign has_pdp_tags = false
  if product.tags contains 'new' or product.tags contains 'bestseller' or product.tags contains 'festive'
    assign has_pdp_tags = true
  endif
  assign subtitle_val = m.subtitle | default: m.blend
  # ----- Ratings + reviews (two decoupled things) -----
  # A clothing brand can receive hundreds of ratings but only ever SHOW a few
  # review quotes. So the headline number is separate from the quotes:
  #   * tapi.rating_count   (number) - the total ratings received (e.g. 203)
  #   * tapi.rating_average (number) - the average out of 5 (e.g. 4.5)
  #   * tapi.reviews        (JSON list) - a SMALL set of featured quotes for the
  #                          carousel: { author, rating, body, date, location, verified }
  # The summary (title stars + band header) shows disp_count / disp_avg, taken
  # from the manual fields when set, otherwise derived from the featured quotes.
  assign feat_list = m.reviews.value
  assign feat_count = 0
  assign feat_sum = 0
  if feat_list
    for r in feat_list
      assign r_rating = r.rating | plus: 0
      if r_rating > 0
        assign feat_count = feat_count | plus: 1
        assign feat_sum = feat_sum | plus: r_rating
      endif
    endfor
  endif
  assign feat_avg = 0
  if feat_count > 0
    assign feat_avg = feat_sum | times: 1.0 | divided_by: feat_count | round: 1
  endif
  # Manual headline numbers (fall back to the featured quotes when left blank).
  assign man_count = m.rating_count.value | plus: 0
  assign man_avg = m.rating_average.value
  assign disp_count = feat_count
  if man_count > 0
    assign disp_count = man_count
  endif
  assign disp_avg = feat_avg
  if man_avg
    assign disp_avg = man_avg
  endif
-%}

<section class="tapi-pdp section" id="MainProduct-{{ section.id }}" data-section-id="{{ section.id }}">
  {%- comment -%} Recently-viewed tracking payload — read once by tapi-ux.js. {%- endcomment -%}
  <script type="application/json" data-tapi-track-product>
    {
      "handle": {{ product.handle | json }},
      "id": {{ product.id | json }},
      "variantId": {{ current_variant.id | json }},
      "variantCount": {{ product.variants.size }},
      "title": {{ product.title | json }},
      "url": {{ product.url | json }},
      "image": {{ product.featured_image | image_url: width: 800 | json }},
      "price": {{ product.price | money | json }},
      "compareAt": {% if product.compare_at_price > product.price %}{{ product.compare_at_price | money | json }}{% else %}""{% endif %}
    }
  </script>

  <div class="page-width tapi-pdp__breadcrumb">
    <a href="{{ routes.root_url }}">Home</a> &nbsp;/&nbsp;
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title }}</a> &nbsp;/&nbsp;
    {%- elsif product.collections.first -%}
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a> &nbsp;/&nbsp;
    {%- endif -%}
    <span>{{ product.title }}</span>
  </div>

  <div class="page-width tapi-pdp__layout">

    {%- comment -%} ----- GALLERY ----- {%- endcomment -%}
    <div class="tapi-pdp__gallery">
      <div class="tapi-pdp__gallery-thumbs">
        {%- for media in product.media -%}
          <button type="button" class="tapi-pdp__thumb {% if forloop.first %}is-active{% endif %}" data-thumb-index="{{ forloop.index0 }}" aria-label="View item {{ forloop.index }}{% unless media.media_type == 'image' %}, {{ media.media_type | replace: '_', ' ' }}{% endunless %}">
            {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '120, 160', sizes: '72px', alt: media.preview_image.alt | default: product.title }}
            {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
              <span class="tapi-pdp__thumb-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
            {%- endif -%}
          </button>
        {%- endfor -%}
      </div>
      <div class="tapi-pdp__gallery-main">
        <div class="tapi-pdp__gallery-stage" data-gallery-stage>
          {%- for media in product.media -%}
            {%- if forloop.first -%}{%- assign pdp_loading = 'eager' -%}{%- assign pdp_fetch = 'high' -%}{%- else -%}{%- assign pdp_loading = 'lazy' -%}{%- assign pdp_fetch = 'auto' -%}{%- endif -%}
            <div class="tapi-pdp__main-img {% if forloop.first %}is-active{% endif %}" data-main-index="{{ forloop.index0 }}" data-media-id="{{ media.id }}" data-file="{{ media.preview_image | image_url: width: 1 | split: '?' | first | split: '/' | last }}" data-media-type="{{ media.media_type }}">
              {%- case media.media_type -%}
                {%- when 'video' -%}
                  {%- comment -%} Shopify-hosted video: lazy facade. We render ONLY the poster +
                    our branded play button (no `controls`) so the browser's native centre play
                    button can't stack on top of ours (the mobile "two play buttons" bug). On the
                    first tap, tapi-motion.js turns on native controls and starts playback. mp4
                    sources first so Chrome/Firefox always have a playable format (they can't
                    decode the m3u8/HLS source Safari prefers). {%- endcomment -%}
                  <div class="tapi-pdp__media-video" data-pdp-video-wrap>
                    <video class="tapi-pdp__video" data-pdp-video playsinline preload="none"
                           poster="{{ media.preview_image | image_url: width: 1200 }}">
                      {%- for s in media.sources -%}{%- if s.format == 'mp4' -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endif -%}{%- endfor -%}
                      {%- for s in media.sources -%}{%- unless s.format == 'mp4' -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endunless -%}{%- endfor -%}
                    </video>
                    <button type="button" class="tapi-pdp__play" data-pdp-play aria-label="Play video">
                      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                    </button>
                  </div>
                {%- when 'external_video' -%}
                  {%- comment -%} YouTube / Vimeo: lazy facade — show the poster + play button and
                    only inject the heavy iframe on click (keeps the PDP fast). {%- endcomment -%}
                  <div class="tapi-pdp__media-video tapi-pdp__media-external" data-pdp-external data-video-host="{{ media.host }}" data-video-id="{{ media.external_id }}">
                    {{ media.preview_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: media.preview_image.alt | default: product.title, class: 'tapi-pdp__external-poster' }}
                    <button type="button" class="tapi-pdp__play" data-pdp-external-play aria-label="Play video">
                      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                    </button>
                  </div>
                {%- else -%}
                  {%- comment -%} Mobile-first responsive gallery image. First slide is
                    eager + fetchpriority high (it is the LCP for ad-click landings); the
                    rest lazy-load. srcset tops out at 1200w so a DPR-3 phone at 100vw never
                    pulls a heavier file than it can show; sizes tracks the real layout
                    (~45vw beside the buy column on desktop, full width below 1100px). CLS is
                    already reserved by the 3/4 aspect-ratio on .tapi-pdp__main-img img. {%- endcomment -%}
                  {{ media.preview_image | image_url: width: 1200 | image_tag:
                     loading: pdp_loading, fetchpriority: pdp_fetch, widths: '400, 600, 800, 1000, 1200',
                     sizes: '(min-width: 1100px) 45vw, 100vw',
                     alt: media.preview_image.alt | default: product.title }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
          {%- if product.media.size == 0 -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg tapi-pdp__placeholder' }}
          {%- endif -%}

          {%- if product.media.size > 1 -%}
            <button type="button" class="tapi-pdp__nav tapi-pdp__nav--prev" data-gallery-prev aria-label="Previous image">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false">
                <path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button type="button" class="tapi-pdp__nav tapi-pdp__nav--next" data-gallery-next aria-label="Next image">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false">
                <path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          {%- endif -%}

          {%- comment -%} Full-screen trigger — opens the lightbox (markup below) at the
            current slide. Wired in tapi-motion.js (setupPdpLightbox). {%- endcomment -%}
          {%- if product.media.size > 0 -%}
            <button type="button" class="tapi-pdp__zoom" data-gallery-zoom aria-label="View full screen" aria-haspopup="dialog">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M16 3h3a2 2 0 0 1 2 2v3"/><path d="M8 21H5a2 2 0 0 1-2-2v-3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/>
              </svg>
            </button>
          {%- endif -%}
        </div>

        {%- comment -%} Dots are a glanceable indicator for a handful of images. Past ~8
          media (e.g. a multi-colour product whose every variant carries its own shot)
          a dot row turns into noise, so we show dots only for small galleries and let
          the thumbnail rail carry navigation for large ones. {%- endcomment -%}
        {%- if product.media.size > 1 and product.media.size <= 8 -%}
          <div class="tapi-pdp__dots" data-gallery-dots aria-hidden="true">
            {%- for media in product.media -%}
              <button type="button" tabindex="-1" class="tapi-pdp__dot {% if forloop.first %}is-active{% endif %}" data-dot-index="{{ forloop.index0 }}" aria-label="Go to image {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ----- BUY COLUMN ----- {%- endcomment -%}
    <div class="tapi-pdp__info">
      {%- comment -%} Name and tag share one row, justified apart: title left, any
        tags pinned top-right. {%- endcomment -%}
      <div class="tapi-pdp__title-row" data-tapi-reveal>
        <h1 class="tapi-pdp__title">{{ product.title }}</h1>
        {%- if has_pdp_tags -%}
          <div class="tapi-pdp__tags">
            {%- if product.tags contains 'new' -%}<span class="tapi-tag tapi-tag--charcoal">New</span>{%- endif -%}
            {%- if product.tags contains 'bestseller' -%}<span class="tapi-tag tapi-tag--sage">Bestseller</span>{%- endif -%}
            {%- if product.tags contains 'festive' -%}<span class="tapi-tag tapi-tag--terracotta">Festive</span>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
      {%- if subtitle_val or m.pieces.value != blank -%}
        <p class="tapi-pdp__subtitle" data-tapi-reveal>
          {{ subtitle_val }}
          {%- if m.pieces.value != blank -%} · {{ m.pieces.value | join: ' · ' }}{%- endif -%}
        </p>
      {%- endif -%}

      {%- comment -%} Headline summary: manual rating_count / rating_average (or the
        featured quotes as a fallback). Shown only when there is a count. Uses the
        shared fractional .tapi-stars component (real half-star support) so the stars
        under the title read identically to the old reviews band. Enter the true
        numbers you have received. {%- endcomment -%}
      {%- if disp_count > 0 -%}
        {%- assign disp_pct = disp_avg | times: 20 -%}
        <div class="tapi-pdp__rating">
          <span class="tapi-stars" style="--pct: {{ disp_pct }}%" role="img" aria-label="{{ disp_avg }} out of 5 from {{ disp_count }} rating{% if disp_count != 1 %}s{% endif %}">
            <span class="tapi-stars__fill" aria-hidden="true"></span>
          </span>
          <span class="tapi-pdp__rating-num">{{ disp_avg }}</span>
          <span class="tapi-pdp__divider"></span>
          <span class="tapi-pdp__rating-count">{{ disp_count }} rating{% if disp_count != 1 %}s{% endif %}</span>
        </div>
      {%- endif -%}

      <div class="tapi-pdp__price">
        <span class="tapi-pdp__price-now">{{ current_variant.price | money }}</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="tapi-pdp__price-was">{{ current_variant.compare_at_price | money }}</span>
          <span class="tapi-tag tapi-tag--terracotta">Save {{ saving | money }}</span>
        {%- endif -%}
      </div>
      <p class="tapi-pdp__price-note">Inclusive of taxes.</p>

      {%- comment -%} Offers come from Theme settings -> Offers, the single source
        of truth shared with the cart smart-offers panel, so PDP and cart can
        never drift apart. Each row mirrors a live code in Discounts. All
        public codes are listed for everyone; first-order labels carry the
        eligibility, checkout enforces it. {%- endcomment -%}
      {%- if section.settings.show_offers -%}
        {%- comment -%} Decision-fatigue pass: only the recommended first-order
          offer sits above the fold as ONE line; the rest fold into a collapsed
          "More offers" accordion below the buy button (rendered later, reusing
          pdp_offer_ids + pdp_hero_id set here). Still driven entirely by Theme
          settings -> Offers, so PDP and cart never drift, and the box keeps
          class .tapi-pdp__offers for the view_promotion analytics hook. {%- endcomment -%}
        {%- liquid
          assign pdp_offer_list = ''
          for i in (1..4)
            assign base = 'tapi_offer' | append: i
            assign k_enable = base | append: '_enable'
            unless settings[k_enable]
              continue
            endunless
            assign k_code = base | append: '_code'
            assign o_code = settings[k_code] | strip
            if o_code == blank
              continue
            endif
            assign pdp_offer_list = pdp_offer_list | append: i | append: ','
          endfor
          assign pdp_offer_ids = pdp_offer_list | split: ','
          assign pdp_hero_id = ''
          for id in pdp_offer_ids
            assign k_first = 'tapi_offer' | append: id | append: '_first_order'
            if settings[k_first]
              assign pdp_hero_id = id
              break
            endif
          endfor
          if pdp_hero_id == blank and pdp_offer_ids.size > 0
            assign pdp_hero_id = pdp_offer_ids | first
          endif
        -%}
        {%- comment -%} The ticket itself renders further down, after the colour and
          size pickers: choosing the piece comes first, the code comes once they have
          chosen. Only the offer ids and the hero id are resolved here, because the
          "More offers" accordion further down reuses them. {%- endcomment -%}
      {%- endif -%}

      {%- liquid
        assign color_option = nil
        assign size_option = nil
        for opt in product.options_with_values
          if opt.name == 'Color'
            assign color_option = opt
          elsif opt.name == 'Size'
            assign size_option = opt
          endif
        endfor
        # Resolve which slot (1-based option position) holds Size vs Color so the
        # variant matrix below maps correctly REGARDLESS of the product's option
        # ORDER. Some products are built Size-first, others Colour-first; hardcoding
        # option1=Size silently breaks every Colour-first product (wrong variant id,
        # dead image swap, "sold out" on in-stock variants).
        assign size_idx = 0
        assign color_idx = 1
        if size_option != nil
          assign size_idx = size_option.position | minus: 1
        endif
        if color_option != nil
          assign color_idx = color_option.position | minus: 1
        endif
      -%}

      {%- comment -%} Colors — real variant option. Each swatch carries data-color
        and drives variant resolution (see the matrix + script below). Hex dots
        come from the tapi.color_options metafield, matched by name. {%- endcomment -%}
      {%- if color_option and color_option.values.size > 0 -%}
        <div class="tapi-pdp__group">
          <div class="tapi-pdp__group-head">
            <span class="tapi-eyebrow">Color</span>
            <span class="tapi-pdp__group-meta" data-color-label>{{ color_option.selected_value }}</span>
          </div>
          <div class="tapi-pdp__colors" role="radiogroup" aria-label="Color">
            {%- for val in color_option.values -%}
              {%- comment -%} Swatch fill resolution (no hardcoded per-product colours):
                1. curated tapi.color_options metafield — lets the merchant hand-tune a
                   colour (the original catalogue uses this);
                2. native Shopify option swatch (image or colour) — auto-populated from
                   the colour taxonomy / variant media, so new products colour-in with
                   zero manual setup;
                3. neutral fallback ONLY when neither source exists. {%- endcomment -%}
              {%- assign hex = '' -%}
              {%- assign sw_img = '' -%}
              {%- if m.color_options != blank -%}
                {%- for c in m.color_options.value -%}
                  {%- if c.name == val -%}{%- assign hex = c.hex -%}{%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              {%- if hex == '' and val.swatch -%}
                {%- if val.swatch.image -%}
                  {%- assign sw_img = val.swatch.image | image_url: width: 80 -%}
                {%- elsif val.swatch.color -%}
                  {%- assign hex = val.swatch.color -%}
                {%- endif -%}
              {%- endif -%}
              {%- if hex == '' and sw_img == '' -%}{%- assign hex = '#CFC6B8' -%}{%- endif -%}
              <button type="button"
                      class="tapi-pdp__color{% if val == color_option.selected_value %} is-active{% endif %}"
                      data-color="{{ val | escape }}"
                      role="radio"
                      aria-checked="{% if val == color_option.selected_value %}true{% else %}false{% endif %}"
                      aria-label="{{ val | escape }}"
                      title="{{ val | escape }}">
                <span class="tapi-pdp__color-dot" style="{% if sw_img != '' %}background: center / cover no-repeat url('{{ sw_img }}');{% else %}background: {{ hex }};{% endif %}"></span>
              </button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} Native Shopify product form tag rather than a hand-built form
        element. The Liquid product form tag exposes the form object needed by the
        payment_button filter for the dynamic-checkout button below, and renders the
        same markup (same id, same form_type/utf8 hidden inputs, same /cart/add action)
        so add-to-cart, the variant matrix JS and the mobile sticky bar (linked via the
        form= attribute) keep working unchanged. {%- endcomment -%}
      {%- assign product_form_id = 'product-form-' | append: section.id -%}
      {%- form 'product', product, id: product_form_id, class: 'tapi-pdp__form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" id="variant-id-{{ section.id }}">

        {%- if size_option -%}
          <div class="tapi-pdp__group">
            <div class="tapi-pdp__group-head">
              <span class="tapi-eyebrow">Size</span>
              <a href="/pages/fabric-guide#size-guide" class="tapi-pdp__guide-link" data-size-guide-open aria-haspopup="dialog">Size guide</a>
            </div>
            <div class="tapi-pdp__sizes" role="radiogroup" aria-label="Size">
              {%- for val in size_option.values -%}
                <button type="button"
                        class="tapi-pdp__size{% if val == size_option.selected_value %} is-active{% endif %}"
                        data-size="{{ val | escape }}"
                        role="radio"
                        aria-checked="{% if val == size_option.selected_value %}true{% else %}false{% endif %}">
                  {{ val }}
                </button>
              {%- endfor -%}
            </div>
            <p class="tapi-pdp__stock-note" data-stock-note></p>
          </div>

          {%- comment -%} On-PDP size guide. The trigger above is a real link to the
            full guide (works with no JS); this dialog intercepts the click so the
            shopper can check bust/hip without leaving the page. Native <dialog> gives
            us focus handling, Esc-to-close and a backdrop for free. {%- endcomment -%}
          <dialog class="tapi-sizeguide" id="sizeguide-{{ section.id }}" aria-label="Size guide">
            <div class="tapi-sizeguide__panel">
              <div class="tapi-sizeguide__head">
                <div>
                  <span class="tapi-eyebrow">Size &amp; Fit</span>
                  <h3 class="tapi-sizeguide__title">Find your size</h3>
                </div>
                <button type="button" class="tapi-sizeguide__close" data-size-guide-close aria-label="Close size guide">&times;</button>
              </div>
              <p class="tapi-sizeguide__intro">A guide, not a rulebook. Our pieces come from a small group of trusted ateliers, so the fit can shift by about 2 to 3 inches between styles. Pick the size you usually wear. Measurements are in inches.</p>
              <div class="tapi-sizeguide__scroll">
                <table class="tapi-sizeguide__table">
                  <thead>
                    <tr><th scope="col">Size</th><th scope="col">Bust</th><th scope="col">Hip</th></tr>
                  </thead>
                  <tbody>
                    <tr><th scope="row">XS</th><td>34</td><td>36</td></tr>
                    <tr><th scope="row">S</th><td>36</td><td>38</td></tr>
                    <tr><th scope="row">M</th><td>38</td><td>40</td></tr>
                    <tr><th scope="row">L</th><td>40</td><td>42</td></tr>
                    <tr><th scope="row">XL</th><td>42</td><td>44</td></tr>
                    <tr><th scope="row">XXL</th><td>44</td><td>46</td></tr>
                    <tr><th scope="row">3XL</th><td>46</td><td>48</td></tr>
                  </tbody>
                </table>
              </div>
              <p class="tapi-sizeguide__tip">Measure around the fullest part of the bust and hip, tape level and snug. Easiest of all: lay a kurta you already love flat and match it.</p>
              <a class="tapi-sizeguide__full" href="/pages/fabric-guide#size-guide">See full measurements and fabric guide &rarr;</a>
            </div>
          </dialog>
        {%- endif -%}

        {%- comment -%} Full Size×Color variant matrix — the single source of truth
          the selection script uses to resolve a chosen (size, color) to a real
          variant id, its price, availability, stock count, and (future) image. {%- endcomment -%}
        <script type="application/json" data-variant-matrix>
          [
            {%- for v in product.variants -%}
              {%- comment -%} img: variant image src when one is assigned, else null.
                guarded so a variant with no image never calls image_url on nil. {%- endcomment -%}
              {%- assign vimg = '' -%}
              {%- if v.image != blank -%}{%- capture vimg -%}{{ v.image | image_url: width: 1400 }}{%- endcapture -%}{%- endif -%}
              {%- assign vsize = v.options[size_idx] -%}
              {%- if color_option != nil -%}{%- assign vcolor = v.options[color_idx] -%}{%- else -%}{%- assign vcolor = nil -%}{%- endif -%}
              {"id": {{ v.id }}, "size": {{ vsize | json }}, "color": {{ vcolor | json }}, "available": {{ v.available }}, "priceText": {{ v.price | money | json }}, "compareText": {{ v.compare_at_price | money | json }}, "inv": {{ v.inventory_quantity | default: 0 }}, "img": {{ vimg | json }}, "mediaId": {{ v.featured_media.id | default: 0 | json }}}{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        </script>
        <span hidden data-low-stock="{{ low_stock_threshold }}"></span>

        {%- comment -%} Per-colour media grouping (native): `image.variants` exposes which
          variants each photo is assigned to (Shopify's "assign media to a variant"
          feature in the product Media section). We emit filename -> [colours] so the
          gallery can show only the selected colour's photos (plus any photo assigned to
          NO variant, which is treated as shared). Keyed by filename because the gallery
          renders product.media (for video support) while the variant link lives on
          product.images; the filename is the stable join. A product that doesn't group
          its media emits an empty map and the gallery shows everything, unchanged. {%- endcomment -%}
        <script type="application/json" data-variant-media-map>
          {
            {%- assign vm_first = true -%}
            {%- if color_option != nil -%}
              {%- for img in product.images -%}
                {%- if img.variants.size > 0 -%}
                  {%- assign ifile = img | image_url: width: 1 | split: '?' | first | split: '/' | last -%}
                  {%- unless vm_first -%},{%- endunless -%}{%- assign vm_first = false -%}
                  {{ ifile | json }}: [
                    {%- assign vm_cf = true -%}
                    {%- for v in img.variants -%}
                      {%- unless vm_cf -%},{%- endunless -%}{%- assign vm_cf = false -%}
                      {{ v.options[color_idx] | json }}
                    {%- endfor -%}
                  ]
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          }
        </script>

        {%- comment -%} Save / Share, directly under the pickers: the shopper has the
          piece in mind by now, so this is the moment they either keep it for later or
          send it to someone. Inside the form, both are type="button" so neither can
          submit it. {%- endcomment -%}
        <div class="tapi-pdp__quickactions">
          {% render 'tapi-wishlist-button', product: product, variant: 'pdp' %}
          {% render 'tapi-share', product: product %}
        </div>

        {%- comment -%} The welcome ticket. It sits directly under the price, before the
            colour and size pickers, because it is the one thing on this page that changes
            what the shopper pays and it should land before they start choosing.

            Every word is DERIVED from the same Theme settings -> Offers row the cart panel
            reads, so changing the code, the amount or the minimum in one place updates the
            product page and the cart together and they can never contradict each other.
            Keeps class .tapi-pdp__offers so the view_promotion analytics hook still fires.
            {%- endcomment -%}
          {%- if pdp_hero_id != blank -%}
            {%- liquid
              assign hero_base = 'tapi_offer' | append: pdp_hero_id
              assign k = hero_base | append: '_code'
              assign hero_code = settings[k] | strip | upcase
              assign k = hero_base | append: '_label'
              assign hero_label = settings[k]
              assign k = hero_base | append: '_first_order'
              assign hero_first = settings[k]
              assign k = hero_base | append: '_kind'
              assign hero_kind = settings[k]
              assign k = hero_base | append: '_value'
              assign hero_value = settings[k] | default: 0 | plus: 0
              assign k = hero_base | append: '_min_subtotal'
              assign hero_min = settings[k] | default: 0 | plus: 0
              assign k = hero_base | append: '_min_qty'
              assign hero_qty = settings[k] | default: 0 | plus: 0

              # Headline. A merchant who types a label but leaves the numbers at zero still
              # gets a readable line instead of a blank card.
              assign hero_head = ''
              if hero_kind == 'amount' and hero_value > 0
                assign hero_head = '&#8377;' | append: hero_value
              elsif hero_value > 0
                assign hero_head = hero_value | append: '%'
              endif
              if hero_head == blank
                assign hero_head = hero_label | default: hero_code
              elsif hero_first
                assign hero_head = hero_head | append: ' off your first order'
              else
                assign hero_head = hero_head | append: ' off your order'
              endif

              # Qualifier, with Indian comma grouping. Thousands only: the minimums this
              # store runs sit well under a lakh.
              # ponytail: grouping breaks above 99,999. Split on lakhs if that ever changes.
              assign hero_sub = 'No minimum on your first order'
              if hero_min > 0
                assign hero_amt = hero_min | append: ''
                if hero_min >= 1000
                  assign hero_th = hero_min | divided_by: 1000
                  assign hero_rest = hero_min | modulo: 1000 | prepend: '000' | slice: -3, 3
                  assign hero_amt = hero_th | append: ',' | append: hero_rest
                endif
                assign hero_sub = 'On orders of &#8377;' | append: hero_amt | append: ' and above'
              elsif hero_qty > 0
                assign hero_sub = 'On any ' | append: hero_qty | append: ' pieces or more'
              endif
            -%}
            <div class="tapi-pdp__offers tapi-ticket">
              <div class="tapi-ticket__text">
                <span class="tapi-ticket__eyebrow">{% if hero_first %}Welcome offer{% else %}Offer for you{% endif %}</span>
                <p class="tapi-ticket__head">{{ hero_head }}</p>
                <p class="tapi-ticket__sub">{{ hero_sub }}</p>
              </div>
              {%- comment -%} One control, not a chip plus a button: the whole thing is the
                copy target, so a thumb that lands anywhere on the code still works and a
                screen reader announces one clear action. {%- endcomment -%}
              <button type="button" class="tapi-ticket__chip" data-tapi-copy="{{ hero_code }}" aria-label="Copy discount code {{ hero_code }}">
                <span class="tapi-ticket__code">{{ hero_code }}</span>
                <span class="tapi-ticket__copy">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="9" y="9" width="11" height="11" rx="1"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>
                  <span data-copy-label>Copy code</span>
                </span>
              </button>
            </div>
          {%- endif -%}

        {%- comment -%} More offers, sharing an edge with the ticket above. The two are one
          offer block: the recommended code, then the rest of them. Collapsed by
          default so only ONE offer competes for attention above the fold. Reuses
          pdp_offer_ids + pdp_hero_id computed in the offers block above; skips the
          hero so it never repeats. {%- endcomment -%}
        {%- if section.settings.show_offers and pdp_offer_ids.size > 1 -%}
          <details class="tapi-acc tapi-pdp__more-offers">
            <summary><span>More offers ({{ pdp_offer_ids.size | minus: 1 }})</span><span class="tapi-acc__toggle">+</span></summary>
            <div class="tapi-acc__body tapi-pdp__more-body">
              <ul class="tapi-pdp__more-list">
                {%- for id in pdp_offer_ids -%}
                  {%- if id == pdp_hero_id -%}{%- continue -%}{%- endif -%}
                  {%- liquid
                    assign mo_base = 'tapi_offer' | append: id
                    assign k_code = mo_base | append: '_code'
                    assign mo_code = settings[k_code] | strip | upcase
                    assign k_label = mo_base | append: '_label'
                    assign mo_label = settings[k_label]
                  -%}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.59 13.41 12 22l-8.59-8.59A2 2 0 0 1 3 12V4a1 1 0 0 1 1-1h8a2 2 0 0 1 1.41.59L22 12a2 2 0 0 1-1.41 1.41Z" stroke-linejoin="round"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
                    <span>{{ mo_label | default: mo_code }}</span>
                    <button type="button" class="tapi-code-chip" data-tapi-copy="{{ mo_code }}" aria-label="Copy code {{ mo_code }}">
                      <span class="tapi-code-chip__code">{{ mo_code }}</span>
                      <span class="tapi-code-chip__label" data-copy-label>Copy</span>
                    </button>
                  </li>
                {%- endfor -%}
              </ul>
              <p class="tapi-pdp__offers-note">One code per order &middot; the best one is applied for you in the cart.</p>
            </div>
          </details>
        {%- endif -%}

        {%- comment -%}
          Fit feedback tile — disabled on request. Un-wrap this comment block
          (remove the {%- comment -%} / {%- endcomment -%} lines) to restore
          the size-down / true-to-size / size-up bar. CSS for .tapi-fit-feedback*
          is still present in assets/tapi-pdp.css so re-enabling is a one-line
          revert.
        {%- endcomment -%}
        {%- comment -%}
        {%- if m.fit_pct_true -%}
          <div class="tapi-fit-feedback" role="group" aria-label="Fit feedback">
            <strong>Fit feedback from {{ m.review_count | default: '100+' }} buyers</strong>
            <div class="tapi-fit-feedback__bar" data-tapi-reveal>
              <span style="--w: {{ m.fit_pct_down }}%; background: var(--tapi-terracotta-soft);"></span>
              <span style="--w: {{ m.fit_pct_true }}%; background: var(--tapi-sage);"></span>
              <span style="--w: {{ m.fit_pct_up }}%; background: var(--tapi-terracotta);"></span>
            </div>
            <div class="tapi-fit-feedback__legend">
              <span>{{ m.fit_pct_down }}% size down</span>
              <span>{{ m.fit_pct_true }}% true</span>
              <span>{{ m.fit_pct_up }}% size up</span>
            </div>
          </div>
        {%- endif -%}
        {%- endcomment -%}

        <div class="tapi-pdp__cta-row" data-pdp-desktop-cta>
          <div class="tapi-pdp__qty">
            <button type="button" data-qty-down>−</button>
            <input type="number" name="quantity" value="1" min="1" data-qty-input>
            <button type="button" data-qty-up>+</button>
          </div>
          <button type="submit" name="add" class="button button--primary tapi-pdp__add" data-add-btn>
            <span data-add-label>Add to bag · {{ current_variant.price | money }}</span>
          </button>
        </div>
        {%- comment -%} Native dynamic-checkout (Buy it now). Replaces the old custom
          formaction redirect: that raw POST to /cart/add?return_to=/checkout navigated
          the browser straight to checkout, so COD King's storefront script never saw it
          and its OTP / partial-COD gate could not attach (the reason OTP skipped Buy
          Now). The native button is the element COD King hooks — it can gate it with
          OTP or hide it from the app. Renders only when the merchant keeps dynamic
          checkout on; hidden on sold-out via JS ([data-dynamic-checkout]). {%- endcomment -%}
        {%- if section.settings.show_dynamic_checkout -%}
          <div class="tapi-pdp__dynamic-checkout" data-dynamic-checkout>
            {{ form | payment_button }}
          </div>
        {%- endif -%}

        {%- if product.selling_plan_groups.size > 0 -%}{% comment %}reserved{% endcomment %}{%- endif -%}
      {%- endform -%}


      {%- comment -%} Then the reassurance, last in the buy column: how it ships, how
        they can pay, and what happens if something is wrong. It closes the block rather
        than competing with the offer or the buy button above it. {%- endcomment -%}
      {%- if section.settings.show_trust_badges -%}
        {% render 'tapi-trust-badges', layout: 'pdp', cod: section.settings.payment_perks %}
      {%- endif -%}

      {%- comment -%} Curation promise + WhatsApp concierge — honest, brand-true trust
        at the point of purchase. Each toggles independently in the section settings. {%- endcomment -%}
      {% render 'tapi-pdp-trust', section: section, product: product %}

      {%- comment -%}
        Delivery pincode lookup — disabled on request. Un-wrap this comment
        block to restore. Snippet snippets/pincode-delivery.liquid is intact
        so re-enabling is a one-line revert. (Delivery-only, no pickup.)
      {%- endcomment -%}
      {%- comment -%}
      {%- render 'pincode-delivery', product: product -%}
      {%- endcomment -%}


      <div class="tapi-pdp__accordions">
        <details class="tapi-acc">
          <summary><span>Description</span><span class="tapi-acc__toggle">+</span></summary>
          <div class="tapi-acc__body rte">{{ product.description }}</div>
        </details>
        {%- if has_fabric -%}
          <details class="tapi-acc" open>
            <summary><span>Fabric &amp; care</span><span class="tapi-acc__toggle">+</span></summary>
            <div class="tapi-acc__body">
              <table class="tapi-fabric-table">
                <tbody>
                  {%- if m.gsm -%}<tr><td>GSM</td><td>{{ m.gsm }} gsm</td></tr>{%- endif -%}
                  {%- if m.blend -%}<tr><td>Fabric</td><td>{{ m.blend }}</td></tr>{%- endif -%}
                  {%- if m.weave -%}<tr><td>Weave</td><td>{{ m.weave }}</td></tr>{%- endif -%}
                  {%- if m.fit_type -%}<tr><td>Fit type</td><td>{{ m.fit_type }}</td></tr>{%- endif -%}
                  {%- if m.neckline -%}<tr><td>Neckline</td><td>{{ m.neckline }}</td></tr>{%- endif -%}
                  {%- if m.length -%}<tr><td>Length</td><td>{{ m.length }}</td></tr>{%- endif -%}
                  {%- if m.opacity_note -%}<tr><td>Opacity</td><td>{{ m.opacity_note }}</td></tr>{%- endif -%}
                  {%- if m.breathability -%}<tr><td>Breathability</td><td>{{ m.breathability }}</td></tr>{%- endif -%}
                  {%- if m.wash_care -%}<tr><td>Wash care</td><td>{{ m.wash_care }}</td></tr>{%- endif -%}
                  {%- if m.occasion -%}<tr><td>Occasion</td><td>{{ m.occasion }}</td></tr>{%- endif -%}
                  <tr><td>Country of origin</td><td>{{ m.origin | default: 'India' }}</td></tr>
                </tbody>
              </table>
            </div>
          </details>
        {%- endif -%}
        {%- if m.model_height -%}
          <details class="tapi-acc">
            <summary><span>Model &amp; fit</span><span class="tapi-acc__toggle">+</span></summary>
            <div class="tapi-acc__body">
              <div class="tapi-model-grid">
                <div><span>Height</span><strong>{{ m.model_height }}</strong></div>
                <div><span>Wearing size</span><strong>{{ m.model_size }}</strong></div>
                <div><span>Bust</span><strong>{{ m.model_bust }}″</strong></div>
                <div><span>Waist</span><strong>{{ m.model_waist }}″</strong></div>
                {%- if m.fit_note -%}<div class="tapi-model-grid__full"><span>Fit feedback</span><strong>{{ m.fit_note }}</strong></div>{%- endif -%}
              </div>
            </div>
          </details>
        {%- endif -%}
        <details class="tapi-acc">
          <summary><span>Shipping &amp; returns</span><span class="tapi-acc__toggle">+</span></summary>
          <div class="tapi-acc__body">
            <p>Free delivery on prepaid orders{% if section.settings.payment_perks != blank %}. Cash on Delivery available across India, with a delivery fee shown at checkout{% endif %}. If a piece arrives torn, broken or simply wrong, we replace it free within 7 days and cover the courier both ways. Want a different size instead? We exchange it where we have that size, with the delivery both ways on you. Change of mind returns are not accepted, and anything coming back must be unworn with its tags on. <a href="/pages/refund-policy">See full returns</a>.</p>
          </div>
        </details>
      </div>
    </div>
  </div>

  {%- comment -%} ----- MOBILE STICKY BUY BAR -----
    The in-page CTA row + Buy-it-now are display:none under 750px, so these are
    the ONLY add/checkout controls on mobile. They are therefore real, focusable
    controls (no aria-hidden / tabindex=-1): hiding them from AT would leave
    mobile screen-reader users with no way to buy. The dynamic "Add — Size·Color"
    label is dropped here: it overflows a half-width button, and nothing reads the
    text (the variant is carried by #variant-id + the form). Selection is instead
    confirmed on the muted meta line and the size/colour selectors above. {%- endcomment -%}
  <div class="tapi-pdp__mobile-cta">
    <div class="tapi-pdp__mobile-meta">
      <div class="tapi-pdp__mobile-price-wrap">
        <span class="tapi-pdp__mobile-price" data-mobile-price>{{ current_variant.price | money }}</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="tapi-pdp__mobile-was">{{ current_variant.compare_at_price | money }}</span>
        {%- endif -%}
      </div>
      <span class="tapi-pdp__mobile-sel" data-mobile-sel>{{ current_variant.title | replace: ' / ', ' · ' }}</span>
    </div>
    <div class="tapi-pdp__mobile-actions">
      <button type="submit" form="product-form-{{ section.id }}" name="add"
              class="button button--primary tapi-pdp__mobile-add" data-mobile-add>
        Add to bag
      </button>
      {%- comment -%} Mobile Buy Now relays a tap to the native dynamic-checkout button
        in the buy column (the single, COD-King-hooked source of truth) instead of doing
        its own raw redirect, so the OTP gate fires on phones too. type=button (not a form
        submit) so it can never bypass the app. Only rendered when dynamic checkout is on,
        mirroring desktop; if off, the bar shows Add to Cart alone (full width). {%- endcomment -%}
      {%- if section.settings.show_dynamic_checkout -%}
        <button type="button" class="button button--terracotta tapi-pdp__mobile-buy" data-mobile-buy>
          Buy Now
        </button>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ----- FULL-SCREEN IMAGE VIEWER (lightbox) -----
    Built once from product.media (capped at 6 to mirror the inline gallery, so
    indices stay in lockstep). Hidden until the zoom button or an image tap opens
    it. Swipe / keyboard / zoom / video is wired in tapi-motion.js
    (setupPdpLightbox); it reuses the inline gallery's active index, so opening
    lands on the current image and closing returns the inline gallery to it. {%- endcomment -%}
  {%- if product.media.size > 0 -%}
    {%- assign lb_total = product.media.size -%}
    <div class="tapi-lightbox" data-lightbox hidden>
      <div class="tapi-lightbox__backdrop" data-lightbox-close></div>
      <div class="tapi-lightbox__dialog" role="dialog" aria-modal="true" aria-label="{{ product.title | escape }} gallery">
        <div class="tapi-lightbox__bar">
          <span class="tapi-lightbox__counter" aria-hidden="true"><span data-lightbox-current>1</span> / <span data-lightbox-total>{{ lb_total }}</span></span>
          <button type="button" class="tapi-lightbox__close" data-lightbox-close aria-label="Close full screen">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>
        <div class="tapi-lightbox__stage" data-lightbox-stage>
          {%- for media in product.media -%}
            <figure class="tapi-lightbox__slide{% if forloop.first %} is-active{% endif %}" data-lightbox-index="{{ forloop.index0 }}" data-media-type="{{ media.media_type }}">
              {%- case media.media_type -%}
                {%- when 'video' -%}
                  <video class="tapi-lightbox__video" data-lb-video playsinline controls preload="none" poster="{{ media.preview_image | image_url: width: 1600 }}">
                    {%- for s in media.sources -%}{%- if s.format == 'mp4' -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endif -%}{%- endfor -%}
                    {%- for s in media.sources -%}{%- unless s.format == 'mp4' -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endunless -%}{%- endfor -%}
                  </video>
                {%- when 'external_video' -%}
                  <div class="tapi-lightbox__external" data-lb-external data-video-host="{{ media.host }}" data-video-id="{{ media.external_id }}">
                    <img class="tapi-lightbox__img" src="{{ media.preview_image | image_url: width: 1600 }}" width="{{ media.preview_image.width }}" height="{{ media.preview_image.height }}" alt="{{ media.preview_image.alt | default: product.title | escape }}" loading="lazy" draggable="false">
                    <button type="button" class="tapi-lightbox__playbtn" aria-label="Play video">
                      <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                    </button>
                  </div>
                {%- else -%}
                  {%- comment -%} The fullscreen viewer is opened by only a fraction of
                    visitors and is display:none until then, so these were already deferred
                    (loading=lazy inside [hidden]). We go one step further: a resolved src
                    lives ONLY on the first slide; the rest carry the URL in data-src and are
                    hydrated by setupPdpLightbox's loadLo() when their slide (or a neighbour)
                    is shown -- mirroring the existing data-hi/loadHi upgrade. This trims N-1
                    pre-resolved image URLs out of every PDP's initial HTML with zero change
                    to what the viewer shows. width/height keep the box reserved pre-hydrate. {%- endcomment -%}
                  <img class="tapi-lightbox__img" data-zoomable
                       {% if forloop.first %}src="{{ media.preview_image | image_url: width: 1200 }}"{% else %}data-src="{{ media.preview_image | image_url: width: 1200 }}"{% endif %}
                       data-hi="{{ media.preview_image | image_url: width: 2048 }}"
                       width="{{ media.preview_image.width }}" height="{{ media.preview_image.height }}"
                       alt="{{ media.preview_image.alt | default: product.title | escape }}"
                       loading="lazy" draggable="false">
              {%- endcase -%}
            </figure>
          {%- endfor -%}

          {%- if lb_total > 1 -%}
            <button type="button" class="tapi-lightbox__nav tapi-lightbox__nav--prev" data-lightbox-prev aria-label="Previous image">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 6l-6 6 6 6"/></svg>
            </button>
            <button type="button" class="tapi-lightbox__nav tapi-lightbox__nav--next" data-lightbox-next aria-label="Next image">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6"/></svg>
            </button>
          {%- endif -%}
        </div>
        {%- if lb_total > 1 -%}
          <div class="tapi-lightbox__thumbs" data-lightbox-thumbs>
            {%- for media in product.media -%}
              <button type="button" class="tapi-lightbox__thumb{% if forloop.first %} is-active{% endif %}" data-lightbox-thumb="{{ forloop.index0 }}" aria-label="Go to image {{ forloop.index }}">
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', widths: '120, 160' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

{%- comment -%} Structured data for the PDP. Product + Offer drives rich results and
  GEO/AEO retrieval; BreadcrumbList gives the path. AggregateRating + Review are
  emitted only when the merchant opts in (settings.emit_rating_schema) AND a rating
  count exists. Off by default, so the on-page numbers can show while the search-engine
  rating markup is held until the ratings are verifiable. {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  {%- if product.images.size > 0 -%}
  "image": [{% for image in product.images limit: 6 %}{{ image | image_url: width: 1400 | prepend: 'https:' | json }}{% unless forloop.last %}, {% endunless %}{% endfor %}],
  {%- endif -%}
  {%- if product.description != blank -%}
  "description": {{ product.description | strip_html | truncate: 4000 | json }},
  {%- endif -%}
  "category": "Women's Indian Ethnic Wear",
  "audience": { "@type": "PeopleAudience", "suggestedGender": "female" },
  "countryOfOrigin": {{ m.origin | default: 'India' | json }},
  {%- if m.blend != blank %}
  "material": {{ m.blend | json }},
  {%- endif %}
  {%- if m.blend != blank or m.gsm != blank or m.weave != blank or m.fit_type != blank or m.neckline != blank or m.length != blank %}
  "additionalProperty": [
    {%- assign fp = true -%}
    {%- if m.blend != blank %}{ "@type": "PropertyValue", "name": "Fabric", "value": {{ m.blend | json }} }{%- assign fp = false -%}{%- endif -%}
    {%- if m.gsm != blank %}{% unless fp %},{% endunless %}{ "@type": "PropertyValue", "name": "GSM", "value": {{ m.gsm | append: ' gsm' | json }} }{%- assign fp = false -%}{%- endif -%}
    {%- if m.weave != blank %}{% unless fp %},{% endunless %}{ "@type": "PropertyValue", "name": "Weave", "value": {{ m.weave | json }} }{%- assign fp = false -%}{%- endif -%}
    {%- if m.fit_type != blank %}{% unless fp %},{% endunless %}{ "@type": "PropertyValue", "name": "Fit", "value": {{ m.fit_type | json }} }{%- assign fp = false -%}{%- endif -%}
    {%- if m.neckline != blank %}{% unless fp %},{% endunless %}{ "@type": "PropertyValue", "name": "Neckline", "value": {{ m.neckline | json }} }{%- assign fp = false -%}{%- endif -%}
    {%- if m.length != blank %}{% unless fp %},{% endunless %}{ "@type": "PropertyValue", "name": "Length", "value": {{ m.length | json }} }{%- assign fp = false -%}{%- endif -%}
  ],
  {%- endif %}
  {%- comment -%} Always the store brand. product.vendor holds the internal supplier
    and must never surface publicly (schema, feeds, or UI). {%- endcomment -%}
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  {%- if current_variant.sku != blank -%}
  "sku": {{ current_variant.sku | json }},
  {%- endif -%}
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      "itemCondition": "https://schema.org/NewCondition",
      "shippingDetails": { "@id": "#mp-shipping" },
      "hasMerchantReturnPolicy": { "@id": "#mp-returns" },
      "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "priceValidUntil": "{{ 'now' | date: '%Y' | plus: 1 | append: '-12-31' }}",
      "url": {{ request.origin | append: variant.url | json }}{% if variant.sku != blank %},
      "sku": {{ variant.sku | json }}{% endif %}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]{%- if section.settings.emit_rating_schema and disp_count > 0 -%},
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ disp_avg | json }},
    "reviewCount": {{ disp_count | json }},
    "bestRating": "5",
    "worstRating": "1"
  }{%- if feat_count > 0 -%},
  "review": [
    {%- assign rp = true -%}
    {%- for r in feat_list -%}
      {%- assign r_rating = r.rating | plus: 0 -%}
      {%- if r_rating <= 0 -%}{%- continue -%}{%- endif -%}
      {%- unless rp -%},{%- endunless -%}{%- assign rp = false -%}
      {
        "@type": "Review",
        "reviewRating": { "@type": "Rating", "ratingValue": {{ r_rating | json }}, "bestRating": "5", "worstRating": "1" },
        "author": { "@type": "Person", "name": {{ r.author | default: 'Verified buyer' | json }} }{% if r.body != blank %},
        "reviewBody": {{ r.body | strip_html | truncate: 1000 | json }}{% endif %}{% if r.date != blank %},
        "datePublished": {{ r.date | json }}{% endif %}
      }
    {%- endfor -%}
  ]{%- endif -%}{%- endif -%}
}
</script>
{%- comment -%} Shipping + return policy nodes referenced by @id from every Offer above.
  Values are ground truth from the store: delivery profile ships domestic at Rs 0,
  FAQ promises 1-2 day dispatch and 3-7 day transit, refund policy gives a 7-day
  window. Three return cases, and only one is free: our mistake (wrong piece,
  wrong size sent, torn, broken or defective) is replaced free both ways, a
  voluntary size exchange is customer-paid both ways, and a change of mind is
  refused outright. Hence returnFees = ReturnFeesCustomerResponsibility for the
  general case (NOT FreeReturn) with itemDefectReturnFees declaring the free one.
  Colour swaps are no longer offered. If shipping rates or the return window
  change in admin, update this block to match. {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@graph": [
    {
      "@type": "OfferShippingDetails",
      "@id": "#mp-shipping",
      "shippingRate": { "@type": "MonetaryAmount", "value": 0, "currency": "INR" },
      "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "IN" },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 2, "unitCode": "DAY" },
        "transitTime": { "@type": "QuantitativeValue", "minValue": 3, "maxValue": 7, "unitCode": "DAY" }
      }
    },
    {
      "@type": "MerchantReturnPolicy",
      "@id": "#mp-returns",
      "applicableCountry": "IN",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 7,
      "returnMethod": "https://schema.org/ReturnByMail",
      {%- comment -%} Two different cases, so the general returnFees stays the conservative
        one (a size exchange is paid by the customer both ways) and the defect case declares
        its own free return. Never widen returnFees to FreeReturn: that would tell Google
        every return is free, which is only true when the fault is ours. {%- endcomment -%}
      "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility",
      "itemDefectReturnFees": "https://schema.org/FreeReturn",
      "refundType": ["https://schema.org/ExchangeRefund", "https://schema.org/FullRefund"],
      "merchantReturnLink": {{ request.origin | append: '/pages/refund-policy' | json }}
    }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | append: routes.root_url | json }} },
    {%- assign bc_col = collection | default: product.collections.first -%}
    {%- if bc_col.url != blank and bc_col.title != blank -%}
    { "@type": "ListItem", "position": 2, "name": {{ bc_col.title | json }}, "item": {{ request.origin | append: bc_col.url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
    {%- else -%}
    { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
    {%- endif -%}
  ]
}
</script>

{%- comment -%}
  The product page CSS lives in assets/tapi-pdp.css, not in a stylesheet block
  here. Shopify compiles every section's block into one render-blocking file
  served on every page, so keeping it here shipped 30KB of PDP styles to the
  homepage, the collections and the cart. layout/theme.liquid links it for
  product pages only, before base.css so the cascade is unchanged.
{%- endcomment -%}

<script>
  (function () {
    // Inline script — runs in DOM order, finds OUR section reliably
    // via the script-tag's preceding [data-section-id] ancestor.
    var thisScript = document.currentScript;
    var sec = (thisScript && thisScript.closest('[data-section-id]'))
           || document.querySelector('.tapi-pdp');
    if (!sec) return;

    const thumbs = sec.querySelectorAll('.tapi-pdp__thumb');
    const mains  = sec.querySelectorAll('.tapi-pdp__main-img');

    // ---- Image skeleton: shimmer each gallery slot until its photo paints, then
    // fade the image in. Cached images (img.complete) skip straight to loaded, so
    // there's no flash on repeat visits. Video slides have no <img> and just clear.
    (function setupGallerySkeleton() {
      const settle = function (slot) {
        const img = slot.querySelector('img');
        if (!img) { slot.classList.add('is-loaded'); return; }
        if (img.complete && img.naturalWidth > 0) { slot.classList.add('is-loaded'); return; }
        slot.classList.add('is-loading');
        const done = function () {
          slot.classList.remove('is-loading');
          slot.classList.add('is-loaded');
        };
        img.addEventListener('load', done, { once: true });
        img.addEventListener('error', done, { once: true });
      };
      mains.forEach(settle);
      thumbs.forEach(settle);
    })();

    const variantInput = sec.querySelector('[id^="variant-id-"]');
    const addLabel  = sec.querySelector('[data-add-label]');
    const mobileAdd = sec.querySelector('[data-mobile-add]');
    const mobileBuy = sec.querySelector('[data-mobile-buy]');
    const mobileSel = sec.querySelector('[data-mobile-sel]');
    const mobilePrice = sec.querySelector('[data-mobile-price]');
    const qtyInput  = sec.querySelector('[data-qty-input]');

    // ---- Variant matrix (Size × Color) — single source of truth ----
    const addBtn   = sec.querySelector('.tapi-pdp__add');
    // Native dynamic-checkout (Buy it now) container — replaces the old custom buy
    // button. Shown/hidden with availability; the mobile sticky Buy Now relays here.
    const dynCheckout = sec.querySelector('[data-dynamic-checkout]');
    const stockNote = sec.querySelector('[data-stock-note]');
    const colorLabel = sec.querySelector('[data-color-label]');
    const matrixEl = sec.querySelector('[data-variant-matrix]');
    let VARIANTS = [];
    try { VARIANTS = JSON.parse(matrixEl ? matrixEl.textContent : '[]'); } catch (_) { VARIANTS = []; }
    const lowEl = sec.querySelector('[data-low-stock]');
    const lowStock = (lowEl && parseInt(lowEl.getAttribute('data-low-stock'), 10)) || 3;
    const hasColor = VARIANTS.some(v => v.color);

    // Seed selection from the server-active buttons, else first variant.
    const activeSizeBtn = sec.querySelector('.tapi-pdp__size.is-active');
    const activeColorBtn = sec.querySelector('.tapi-pdp__color.is-active');
    let selSize = activeSizeBtn ? activeSizeBtn.getAttribute('data-size') : (VARIANTS[0] ? VARIANTS[0].size : null);
    let selColor = activeColorBtn ? activeColorBtn.getAttribute('data-color') : (hasColor && VARIANTS[0] ? VARIANTS[0].color : null);

    const findVariant = (size, color) =>
      VARIANTS.find(v => v.size === size && (!hasColor || v.color === color)) || null;

    // Re-run the rise animation by toggling .is-active (forces reflow).
    const refadeActiveMain = () => {
      const active = sec.querySelector('.tapi-pdp__main-img.is-active');
      if (!active) return;
      active.classList.remove('is-active');
      void active.offsetWidth;
      active.classList.add('is-active');
    };

    // Cross-availability: a size greys out if it has no available variant in the
    // chosen color, and a colour greys out if unavailable in the chosen size —
    // the behaviour customers expect from COS / Aritzia / Zara PDPs.
    const paintAvailability = () => {
      sec.querySelectorAll('.tapi-pdp__size').forEach(btn => {
        const size = btn.getAttribute('data-size');
        const v = findVariant(size, selColor);
        const out = !v || !v.available;
        btn.classList.toggle('is-out', out);
        btn.setAttribute('aria-disabled', out ? 'true' : 'false');
        btn.classList.toggle('is-low', !!(v && v.available && v.inv > 0 && v.inv <= lowStock));
        const on = size === selSize;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-checked', on ? 'true' : 'false');
      });
      sec.querySelectorAll('.tapi-pdp__color').forEach(btn => {
        const color = btn.getAttribute('data-color');
        const v = findVariant(selSize, color);
        btn.setAttribute('aria-disabled', (!v || !v.available) ? 'true' : 'false');
        btn.classList.toggle('is-out', !v || !v.available);
        const on = color === selColor;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-checked', on ? 'true' : 'false');
      });
    };

    // Resolve the (size, color) selection to a real variant and reflect it
    // everywhere: hidden cart id, ?variant URL, price, CTA, stock note, image.
    const render = () => {
      const v = findVariant(selSize, selColor);
      if (v && variantInput) variantInput.value = v.id;
      if (v) {
        try { const u = new URL(window.location.href); u.searchParams.set('variant', v.id); window.history.replaceState({}, '', u.toString()); } catch (_) {}
      }
      if (colorLabel && selColor) colorLabel.textContent = selColor;

      const qty = Math.max(1, parseInt((qtyInput && qtyInput.value) || '1', 10) || 1);
      const priceText = v ? v.priceText : '';
      const available = !!(v && v.available);
      const label = hasColor ? [selSize, selColor].filter(Boolean).join(' · ') : selSize;

      // The mobile bar mirrors the selected variant on a muted meta line, so its
      // two buttons can keep static, non-overflowing labels (Add to bag / Buy Now).
      if (mobileSel) mobileSel.textContent = label || '';
      if (available) {
        if (addLabel) addLabel.textContent = qty > 1 ? `Add to bag (${qty}) · ${priceText}` : `Add to bag · ${priceText}`;
        if (mobileAdd) { mobileAdd.textContent = 'Add to bag'; mobileAdd.disabled = false; mobileAdd.removeAttribute('aria-disabled'); }
        if (mobileBuy) { mobileBuy.textContent = 'Buy Now'; mobileBuy.disabled = false; mobileBuy.removeAttribute('aria-disabled'); }
        if (addBtn) { addBtn.disabled = false; addBtn.removeAttribute('aria-disabled'); }
        if (dynCheckout) dynCheckout.hidden = false;
        if (stockNote) stockNote.textContent = (v.inv > 0 && v.inv <= lowStock)
          ? `Selling fast${label ? ' · ' + label : ''}`
          : 'In stock · ships in 1 to 2 days';
      } else {
        if (addLabel) addLabel.textContent = 'Sold out';
        if (mobileAdd) { mobileAdd.textContent = 'Sold out'; mobileAdd.disabled = true; mobileAdd.setAttribute('aria-disabled', 'true'); }
        if (mobileBuy) { mobileBuy.textContent = 'Buy Now'; mobileBuy.disabled = true; mobileBuy.setAttribute('aria-disabled', 'true'); }
        if (addBtn) { addBtn.disabled = true; addBtn.setAttribute('aria-disabled', 'true'); }
        if (dynCheckout) dynCheckout.hidden = true;
        if (stockNote) stockNote.textContent = label ? `Sold out · ${label}` : 'Sold out, restocking soon';
      }
      if (mobilePrice && priceText) mobilePrice.textContent = priceText;

      // Per-colour media: drive the SHARED gallery (and the full-screen viewer, which
      // mirrors it) to this colour. __tapiApplyVariant filters the gallery to the
      // colour's assigned photos (native image.variants grouping) and lands on this
      // variant's featured image, keeping main image, thumbs, dots and lightbox on ONE
      // source of truth. Falls back to the media-only jump on older cached JS.
      if (v && sec.__tapiApplyVariant) sec.__tapiApplyVariant(selColor, v.mediaId);
      else if (v && v.mediaId && sec.__tapiGotoMedia) sec.__tapiGotoMedia(v.mediaId);
      paintAvailability();
      refadeActiveMain();
    };
    // Back-compat alias for the qty stepper + initial sync below.
    const rerenderCta = render;

    // Gallery navigation (thumbs, dots, prev/next, keyboard, swipe) is wired
    // up by tapi-motion.js so it loads from a known-cached script tag.

    // Colour select — pick any colour; availability/CTA reflect the result.
    sec.querySelectorAll('.tapi-pdp__color').forEach(btn => {
      btn.addEventListener('click', function () {
        selColor = btn.getAttribute('data-color');
        render();
      });
    });

    // Size select — document-level capture delegation, scoped to this section.
    const onSizeClick = function (e) {
      const b = e.target.closest('.tapi-pdp__size');
      if (!b || !sec.contains(b)) return;
      e.preventDefault();
      selSize = b.getAttribute('data-size');
      render();
    };
    document.addEventListener('click', onSizeClick, true);

    // Qty stepper — now refreshes the CTA so the price reflects the order
    const setQty = (next) => {
      if (!qtyInput) return;
      qtyInput.value = String(Math.max(1, next | 0));
      rerenderCta();
    };
    const qDown = sec.querySelector('[data-qty-down]');
    const qUp   = sec.querySelector('[data-qty-up]');
    if (qDown) qDown.addEventListener('click', () => setQty(parseInt(qtyInput.value || '1', 10) - 1));
    if (qUp)   qUp.addEventListener('click',   () => setQty(parseInt(qtyInput.value || '1', 10) + 1));
    if (qtyInput) {
      let qtyDebounce = null;
      qtyInput.addEventListener('input', () => {
        if (qtyDebounce) clearTimeout(qtyDebounce);
        qtyDebounce = setTimeout(() => setQty(parseInt(qtyInput.value || '1', 10)), 80);
      });
    }

    // Mobile sticky "Buy Now" → relay the tap to the native dynamic-checkout button in
    // the buy column (kept rendered but visually hidden on mobile). The native button is
    // what COD King hooks, so the OTP / partial-COD gate fires on phones too. Queried at
    // click time because Shopify injects the button asynchronously. There is deliberately
    // no raw-redirect fallback: that is exactly the COD-bypassing behaviour being removed.
    if (mobileBuy && dynCheckout) {
      mobileBuy.addEventListener('click', function (e) {
        e.preventDefault();
        const native = dynCheckout.querySelector('.shopify-payment-button__button')
                    || dynCheckout.querySelector('button');
        if (native) native.click();
      });
    }

    // Fit-feedback bar reveal — flips the .in class to trigger width transitions
    const bar = sec.querySelector('.tapi-fit-feedback__bar');
    if (bar && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { bar.classList.add('in'); io.disconnect(); } }, { threshold: 0.4 });
      io.observe(bar);
    } else if (bar) {
      bar.classList.add('in');
    }

    // Initial sync (in case size/colour was preselected server-side or via ?variant)
    rerenderCta();

    // The gallery controller (tapi-motion.js) boots on DOMContentLoaded — AFTER this
    // inline script parses — so the first render above can't drive the image yet.
    // Re-issue the media jump once the controller is live; this lands a deep-linked
    // ?variant (e.g. a Colour-first product opened on a non-default colour) on the
    // right image. No-op when the default colour already maps to slide 0.
    var syncInitialMedia = function () {
      var v0 = findVariant(selSize, selColor);
      if (v0 && sec.__tapiApplyVariant) { sec.__tapiApplyVariant(selColor, v0.mediaId); return true; }
      if (v0 && v0.mediaId && sec.__tapiGotoMedia) { sec.__tapiGotoMedia(v0.mediaId); return true; }
      return false;
    };
    if (!syncInitialMedia()) {
      document.addEventListener('DOMContentLoaded', syncInitialMedia);
      window.addEventListener('load', syncInitialMedia);
    }

    // ---- Size guide dialog ----
    // The trigger is a real link to /pages/fabric-guide#size-guide; if the browser
    // supports <dialog>, intercept the click and open inline instead. Anything older
    // just follows the link. Idempotent so theme-editor re-renders don't double-bind.
    if (!sec.__tapiSizeGuideWired) {
      var sgDialog = sec.querySelector('.tapi-sizeguide');
      var sgOpen = sec.querySelector('[data-size-guide-open]');
      if (sgDialog && sgOpen && typeof sgDialog.showModal === 'function') {
        sec.__tapiSizeGuideWired = true;
        sgOpen.addEventListener('click', function (e) {
          e.preventDefault();
          sgDialog.showModal();
        });
        var sgClose = sgDialog.querySelector('[data-size-guide-close]');
        if (sgClose) sgClose.addEventListener('click', function () { sgDialog.close(); });
        // Click on the backdrop (outside the panel) closes it.
        sgDialog.addEventListener('click', function (e) {
          if (e.target === sgDialog) sgDialog.close();
        });
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Tapi product",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "checkbox", "id": "enable_sticky_info", "default": true, "label": "Sticky buy column on desktop" },
    { "type": "checkbox", "id": "show_dynamic_checkout", "default": true, "label": "Show native Buy it now button", "info": "Shopify's native dynamic-checkout (Buy it now) button. Required for COD King's OTP / partial-COD to gate the Buy Now action. The mobile sticky Buy Now mirrors it. Turn off to sell through Add to cart only." },
    { "type": "header", "content": "Payment perks" },
    { "type": "text", "id": "payment_perks", "label": "Cash on Delivery is live", "info": "Put any text here once your COD app is live. The text itself is no longer shown: it acts as the switch that adds the Cash on Delivery row to the reassurance block and to Shipping & returns. Leave blank and the store never offers COD." },
    { "type": "checkbox", "id": "show_trust_badges", "default": true, "label": "Show the reassurance block", "info": "Secure payment, free delivery and 7 day replacement, at the foot of the buy column. The Cash on Delivery row appears only when the setting above is filled in." },
    { "type": "checkbox", "id": "show_offers", "label": "Show offers under the price", "default": true, "info": "Lists the offers configured in Theme settings → Offers (single source of truth, shared with the cart panel) with copyable codes. Keep Theme settings → Offers in sync with Discounts." },

    { "type": "header", "content": "Trust & ratings", "info": "Honest, brand-true trust builders. Toggle any piece on or off. The rating under the product title shows ONLY the real numbers in each product's Rating count / Rating average metafields and stays hidden until you enter them, so no rating is ever fabricated." },
    { "type": "checkbox", "id": "show_promise", "default": true, "label": "Show curation promise" },
    { "type": "text", "id": "promise_heading", "default": "Checked end to end, before it reaches you", "label": "Curation promise heading" },
    { "type": "textarea", "id": "promise_intro", "default": "Morpaankh makes, it does not just sell. Some pieces are cut and stitched in our own unit, others with makers we work closely with, and every single one is checked end to end before it leaves us. So the piece that reaches you is the exact piece we signed off on, right down to the last thread.", "label": "Curation promise intro" },
    { "type": "text", "id": "promise_point_1", "default": "We check every length of fabric for weight, feel and finish", "label": "Promise point 1" },
    { "type": "text", "id": "promise_point_2", "default": "We inspect the finished garment end to end, the seams, the fall, every detail", "label": "Promise point 2" },
    { "type": "text", "id": "promise_point_3", "default": "Nothing is packed or dispatched until it clears that check", "label": "Promise point 3" },
    { "type": "text", "id": "promise_signature", "default": "The Morpaankh team", "label": "Signature (optional)" },
    { "type": "checkbox", "id": "show_concierge", "default": true, "label": "Show WhatsApp concierge", "info": "Uses the store WhatsApp link from Theme settings → Social media. Hides itself automatically when that link is blank." },
    { "type": "text", "id": "concierge_heading", "default": "Talk to us before you buy", "label": "Concierge heading" },
    { "type": "text", "id": "concierge_text", "default": "Message us on WhatsApp about fabric, fit or sizing and a real person will get back to you, usually the same day. We would rather help you get it right the first time than leave you guessing.", "label": "Concierge text" },
    { "type": "text", "id": "concierge_btn", "default": "Chat on WhatsApp", "label": "Concierge button label" },
    { "type": "checkbox", "id": "emit_rating_schema", "default": false, "label": "Add rating to Google rich-result data", "info": "Off by default. When on, the rating count and average are added to the product's search-engine structured data (star snippets in Google). Only turn this on for ratings that are genuinely received and defensible, since Google can penalise unverifiable review markup." },

    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "presets": [{ "name": "Tapi product" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
