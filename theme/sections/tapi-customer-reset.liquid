{%- comment -%}
  Tapi reset password — final step in the recovery flow. Customer arrives
  here via the link in the recovery email; they set a new password using
  Shopify's reset_customer_password form tag.
{%- endcomment -%}

<section class="tapi-customer tapi-customer--reset" data-tapi-reveal>
  <div class="tapi-customer__shell">
    <span class="tapi-eyebrow tapi-eyebrow--line">{{ section.settings.eyebrow }}</span>
    <h1 class="tapi-customer__heading">{{ section.settings.heading }}</h1>
    <p class="tapi-customer__lede">{{ section.settings.lede }}</p>

    {%- form 'reset_customer_password', novalidate: 'novalidate', class: 'tapi-customer__form' -%}
      {%- if form.errors -%}
        <div class="tapi-customer__errors" role="alert">
          <ul>
            {%- for error in form.errors -%}
              <li>{{ form.errors.messages[error] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <label class="tapi-customer__label" for="ResetPassword">New password</label>
      <input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required placeholder="At least 8 characters" class="tapi-customer__input">

      <label class="tapi-customer__label" for="ResetPasswordConfirm">Confirm new password</label>
      <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required placeholder="Repeat new password" class="tapi-customer__input">

      <button type="submit" class="button button--primary tapi-customer__submit">Save new password</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Tapi reset password",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "— Almost there" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Set a new password." },
    { "type": "textarea", "id": "lede", "label": "Description", "default": "Pick something at least 8 characters long. You'll be signed in straight after." }
  ],
  "enabled_on": { "templates": ["customers/reset_password"] }
}
{% endschema %}
