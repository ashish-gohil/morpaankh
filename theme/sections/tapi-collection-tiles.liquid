<section class="tapi-collection-tiles">
  <div class="page-width">
    <div class="tapi-collection-tiles__head" data-tapi-reveal>
      <div>
        <span class="tapi-eyebrow tapi-eyebrow--line">{{ section.settings.eyebrow }}</span>
        <h2 class="tapi-collection-tiles__heading">{{ section.settings.heading }}</h2>
      </div>
      <p class="tapi-collection-tiles__intro">{{ section.settings.intro }}</p>
    </div>
    <div class="tapi-collection-tiles__grid" data-tapi-stagger="140">
      {%- for b in section.blocks -%}
        {%- assign coll = b.settings.collection -%}
        <a href="{%- if coll != blank -%}{{ coll.url }}{%- else -%}/collections/all{%- endif -%}" class="tapi-tile tapi-lift" data-tapi-reveal {{ b.shopify_attributes }}>
          <div class="tapi-tile__media">
            {%- if b.settings.image != blank -%}
              {{ b.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: b.settings.heading }}
            {%- elsif coll != blank and coll.featured_image -%}
              {{ coll.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: coll.title }}
            {%- else -%}
              <div class="tapi-tile__placeholder" style="background: {{ b.settings.tint | default: '#B7472A' }}; --p-color: {{ b.settings.tint | default: '#B7472A' }};">
                <span>{{ b.settings.placeholder_name | default: b.settings.heading }}</span>
              </div>
            {%- endif -%}
          </div>
          <div class="tapi-tile__info">
            <div class="tapi-tile__title-row">
              <h3 class="tapi-tile__title">{{ b.settings.heading | default: coll.title }}</h3>
              {%- if coll != blank -%}<span class="tapi-tile__count">{{ coll.products_count }} pieces</span>{%- endif -%}
            </div>
            <div class="tapi-eyebrow">{{ b.settings.tagline }}</div>
            <p class="tapi-tile__blurb">{{ b.settings.blurb }}</p>
            <span class="tapi-tile__arrow tapi-arrow-slide">Explore <em>→</em></span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .tapi-collection-tiles { background: var(--tapi-cream-2); padding: 9.6rem 0; }
  .tapi-collection-tiles__head { display: flex; justify-content: space-between; align-items: end; margin-bottom: 4.8rem; gap: 3.2rem; flex-wrap: wrap; }
  .tapi-collection-tiles__heading { font-family: var(--font-heading-family); font-size: clamp(3rem, 6vw, 6rem); margin: 1.2rem 0 0; font-weight: 500; letter-spacing: -0.012em; }
  .tapi-collection-tiles__intro { color: var(--tapi-warm-grey); font-size: 1.5rem; line-height: 1.6; max-width: 36rem; margin: 0; }
  .tapi-collection-tiles__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.4rem; }
  .tapi-tile { display: flex; flex-direction: column; gap: 2rem; text-decoration: none; color: inherit; }
  .tapi-tile__media { aspect-ratio: 4 / 5; overflow: hidden; }
  .tapi-tile__media img, .tapi-tile__placeholder { width: 100%; height: 100%; object-fit: cover; transition: transform 1200ms cubic-bezier(0.22,1,0.36,1); }
  .tapi-tile:hover .tapi-tile__media img, .tapi-tile:hover .tapi-tile__placeholder { transform: scale(1.05); }
  .tapi-tile__title { transition: color 240ms; }
  .tapi-tile:hover .tapi-tile__title { color: var(--tapi-terracotta); }
  .tapi-tile__placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background-image:
    repeating-linear-gradient(45deg, rgba(255,255,255,0.1) 0 1px, transparent 1px 6px),
    radial-gradient(circle at 30% 30%, rgba(255,255,255,0.15), transparent 70%);
    background-color: var(--p-color); }
  .tapi-tile__placeholder span { font-family: var(--font-heading-family); font-style: italic; font-size: 6rem; color: var(--tapi-cream); }
  .tapi-tile__title-row { display: flex; justify-content: space-between; align-items: baseline; gap: 1.2rem; }
  .tapi-tile__title { font-family: var(--font-heading-family); font-size: 2.6rem; margin: 0; font-weight: 500; }
  .tapi-tile__count { font-size: 1.1rem; color: var(--tapi-muted); font-variant-numeric: tabular-nums; }
  .tapi-tile__blurb { color: var(--tapi-warm-grey); margin: 1rem 0; line-height: 1.6; flex: 1; }
  .tapi-tile__arrow { font-size: 1.2rem; letter-spacing: 0.1em; text-transform: uppercase; }
  @media (max-width: 989px) { .tapi-collection-tiles__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .tapi-collection-tiles__grid { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection tiles",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The wardrobe" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built around three ideas." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Kurta sets for the everyday. Co-ords for the in-between. Festive pieces for the days that ask to be remembered." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "tagline", "label": "Tagline" },
        { "type": "textarea", "id": "blurb", "label": "Blurb" },
        { "type": "text", "id": "placeholder_name", "label": "Placeholder display name" },
        { "type": "color", "id": "tint", "label": "Placeholder tint" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Collection tiles",
      "blocks": [
        { "type": "tile", "settings": { "heading": "Kurta Sets", "tagline": "Three pieces, every day", "blurb": "Kurta, pants, and dupatta — cut for movement, finished by hand at the hem.", "placeholder_name": "Saanjh", "tint": "#B7472A" } },
        { "type": "tile", "settings": { "heading": "Co-ord Sets", "tagline": "Two pieces, one story", "blurb": "Cropped jackets, wide pants, matching tops and bottoms made to be worn together — or apart.", "placeholder_name": "Amba", "tint": "#7A8761" } },
        { "type": "tile", "settings": { "heading": "Festive Edit", "tagline": "For the days that ask to be remembered", "blurb": "Silk-cotton dobby, hand-finished tassel work, gold thread. Made to be photographed in.", "placeholder_name": "Mehfil", "tint": "#B08947" } }
      ]
    }
  ]
}
{% endschema %}
