{{ 'wardrobe-fix.css' | asset_url | stylesheet_tag }}
<section class="tapi-collection-tiles">
  <div class="page-width">
    <div class="tapi-collection-tiles__head" data-tapi-reveal>
      <div>
        <span class="tapi-eyebrow tapi-eyebrow--line">{{ section.settings.eyebrow }}</span>
        <h2 class="tapi-collection-tiles__heading">{{ section.settings.heading }}</h2>
      </div>
      <p class="tapi-collection-tiles__intro">{{ section.settings.intro }}</p>
    </div>
    <div class="tapi-collection-tiles__grid" data-tapi-stagger="140">
      {%- for b in section.blocks -%}
        {%- assign coll = b.settings.collection -%}
        <a href="{%- if coll != blank -%}{{ coll.url }}{%- else -%}/collections/all{%- endif -%}" class="tapi-tile tapi-lift" data-tapi-reveal {{ b.shopify_attributes }}>
          <div class="tapi-tile__media">
            {%- if b.settings.image != blank -%}
              {{ b.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: b.settings.heading }}
            {%- elsif coll != blank and coll.featured_image -%}
              {{ coll.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: coll.title }}
            {%- else -%}
              <div class="tapi-tile__placeholder" style="background: {{ b.settings.tint | default: '#B7472A' }}; --p-color: {{ b.settings.tint | default: '#B7472A' }};">
                <span>{{ b.settings.placeholder_name | default: b.settings.heading }}</span>
              </div>
            {%- endif -%}
          </div>
          <div class="tapi-tile__info">
            <div class="tapi-tile__title-row">
              <h3 class="tapi-tile__title">{{ b.settings.heading | default: coll.title }}</h3>
              {%- if coll != blank -%}<span class="tapi-tile__count">{{ coll.products_count }} pieces</span>{%- endif -%}
            </div>
            <div class="tapi-eyebrow">{{ b.settings.tagline }}</div>
            <p class="tapi-tile__blurb">{{ b.settings.blurb }}</p>
            <span class="tapi-tile__arrow tapi-arrow-slide">Explore <em aria-hidden="true">→</em></span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .tapi-collection-tiles { background: var(--mor-surface-2); }
  .tapi-collection-tiles__head { display: flex; justify-content: space-between; align-items: end; margin-bottom: 4.8rem; gap: 3.2rem; flex-wrap: wrap; }
  .tapi-collection-tiles__heading { font-family: var(--font-heading-family); font-size: var(--mor-h2); margin: 1.2rem 0 0; font-weight: 500; letter-spacing: -0.012em; }
  .tapi-collection-tiles__intro { color: var(--mor-text-muted); font-size: var(--mor-text-base); line-height: var(--mor-leading-body); max-width: 36rem; margin: 0; }
  .tapi-collection-tiles__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--tapi-card-gap, 2.4rem); }
  .tapi-tile { display: flex; flex-direction: column; gap: 2rem; text-decoration: none; color: inherit; height: 100%; }
  .tapi-tile__media { aspect-ratio: 4 / 5; overflow: hidden; position: relative; }
  .tapi-tile__media img, .tapi-tile__placeholder { width: 100%; height: 100%; object-fit: cover; transition: transform 1200ms var(--mor-ease); }

  .tapi-tile__info { display: flex; flex-direction: column; flex: 1; }
  .tapi-tile__title-row { display: flex; justify-content: space-between; align-items: baseline; gap: 1.2rem; margin-bottom: 0.6rem; }
  .tapi-tile__title { font-family: var(--font-heading-family); font-size: var(--mor-h3); margin: 0; font-weight: 500; letter-spacing: -0.008em; transition: color var(--mor-dur-base) var(--mor-ease); }
  .tapi-tile__count { font-size: var(--mor-text-xs); color: var(--mor-text-subtle); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .tapi-tile__info > .tapi-eyebrow { margin-bottom: 1rem; }
  .tapi-tile__blurb { color: var(--mor-text-muted); margin: 0 0 2rem; line-height: var(--mor-leading-body); font-size: var(--mor-text-sm); }
  /* EXPLORE pinned to the card bottom so every card's link sits on one line,
     regardless of blurb length. */
  .tapi-tile__arrow { margin-top: auto; display: inline-flex; align-items: center; gap: 1.2rem; font-size: var(--mor-text-xs); letter-spacing: 0.16em; text-transform: uppercase; color: var(--mor-text); align-self: flex-start; position: relative; padding-right: 0.4rem; }
  .tapi-tile__arrow em { font-style: normal; font-size: 2.2rem; line-height: 1; display: inline-block; transform: translateX(0); transition: transform 420ms var(--mor-ease), letter-spacing 420ms var(--mor-ease); will-change: transform; }
  .tapi-tile__arrow::before { content: ""; position: absolute; left: 0; right: 100%; bottom: -0.4rem; height: 1px; background: var(--mor-accent); transition: right 480ms var(--mor-ease); }
  /* Hover affordances apply only where a real pointer hovers — stops one card
     from freezing in a "stuck hover" (terracotta title + shown underline) after
     a tap on touch screens. */
  @media (hover: hover) {
    .tapi-tile:hover .tapi-tile__media img, .tapi-tile:hover .tapi-tile__placeholder { transform: scale(1.06); }
    .tapi-tile:hover .tapi-tile__title { color: var(--mor-accent); }
    .tapi-tile:hover .tapi-tile__arrow em { transform: translateX(14px); }
    .tapi-tile:hover .tapi-tile__arrow::before { right: 0; }
  }
  /* Touch screens: show the EXPLORE underline statically on every card so all
     tiles read identically (there is no hover to reveal it). */
  @media (hover: none) {
    .tapi-tile__arrow::before { right: 0; }
  }
  .tapi-tile__placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background-image:
    repeating-linear-gradient(45deg, rgba(255,255,255,0.1) 0 1px, transparent 1px 6px),
    radial-gradient(circle at 30% 30%, rgba(255,255,255,0.15), transparent 70%);
    background-color: var(--p-color); }
  .tapi-tile__placeholder span { font-family: var(--font-heading-family); font-style: italic; font-size: 6rem; color: var(--mor-cream); }
  @media (max-width: 989px) { .tapi-collection-tiles__grid { grid-template-columns: 1fr 1fr; } }
  /* Mobile: swap the grid for a horizontal snap-scroll carousel with peeking
     cards (mirrors the hero scroll affordance) so cards breathe instead of
     crowding edge-to-edge. Reverts to the grid at ≥750. */
  @media (max-width: 749px) {
    .tapi-collection-tiles__grid {
      display: flex;
      align-items: stretch;
      grid-template-columns: none;
      gap: 1.6rem;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      scroll-padding-left: var(--mor-gutter, 16px);
    }
    .tapi-collection-tiles__grid::-webkit-scrollbar { display: none; }
    .tapi-collection-tiles__grid > .tapi-tile {
      flex: 0 0 78%;
      max-width: 30rem;
      min-width: 0;
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection tiles",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The wardrobe" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built around three ideas." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Kurta sets for the everyday. Co-ords for the in-between. Festive pieces for the days that ask to be remembered." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "tagline", "label": "Tagline" },
        { "type": "textarea", "id": "blurb", "label": "Blurb" },
        { "type": "text", "id": "placeholder_name", "label": "Placeholder display name" },
        { "type": "color", "id": "tint", "label": "Placeholder tint" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Collection tiles",
      "blocks": [
        { "type": "tile", "settings": { "heading": "Kurta Sets", "tagline": "Three pieces, every day", "blurb": "Kurta, pants, and dupatta. Cut for movement, finished by hand at the hem.", "placeholder_name": "Saanjh", "tint": "#B7472A" } },
        { "type": "tile", "settings": { "heading": "Co-ord Sets", "tagline": "Two pieces, one story", "blurb": "Cropped jackets, wide pants, matching tops and bottoms made to be worn together, or apart.", "placeholder_name": "Amba", "tint": "#7A8761" } },
        { "type": "tile", "settings": { "heading": "Festive Edit", "tagline": "For the days that ask to be remembered", "blurb": "Silk-cotton dobby, hand-finished tassel work, gold thread. Made to be photographed in.", "placeholder_name": "Mehfil", "tint": "#B08947" } }
      ]
    }
  ]
}
{% endschema %}
