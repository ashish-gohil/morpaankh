{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{%- comment -%}
  Tapi predictive-search response template — renders the live AJAX
  results for the header search panel in the Tapi design language.

  Dawn's <predictive-search> web component fetches /search/suggest with
  section_id=predictive-search and swaps the contents of
  [data-predictive-search] with this section's output.

  Mirrors the empty-state two-column layout from header-search.liquid:
   • Top: "Suggested" queries (terracotta leading lines, serif)
   • Bottom: "Matches" — product rows with thumb + name + price + View →
{%- endcomment -%}
{%- if predictive_search.performed -%}
  {%- liquid
    assign products = predictive_search.resources.products
    assign queries = predictive_search.resources.queries
    assign collections_q = predictive_search.resources.collections
    assign first_column_results_size = queries.size | plus: collections_q.size | plus: predictive_search.resources.pages.size | plus: predictive_search.resources.articles.size
    assign total_results = products.size | plus: first_column_results_size
  -%}

  <div id="predictive-search-results" role="listbox" class="tapi-predictive">

    {%- if queries.size > 0 or collections_q.size > 0 -%}
      <div class="tapi-predictive__suggested-source" data-suggested-source hidden>
        {%- for query in queries -%}
          <a href="{{ query.url }}" data-suggested-href="{{ query.url }}" data-suggested-text="{{ query.text | escape }}">{{ query.styled_text }}</a>
        {%- endfor -%}
        {%- for collection in collections_q -%}
          <a href="{{ collection.url }}" data-suggested-href="{{ collection.url }}" data-suggested-text="{{ collection.title | escape }}">{{ collection.title | escape }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if products.size > 0 -%}
      <h3 class="eyebrow tapi-search-block__title">
        {{ products.size }} {% if products.size == 1 %}match{% else %}matches{% endif %}
      </h3>
      <ul
        id="predictive-search-results-products-list"
        class="tapi-search-products tapi-predictive__products"
        role="group"
        aria-labelledby="predictive-search-products"
      >
        {%- for product in products -%}
          <li
            id="predictive-search-option-product-{{ forloop.index }}"
            class="tapi-search-products__item"
            role="option"
            aria-selected="false"
          >
            <a
              href="{{ product.url }}"
              class="tapi-search-product predictive-search__item link link--text"
              tabindex="-1"
            >
              <div class="tapi-search-product__thumb">
                {%- if product.featured_media != blank -%}
                  <img
                    class="tapi-search-product__img"
                    src="{{ product.featured_media | image_url: width: 200 }}"
                    alt="{{ product.featured_media.alt | escape }}"
                    width="64"
                    height="{{ 64 | divided_by: product.featured_media.preview_image.aspect_ratio }}"
                  >
                {%- else -%}
                  <span class="tapi-search-product__placeholder"></span>
                {%- endif -%}
              </div>
              <div class="tapi-search-product__meta">
                <span class="tapi-search-product__name serif">{{ product.title | escape }}</span>
                {%- if settings.predictive_search_show_vendor and product.vendor != blank -%}
                  <span class="tapi-search-product__sub">{{ product.vendor }}</span>
                {%- endif -%}
              </div>
              <div class="tapi-search-product__right">
                {%- if settings.predictive_search_show_price -%}
                  <span class="tapi-search-product__price serif tnum">{{ product.price | money }}</span>
                {%- endif -%}
                <span class="tapi-search-product__cta">View →</span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif predictive_search.terms != blank -%}
      <h3 class="eyebrow tapi-search-block__title">0 matches</h3>
      <p class="tapi-search-empty">
        Nothing matches “{{ predictive_search.terms | escape }}” yet. Try a fabric, color or GSM range.
      </p>
    {%- endif -%}

    {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}

    {%- if predictive_search.terms != blank and products.size > 0 -%}
      <div id="predictive-search-option-search-keywords" class="tapi-predictive__see-all">
        <button
          class="predictive-search__item predictive-search__item--term link-u"
          tabindex="-1"
          role="option"
          aria-selected="false"
        >
          <span data-predictive-search-search-for-text>
            {{- 'templates.search.search_for' | t: terms: predictive_search.terms -}}
          </span>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    {%- endif -%}
  </div>

  <span class="hidden" data-predictive-search-live-region-count-value>
    {%- if total_results == 0 -%}
      {{ 'templates.search.no_results' | t: terms: predictive_search.terms }}
    {%- else -%}
      {{ 'templates.search.results_with_count' | t: count: total_results }}
    {%- endif -%}
  </span>
{%- endif -%}
