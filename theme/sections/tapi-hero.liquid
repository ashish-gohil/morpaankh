{%- liquid
  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign stat_blocks  = section.blocks | where: 'type', 'stat'
  assign slide_count  = slide_blocks.size
-%}
{{ 'hero-fix.css' | asset_url | stylesheet_tag }}
{{ 'home-stitch.css' | asset_url | stylesheet_tag }}
<section class="tapi-hero">
  <div
    class="tapi-hero__carousel"
    data-tapi-carousel
    data-interval="{{ section.settings.interval_ms | default: 5000 }}"
    data-autoplay="{% if section.settings.autoplay %}1{% else %}0{% endif %}"
  >
    <div class="tapi-hero__slides" aria-roledescription="carousel">
      {%- if slide_count > 0 -%}
        {%- for b in slide_blocks -%}
          {%- assign tint = b.settings.tint | default: '#B7472A' -%}
          {%- assign mono = b.settings.mono | default: 'Saanjh' -%}
          {%- if b.settings.image.alt != blank -%}{%- assign slide_alt = b.settings.image.alt -%}{%- elsif b.settings.caption != blank -%}{%- assign slide_alt = b.settings.caption | append: ", Morpaankh women's Indian ethnic wear" -%}{%- else -%}{%- assign slide_alt = "Morpaankh women's Indian ethnic wear" -%}{%- endif -%}
          {%- if forloop.first -%}{%- assign loading_attr = 'eager' -%}{%- assign fetch_attr = 'high' -%}{%- else -%}{%- assign loading_attr = 'lazy' -%}{%- assign fetch_attr = 'auto' -%}{%- endif -%}
          <div
            class="tapi-hero__slide{% if forloop.first %} is-active{% endif %}"
            role="group"
            aria-roledescription="slide"
            aria-label="{{ forloop.index }} of {{ slide_count }}"
            {{ b.shopify_attributes }}
          >
            <div class="tapi-hero__media">
              {%- liquid
                assign img_d = b.settings.image
                assign img_m = b.settings.image_mobile
                # Mobile image falls back to the desktop one, so a mobile viewport is never left blank.
                assign img_m_eff = img_m | default: img_d
                # Per-viewport destinations. Independent: each viewport's image links only
                # to its own URL, and an empty setting leaves that image non-clickable (no
                # fallback between the two, unlike the image fallback above).
                assign link_d = b.settings.link
                assign link_m = b.settings.link_mobile
                # Pull the mp4 source out of each (optional) hosted video for lazy, JS-driven loading.
                assign vd_src = ''
                if b.settings.video != blank
                  for s in b.settings.video.sources
                    if s.format == 'mp4'
                      assign vd_src = s.url
                    endif
                  endfor
                endif
                assign vm_src = ''
                if b.settings.video_mobile != blank
                  for s in b.settings.video_mobile.sources
                    if s.format == 'mp4'
                      assign vm_src = s.url
                    endif
                  endfor
                endif
              -%}
              {%- if img_d != blank -%}
                {%- comment -%}
                  Mobile-first <picture>. The mobile <source> is listed FIRST with an
                  explicit max-width media so a phone's preload scanner matches it and
                  fetches the mobile crop immediately -- it never momentarily resolves the
                  desktop <source> during first paint (an iOS Safari quirk that flashed
                  the wide desktop image in before the mobile one). Desktop (>=990px) takes
                  the second <source>; the <img> is a mobile fallback for legacy browsers.
                  One download per viewport, no JS, no shift.
                {%- endcomment -%}
                <picture class="tapi-hero__picture">
                  {%- if img_m != blank -%}
                    <source
                      media="(max-width: 989px)"
                      srcset="{{ img_m_eff | image_url: width: 540 }} 540w, {{ img_m_eff | image_url: width: 750 }} 750w, {{ img_m_eff | image_url: width: 1080 }} 1080w, {{ img_m_eff | image_url: width: 1320 }} 1320w, {{ img_m_eff | image_url: width: 1600 }} 1600w"
                      sizes="100vw">
                    <source
                      media="(min-width: 990px)"
                      srcset="{{ img_d | image_url: width: 900 }} 900w, {{ img_d | image_url: width: 1200 }} 1200w, {{ img_d | image_url: width: 1600 }} 1600w, {{ img_d | image_url: width: 2000 }} 2000w"
                      sizes="100vw">
                    {{ img_m_eff | image_url: width: 1080 | image_tag:
                       loading: loading_attr,
                       fetchpriority: fetch_attr,
                       widths: '540, 750, 1080, 1320, 1600',
                       sizes: '100vw',
                       alt: slide_alt,
                       class: 'tapi-hero__img' }}
                  {%- else -%}
                    {{ img_d | image_url: width: 2000 | image_tag:
                       loading: loading_attr,
                       fetchpriority: fetch_attr,
                       widths: '900, 1200, 1600, 2000',
                       sizes: '100vw',
                       alt: slide_alt,
                       class: 'tapi-hero__img' }}
                  {%- endif -%}
                </picture>
                {%- comment -%}
                  Optional per-viewport video. preload=none + no src: tapi-motion.js sets
                  the src for the CURRENT viewport only (never both) and plays it solely
                  while this slide is active and in view. It fades in over the <picture>,
                  which doubles as the poster/fallback (and the only media under
                  reduced-motion or when a viewport has no video).
                {%- endcomment -%}
                {%- if vd_src != blank or vm_src != blank -%}
                  <video
                    class="tapi-hero__video"
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-hidden="true"
                    {% if vd_src != blank %}data-src-desktop="{{ vd_src }}"{% endif %}
                    {% if vm_src != blank %}data-src-mobile="{{ vm_src }}"{% endif %}
                  ></video>
                {%- endif -%}
              {%- else -%}
                <div class="tapi-hero__placeholder" style="--p-color: {{ tint }};">
                  <span class="tapi-hero__placeholder-mono">{{ mono }}</span>
                </div>
              {%- endif -%}
              {%- comment -%}
                Optional clickable image. Two transparent overlay links, one per
                viewport, shown by CSS media query — so the desktop and mobile crops
                each link to their OWN URL. Rendered only when that viewport's link
                is set, so an empty setting means the image stays non-clickable. Sits
                above the media/video but below the copy overlay and dots, so the CTAs
                and slide controls keep working. The label span is not decorative: it
                gives the link an accessible name AND keeps the anchor non-empty, so the
                theme's `a:empty { display: none }` reset in base.css can't hide it.
              {%- endcomment -%}
              {%- if link_d != blank -%}
                <a class="tapi-hero__link tapi-hero__link--desktop" href="{{ link_d }}"><span class="tapi-hero__link-label">{{ slide_alt | escape }}</span></a>
              {%- endif -%}
              {%- if link_m != blank -%}
                <a class="tapi-hero__link tapi-hero__link--mobile" href="{{ link_m }}"><span class="tapi-hero__link-label">{{ slide_alt | escape }}</span></a>
              {%- endif -%}
            </div>
            {%- if b.settings.caption != blank -%}
              <span class="tapi-hero__caption">{{ b.settings.caption }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="tapi-hero__slide is-active">
          <div class="tapi-hero__media">
            <div class="tapi-hero__placeholder" style="--p-color: #B7472A;">
              <span class="tapi-hero__placeholder-mono">Saanjh</span>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="tapi-hero__scrim" aria-hidden="true"></div>

    {%- if slide_count > 1 -%}
      <div class="tapi-hero__nav" role="tablist" aria-label="Slide navigation">
        {%- for b in slide_blocks -%}
          <button
            type="button"
            class="tapi-hero__dot{% if forloop.first %} is-active{% endif %}"
            data-idx="{{ forloop.index0 }}"
            role="tab"
            aria-label="Go to slide {{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          ><span></span></button>
        {%- endfor -%}
      </div>
      <div class="tapi-hero__progress" aria-hidden="true"><div class="tapi-hero__progress-fill"></div></div>
    {%- endif -%}
  </div>

  {%- comment -%} Copy: overlays the image on desktop, stacks below it on mobile {%- endcomment -%}
  <div class="tapi-hero__overlay">
    <div class="tapi-hero__copy page-width" data-tapi-stagger="120">
      <span class="tapi-eyebrow tapi-eyebrow--line tapi-hero__eyebrow" data-tapi-reveal>{{ section.settings.eyebrow }}</span>
      <h1 class="tapi-hero__title" data-tapi-reveal>
        {{ section.settings.line_1 }}<br>
        <em class="tapi-hero__title-accent">{{ section.settings.line_2 }}</em>
      </h1>
      <p class="tapi-hero__lede" data-tapi-reveal>{{ section.settings.lede }}</p>
      <div class="tapi-hero__cta-row" data-tapi-reveal>
        {%- if section.settings.cta_primary != blank -%}
          <span data-tapi-magnetic="0.12"><a href="{{ section.settings.cta_primary_link }}" class="button button--primary tapi-hero__cta-primary">{{ section.settings.cta_primary }} <span class="tapi-cta-arrow" aria-hidden="true">→</span></a></span>
        {%- endif -%}
        {%- if section.settings.cta_secondary != blank -%}
          <a href="{{ section.settings.cta_secondary_link }}" class="tapi-hero__cta-secondary">{{ section.settings.cta_secondary }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if stat_blocks.size > 0 -%}
    <div class="tapi-hero__trust page-width">
      {%- for b in stat_blocks -%}
        <div class="tapi-hero__trust-item" {{ b.shopify_attributes }}>
          <span class="tapi-hero__stat-key">{{ b.settings.label }}</span>
          <span class="tapi-hero__stat-val">{{ b.settings.value }}</span>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  /* Full-bleed hero: flush under header, own bottom spacing for trust strip */
  .tapi-hero {
    position: relative;
    background: var(--mor-cream);
    padding-top: 0 !important;
    padding-bottom: clamp(3.2rem, 5vw, 6.4rem) !important;
    --hero-h: clamp(44vh, 50vh, 58vh); /* image height on mobile — short so products are a quick scroll away */
  }
  @media (min-width: 990px) { .tapi-hero { --hero-h: 78vh; } }

  /* Carousel */
  .tapi-hero__carousel {
    position: relative;
    width: 100%;
    height: var(--hero-h);
    min-height: 360px;
    overflow: hidden;
    background: var(--mor-cream-2, #efe9de);
  }
  @media (min-width: 990px) {
    .tapi-hero__carousel { min-height: 600px; max-height: 860px; }
  }
  .tapi-hero__slides {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .tapi-hero__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1100ms cubic-bezier(0.4, 0, 0.2, 1), visibility 0s linear 1100ms;
    will-change: opacity;
  }
  .tapi-hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 1100ms cubic-bezier(0.4, 0, 0.2, 1), visibility 0s linear 0s;
    z-index: 1;
  }
  .tapi-hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .tapi-hero__media img,
  .tapi-hero__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.02);
    transition: transform 9000ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .tapi-hero__slide.is-active .tapi-hero__media img,
  .tapi-hero__slide.is-active .tapi-hero__placeholder {
    transform: scale(1.08);
  }
  /* <picture> wrapper must fill the media box so the <img>'s 100%/cover applies. */
  .tapi-hero__picture { display: block; width: 100%; height: 100%; }
  /* Clickable image: transparent overlay link over the whole media box. z-index 2
     keeps it above the picture/video but below the copy overlay (z 3) and dots
     (z 4). Only the active slide is clickable — inactive slides are visibility:
     hidden. One anchor per viewport; CSS shows the matching one. */
  .tapi-hero__link { position: absolute; inset: 0; z-index: 2; display: block; }
  .tapi-hero__link--desktop { display: none; }
  @media (min-width: 990px) {
    .tapi-hero__link--desktop { display: block; }
    .tapi-hero__link--mobile { display: none; }
  }
  /* Visually-hidden accessible name; also keeps the anchor non-empty so the
     base.css `a:empty { display: none }` reset can't collapse the overlay link. */
  .tapi-hero__link-label {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; border: 0;
  }
  /* Optional video layer: sits over the picture (its poster/fallback) and fades in
     only while playing. object-fit: cover so the uploaded per-viewport crop fills. */
  .tapi-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 700ms cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    z-index: 1;
  }
  .tapi-hero__video.is-playing { opacity: 1; }
  /* Reduced motion: never play video — the still picture below carries the hero. */
  @media (prefers-reduced-motion: reduce) {
    .tapi-hero__video { display: none !important; }
  }
  .tapi-hero__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 30% 25%, rgba(255,255,255,0.18), transparent 60%),
      repeating-linear-gradient(45deg, rgba(255,255,255,0.06) 0 1px, transparent 1px 8px),
      linear-gradient(135deg, var(--p-color, var(--tapi-terracotta)), color-mix(in srgb, var(--p-color, var(--tapi-terracotta)) 65%, #1f1c1a));
  }
  .tapi-hero__placeholder-mono {
    font-family: var(--font-heading-family);
    font-style: italic;
    font-size: clamp(6rem, 14vw, 14rem);
    color: var(--tapi-cream, #f8f3eb);
    letter-spacing: -0.02em;
    line-height: 1;
    opacity: 0.92;
  }

  /* Caption — soft chip bottom-right (out of the way of overlay copy) */
  .tapi-hero__caption {
    position: absolute;
    right: var(--mor-gutter, 24px);
    bottom: 5.6rem;
    z-index: 3;
    padding: 0.6rem 1.2rem;
    background: rgba(31, 28, 26, 0.5);
    color: var(--mor-cream, #F8F4ED);
    font-size: var(--mor-text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-radius: var(--mor-radius-sm);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 800ms ease 300ms, transform 800ms var(--mor-ease) 300ms;
  }
  .tapi-hero__slide.is-active .tapi-hero__caption {
    opacity: 1;
    transform: translateY(0);
  }

  /* Scrim — only on desktop, where copy overlays the image */
  .tapi-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    display: none;
  }

  /* ===== Copy: MOBILE-FIRST — stacks below the image, dark text on cream ===== */
  .tapi-hero__overlay {
    position: static;
    background: var(--mor-cream);
    padding: clamp(2.8rem, 7vw, 4rem) 0 0;
  }
  .tapi-hero__copy {
    width: 100%;
    max-width: var(--mor-max, 1440px);
    margin-inline: auto;
    padding-inline: var(--mor-gutter, 16px);
    text-align: center;
  }
  .tapi-hero__eyebrow { color: var(--mor-text-muted); }
  .tapi-hero__title {
    font-family: var(--font-heading-family);
    font-size: var(--mor-h1);
    line-height: var(--mor-leading-tight);
    letter-spacing: -0.018em;
    font-weight: 500;
    color: var(--mor-charcoal);
    margin: 1.4rem 0 1.8rem;
  }
  .tapi-hero__title-accent { color: var(--mor-accent); font-weight: 500; font-style: italic; }
  .tapi-hero__lede {
    font-size: var(--mor-text-lg);
    line-height: var(--mor-leading-body);
    color: var(--mor-text-muted);
    margin: 0 auto 3rem;
    max-width: 48rem;
  }
  .tapi-hero__cta-row {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
  }
  .tapi-hero__cta-primary { box-shadow: var(--mor-shadow-md); }
  .tapi-hero__cta-secondary {
    display: inline-flex;
    align-items: center;
    height: 4.8rem;
    padding: 0 2.2rem;
    font-family: var(--font-body-family);
    font-size: var(--mor-text-sm);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mor-primary);
    background: transparent;
    border: 1px solid var(--mor-primary);
    border-radius: var(--mor-radius-sm);
    text-decoration: none;
    transition: background-color var(--mor-dur-base) var(--mor-ease),
                color var(--mor-dur-base) var(--mor-ease),
                border-color var(--mor-dur-base) var(--mor-ease);
  }
  .tapi-hero__cta-secondary:hover {
    background: var(--mor-primary);
    color: var(--mor-cream);
    border-color: var(--mor-primary);
  }

  /* ===== Copy: DESKTOP (>=990) — overlays the image, cream text ===== */
  /* Kill the gap above the hero: the mobile catalog strip's section wrapper
     stays in flow on desktop (only its <nav> is hidden), and the hero's
     .section wrapper can pick up section margin. Collapse both. */
  @media (min-width: 990px) {
    .shopify-section--catalog-strip { display: none !important; }
    .shopify-section.section:has(> .tapi-hero) { margin-top: 0 !important; }
  }

  @media (min-width: 990px) {
    /* Stronger left-weighted scrim so cream copy + gold accent stay readable
       on ANY photograph, not just this sage placeholder. */
    .tapi-hero__scrim {
      display: block;
      /* Dark band extended to ~50% so the whole capped text column (title +
         lede sit within the left half) clears WCAG AA on ANY photo, while the
         right side of the image stays clear. */
      background:
        linear-gradient(90deg, rgba(18,16,14,0.82) 0%, rgba(18,16,14,0.62) 30%, rgba(18,16,14,0.38) 50%, rgba(18,16,14,0.10) 72%, rgba(18,16,14,0) 88%),
        linear-gradient(0deg, rgba(18,16,14,0.42) 0%, rgba(18,16,14,0) 40%);
    }
    .tapi-hero__overlay {
      position: absolute;
      top: 0; left: 0; right: 0;
      height: var(--hero-h, 78vh);
      min-height: 600px;
      max-height: 860px;
      display: flex;
      align-items: center;
      z-index: 3;
      pointer-events: none;
      background: transparent;
      padding: 0;
    }
    /* Defined left inset + capped text column for a clean editorial block */
    /* Click-through so a set hero image link receives clicks across the WHOLE
       image (the copy block is full-width and centred; leaving it interactive
       swallowed clicks in the middle band). Only the CTAs re-enable pointer
       events, so buttons still work and the rest of the image is the link. */
    .tapi-hero__copy {
      text-align: left;
      pointer-events: none;
      padding-inline: clamp(48px, 6vw, 104px);
    }
    .tapi-hero__cta-row { pointer-events: auto; }
    .tapi-hero__copy > * { max-width: 54rem; }
    .tapi-hero__eyebrow { color: rgba(248, 244, 237, 0.88); }
    .tapi-hero__title {
      color: var(--mor-cream);
      text-shadow: 0 2px 28px rgba(18,16,14,0.55), 0 1px 3px rgba(18,16,14,0.4);
    }
    /* Brighter gold + its own shadow so the accent reads on ANY slide,
       including the light gold "Mehfil" image (worst-case contrast). */
    .tapi-hero__title-accent {
      color: #E2BE78;
      text-shadow: 0 2px 28px rgba(18,16,14,0.6), 0 1px 3px rgba(18,16,14,0.45);
    }
    .tapi-hero__lede {
      color: rgba(248, 244, 237, 0.92);
      margin: 0 0 3rem;
      max-width: 46rem;
    }
    .tapi-hero__cta-row { justify-content: flex-start; }
    .tapi-hero__cta-secondary { color: var(--mor-cream); border-color: rgba(248, 244, 237, 0.6); }
    .tapi-hero__cta-secondary:hover { background: var(--mor-cream); color: var(--mor-charcoal); border-color: var(--mor-cream); }
  }

  /* ===== Trust strip ===== */
  .tapi-hero__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2.4rem 4rem;
    align-items: baseline;
    padding-top: 2.4rem;
    margin-top: 2.8rem;
    border-top: 1px solid var(--mor-hairline);
  }
  /* ≥750: clean equal-width columns, each stacking label over value, with
     hairline dividers between — centred under a capped width. */
  @media (min-width: 750px) {
    .tapi-hero__trust {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      justify-content: center;
      align-items: stretch;
      gap: 0;
      max-width: 68rem;
      margin-inline: auto;
    }
    .tapi-hero__trust-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      text-align: center;
      padding: 0.2rem 2.4rem;
    }
    .tapi-hero__trust-item + .tapi-hero__trust-item { border-left: 1px solid var(--mor-hairline); }
    .tapi-hero__trust .tapi-hero__stat-key { text-align: center; }
  }
  .tapi-hero__trust-item { display: inline-flex; align-items: baseline; gap: 0.8rem; }
  .tapi-hero__stat-key {
    font-size: var(--mor-text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mor-text-subtle);
  }
  .tapi-hero__stat-val {
    font-family: var(--font-heading-family);
    font-size: var(--mor-h4);
    color: var(--mor-text);
  }

  /* Mobile trust: 2-column label/value grid, centred and perfectly aligned */
  @media (max-width: 749px) {
    .tapi-hero__trust {
      display: grid;
      grid-template-columns: auto auto;
      justify-content: center;
      column-gap: 1.4rem;
      row-gap: 1rem;
    }
    .tapi-hero__trust-item { display: contents; }
    .tapi-hero__stat-key { text-align: right; align-self: baseline; }
    .tapi-hero__stat-val { text-align: left; }
  }

  /* <480: stack CTAs full-width for thumb reach */
  @media (max-width: 480px) {
    .tapi-hero__cta-row { flex-direction: column; align-items: stretch; width: 100%; }
    .tapi-hero__cta-row > span { display: block; }
    .tapi-hero__cta-row .button,
    .tapi-hero__cta-secondary { width: 100%; justify-content: center; }
  }

  /* ===== Phones + tablets (< 990px): image-only hero =====
     Drop the eyebrow, lede, CTAs and trust strip so the hero is just the
     photograph and products are a tap away (the brand story now lives in the
     studio note near the bottom). The H1 stays a real, indexable heading —
     visually hidden, not display:none — so the homepage keeps its sole H1 for
     SEO and screen readers. The desktop overlay (>= 990px) is unchanged. */
  @media (max-width: 989px) {
    .tapi-hero__eyebrow,
    .tapi-hero__lede,
    .tapi-hero__cta-row,
    .tapi-hero__trust { display: none !important; }
    .tapi-hero__overlay { padding: 0 !important; background: transparent !important; }
    .tapi-hero__title {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
    }
    .tapi-hero { padding-bottom: 0 !important; }
  }

  /* Reduced motion: no zoom, instant crossfade */
  @media (prefers-reduced-motion: reduce) {
    .tapi-hero__slide,
    .tapi-hero__media img,
    .tapi-hero__placeholder,
    .tapi-hero__caption,
    .tapi-hero__progress-fill { transition: none !important; transform: none !important; }
  }

  /* Dot navigation */
  .tapi-hero__nav {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2.4rem;
    z-index: 4;
    display: flex;
    justify-content: center;
    gap: 1rem;
    padding: 0 var(--tapi-gutter, 16px);
  }
  .tapi-hero__dot {
    appearance: none;
    -webkit-appearance: none;
    border: none;
    background: transparent;
    padding: 1rem 0;
    cursor: pointer;
    width: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tapi-hero__dot span {
    display: block;
    width: 100%;
    height: 2px;
    background: rgba(248, 243, 235, 0.4);
    transition: background-color 360ms ease, height 240ms ease;
  }
  .tapi-hero__dot.is-active span { background: var(--tapi-cream, #f8f3eb); height: 3px; }
  .tapi-hero__dot:hover span { background: rgba(248, 243, 235, 0.75); }
  .tapi-hero__dot:focus-visible { outline: 2px solid var(--tapi-cream, #f8f3eb); outline-offset: 4px; }

  /* Auto-play progress hairline (under dots) */
  .tapi-hero__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: rgba(31, 28, 26, 0.08);
    z-index: 4;
  }
  .tapi-hero__progress-fill {
    height: 100%;
    width: 0%;
    background: var(--tapi-terracotta, #b7472a);
    transition: width linear;
    transform-origin: left;
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    'use strict';
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function initCarousel(root) {
      if (root.__tapiCarouselWired) return;
      root.__tapiCarouselWired = true;

      var slides = root.querySelectorAll('.tapi-hero__slide');
      var dots = root.querySelectorAll('.tapi-hero__dot');
      var fill = root.querySelector('.tapi-hero__progress-fill');
      if (slides.length <= 1) return;

      var interval = Math.max(2500, parseInt(root.getAttribute('data-interval'), 10) || 5000);
      var autoplay = root.getAttribute('data-autoplay') === '1' && !reduceMotion;
      var current = 0;
      var timer = null;
      var paused = false;
      var inView = false;

      // A slide is "video-driven" when it holds a playable hero video for the
      // current viewport. The carousel then does NOT advance on the fixed
      // interval — it holds, and the video module calls __tapiHeroAdvance() once
      // the clip ends. This getter is installed by initHeroVideo; on an
      // image-only hero it's absent and treated as false (plain timer behaviour).
      function videoDriven() {
        return !!(root.__tapiHeroVideoActive && root.__tapiHeroVideoActive());
      }
      function clearTimer() { if (timer) { clearTimeout(timer); timer = null; } }

      function setActive(idx) {
        var next = ((idx % slides.length) + slides.length) % slides.length;
        if (next === current) return;
        slides[current].classList.remove('is-active');
        if (dots[current]) {
          dots[current].classList.remove('is-active');
          dots[current].setAttribute('aria-selected', 'false');
        }
        current = next;
        slides[current].classList.add('is-active');
        if (dots[current]) {
          dots[current].classList.add('is-active');
          dots[current].setAttribute('aria-selected', 'true');
        }
        // Empty the progress bar. scheduleNext() animates it for image slides;
        // the video module drives it from playback for video slides.
        if (fill) { fill.style.transition = 'none'; fill.style.width = '0%'; fill.offsetWidth; }
        if (root.__tapiHeroVideoSync) root.__tapiHeroVideoSync();
      }

      // Hand off from the current slide to the next:
      //  - video-driven -> no timer; the video's 'ended' calls __tapiHeroAdvance
      //  - image slide  -> animate the progress fill, advance after `interval`
      function scheduleNext() {
        clearTimer();
        if (!autoplay || paused || document.hidden || !inView) return;
        if (videoDriven()) return; // the video owns the advance and drives `fill`
        if (fill) {
          fill.style.transition = 'none';
          fill.style.width = '0%';
          // eslint-disable-next-line no-unused-expressions
          fill.offsetWidth; // reflow so the next transition runs
          fill.style.transition = 'width ' + interval + 'ms linear';
          fill.style.width = '100%';
        }
        timer = setTimeout(advance, interval);
      }
      function advance() { setActive(current + 1); scheduleNext(); }
      function stop() {
        clearTimer();
        if (fill) { fill.style.transition = 'none'; fill.style.width = '0%'; }
      }

      // Bridges the video module uses (guarded there, since the carousel bails
      // out early on a single-slide hero and never defines these):
      root.__tapiHeroAdvance = advance;          // video 'ended' -> next slide
      root.__tapiHeroReschedule = scheduleNext;  // re-decide after a source swap / failure
      root.__tapiHeroIsPaused = function () { return paused || document.hidden; };

      // Dot clicks
      Array.prototype.forEach.call(dots, function (d) {
        d.addEventListener('click', function () {
          setActive(parseInt(d.getAttribute('data-idx'), 10) || 0);
          scheduleNext();
        });
      });

      // Pause on hover (desktop) — halts the timer and the active video alike.
      if (window.matchMedia('(hover: hover)').matches) {
        root.addEventListener('mouseenter', function () {
          paused = true; clearTimer();
          if (root.__tapiHeroVideoSync) root.__tapiHeroVideoSync();
        });
        root.addEventListener('mouseleave', function () {
          paused = false;
          if (root.__tapiHeroVideoSync) root.__tapiHeroVideoSync();
          scheduleNext();
        });
      }

      // Pause on tab hidden
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) clearTimer(); else scheduleNext();
        if (root.__tapiHeroVideoSync) root.__tapiHeroVideoSync();
      });

      // Keyboard navigation when dots are focused
      Array.prototype.forEach.call(dots, function (d) {
        d.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowRight') { setActive(current + 1); scheduleNext(); }
          else if (e.key === 'ArrowLeft') { setActive(current - 1); scheduleNext(); }
        });
      });

      // Touch swipe (mobile)
      var touchStartX = null;
      root.addEventListener('touchstart', function (e) {
        if (e.touches && e.touches.length === 1) touchStartX = e.touches[0].clientX;
      }, { passive: true });
      root.addEventListener('touchend', function (e) {
        if (touchStartX === null || !e.changedTouches || !e.changedTouches.length) return;
        var dx = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) > 40) {
          setActive(current + (dx < 0 ? 1 : -1));
          scheduleNext();
        }
        touchStartX = null;
      }, { passive: true });

      // Lazy-start when scrolled into view. The FIRST start is held until the
      // page has loaded and settled (~1s) so the hero stays still through first
      // paint — a calmer, more deliberate first impression, and it keeps the
      // initial render visually stable (better Speed Index). Re-entry (scrolling
      // back into view) starts immediately; manual dots/swipe are never gated.
      var autoplayArmed = false;
      function beginAutoplay() {
        inView = true;
        if (autoplayArmed) { scheduleNext(); return; }
        autoplayArmed = true;
        var go = function () { scheduleNext(); };
        if (document.readyState === 'complete') { setTimeout(go, 1000); }
        else { window.addEventListener('load', function () { setTimeout(go, 1000); }, { once: true }); }
      }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) beginAutoplay();
            else { inView = false; stop(); }
          });
        }, { threshold: 0.15 });
        io.observe(root);
      } else {
        beginAutoplay();
      }
    }

    // Responsive hero video. Decoupled from the carousel so it works on single-slide
    // heroes too. Wires up ONLY if a slide actually has a <video> — image-only heroes
    // pay zero cost. Loads the source for the CURRENT viewport only (never both), and
    // plays just the active, in-view slide. Falls back to the still <picture> under
    // reduced-motion or when a viewport has no video set.
    function initHeroVideo(root) {
      if (root.__tapiHeroVideoWired) return;
      var vids = root.querySelectorAll('.tapi-hero__video');
      if (!vids.length) return;
      root.__tapiHeroVideoWired = true;

      var multi = root.querySelectorAll('.tapi-hero__slide').length > 1;
      var fill = root.querySelector('.tapi-hero__progress-fill');
      var desktopMQ = window.matchMedia('(min-width: 990px)');
      var inView = true;

      function isPaused() { return root.__tapiHeroIsPaused ? root.__tapiHeroIsPaused() : document.hidden; }
      function srcFor(v) {
        return desktopMQ.matches
          ? (v.getAttribute('data-src-desktop') || '')
          : (v.getAttribute('data-src-mobile') || '');
      }
      function activeSlide() { return root.querySelector('.tapi-hero__slide.is-active'); }
      function slideOf(v) { return v.closest('.tapi-hero__slide'); }

      // The carousel checks this before each auto-advance. True = the active
      // slide has a real, playable video for THIS viewport, so the carousel holds
      // and lets the clip finish instead of advancing on its fixed timer.
      root.__tapiHeroVideoActive = function () {
        if (reduceMotion) return false;
        var a = activeSlide();
        if (!a) return false;
        var v = a.querySelector('.tapi-hero__video');
        if (!v || v.__playFailed) return false;
        return !!srcFor(v);
      };

      function loadAndPlay(v) {
        if (reduceMotion) return;
        var src = srcFor(v);
        if (!src) { pause(v); return; }          // no video for this viewport → picture shows
        v.loop = !multi;                         // single-slide loops; multi plays once, then advances
        if (v.getAttribute('data-loaded-src') !== src) {
          v.src = src;
          v.setAttribute('data-loaded-src', src);
          v.load();
        }
        var p = v.play();
        if (p && p.catch) p.catch(function () {
          // Autoplay blocked — don't strand the carousel waiting on this slide.
          v.__playFailed = true;
          if (root.__tapiHeroReschedule) root.__tapiHeroReschedule();
        });
        v.classList.add('is-playing');
      }
      function pause(v) {
        v.classList.remove('is-playing');
        try { v.pause(); } catch (e) {}
      }
      function sync() {
        var active = activeSlide();
        Array.prototype.forEach.call(vids, function (v) {
          if (inView && !isPaused() && slideOf(v) === active) loadAndPlay(v);
          else pause(v);
        });
      }
      // Let the carousel's setActive re-evaluate which video should be playing.
      root.__tapiHeroVideoSync = sync;

      Array.prototype.forEach.call(vids, function (v) {
        // A finished clip on a multi-slide hero advances to the next slide —
        // this is what makes the carousel wait for the video instead of the timer.
        v.addEventListener('ended', function () {
          if (multi && slideOf(v) === activeSlide() && root.__tapiHeroAdvance) root.__tapiHeroAdvance();
        });
        // A broken source must not hang the carousel — fall back to the timer.
        v.addEventListener('error', function () {
          v.__playFailed = true;
          if (slideOf(v) === activeSlide() && root.__tapiHeroReschedule) root.__tapiHeroReschedule();
        });
        // While it's the active video, it drives the progress bar so the bar
        // tracks real remaining time rather than the fixed interval.
        v.addEventListener('timeupdate', function () {
          if (!fill || reduceMotion) return;
          if (slideOf(v) !== activeSlide() || !srcFor(v)) return;
          var d = v.duration;
          if (!d || !isFinite(d)) return;
          fill.style.transition = 'width 0.25s linear';
          fill.style.width = Math.min(100, (v.currentTime / d) * 100) + '%';
        });
      });

      // Crossing the 990px boundary swaps to the other viewport's source, which
      // can change whether this slide is video-driven — re-sync, clear any stale
      // failure flag, then let the carousel re-decide timer vs video.
      function onMQ() {
        Array.prototype.forEach.call(vids, function (v) { v.__playFailed = false; });
        sync();
        if (root.__tapiHeroReschedule) root.__tapiHeroReschedule();
      }
      if (desktopMQ.addEventListener) desktopMQ.addEventListener('change', onMQ);
      else if (desktopMQ.addListener) desktopMQ.addListener(onMQ);

      // Pause while off-screen (saves battery/data), resume on return.
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) { inView = entry.isIntersecting; sync(); });
        }, { threshold: 0.15 }).observe(root);
      }
      sync();
    }

    function boot() {
      document.querySelectorAll('[data-tapi-carousel]').forEach(function (c) {
        initCarousel(c);
        initHeroVideo(c);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }

    document.addEventListener('shopify:section:load', function (e) {
      var c = e.target.querySelector('[data-tapi-carousel]');
      if (c) {
        c.__tapiCarouselWired = false;
        c.__tapiHeroVideoWired = false;
        initCarousel(c);
        initHeroVideo(c);
      }
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Tapi hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Carousel" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-play slides", "default": true },
    { "type": "range", "id": "interval_ms", "label": "Slide interval", "min": 3000, "max": 9500, "step": 500, "unit": "ms", "default": 5500 },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Indian ethnic wear · Rooted in tradition" },
    { "type": "text", "id": "line_1", "label": "Headline line 1", "default": "Cloth we know" },
    { "type": "text", "id": "line_2", "label": "Headline line 2 (accent)", "default": "by heart." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Morpaankh comes from a family raised in India's textile trade, generations who read fabric by touch. We bring that eye to kurta sets, co-ords, and festive pieces chosen for honest cloth and a fit made for real bodies. What you see in the photographs is what arrives." },
    { "type": "text", "id": "cta_primary", "label": "Primary CTA", "default": "Shop kurta sets" },
    { "type": "url", "id": "cta_primary_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta_secondary", "label": "Secondary CTA", "default": "Our story" },
    { "type": "url", "id": "cta_secondary_link", "label": "Secondary CTA link" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "header", "content": "Desktop media (≥ 990px)" },
        { "type": "image_picker", "id": "image", "label": "Desktop image", "info": "Wide / landscape crop. This is the LCP image and the fallback for everything below." },
        { "type": "url", "id": "link", "label": "Desktop image link", "info": "Where the desktop image links when clicked. Leave empty to keep it non-clickable." },
        { "type": "video", "id": "video", "label": "Desktop video (optional)", "info": "Plays muted on a loop over the desktop image. Needs the desktop image set as its still fallback." },
        { "type": "header", "content": "Mobile media (< 990px)" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Taller / portrait crop so phones aren't cropped. Falls back to the desktop image if left empty." },
        { "type": "url", "id": "link_mobile", "label": "Mobile image link", "info": "Where the mobile image links when clicked. Independent of the desktop link. Leave empty to keep it non-clickable." },
        { "type": "video", "id": "video_mobile", "label": "Mobile video (optional)", "info": "Plays muted on a loop on phones. Falls back to the mobile image if left empty." },
        { "type": "header", "content": "Other" },
        { "type": "text", "id": "caption", "label": "Caption (overlay chip)" },
        { "type": "text", "id": "mono", "label": "Placeholder monogram", "default": "Saanjh" },
        { "type": "color", "id": "tint", "label": "Placeholder tint", "default": "#B7472A" }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "value", "label": "Value" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Tapi hero",
      "blocks": [
        { "type": "slide", "settings": { "mono": "Saanjh", "tint": "#B7472A", "caption": "Saanjh · Kurta sets" } },
        { "type": "slide", "settings": { "mono": "Amba",   "tint": "#7A8761", "caption": "Amba · Co-ord sets" } },
        { "type": "slide", "settings": { "mono": "Mehfil", "tint": "#B08947", "caption": "Mehfil · Festive edit" } },
        { "type": "stat", "settings": { "label": "Fit", "value": "True to body" } },
        { "type": "stat", "settings": { "label": "Fabric", "value": "Indian-sourced" } },
        { "type": "stat", "settings": { "label": "From", "value": "India" } }
      ]
    }
  ]
}
{% endschema %}
