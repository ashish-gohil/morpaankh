{%- comment -%}
  Tapi customer login + recover password — single section, two states.
  Uses Shopify's `customer_login` and `recover_customer_password` form
  tags, so the auth flow is identical to Dawn's. The `#recover` URL hash
  toggles the visible form via CSS :target — no JavaScript required.
{%- endcomment -%}

<section
  class="tapi-customer tapi-customer--login"
  data-section-id="{{ section.id }}"
  data-tapi-reveal
>
  <div class="tapi-customer__shell">
    <div id="login" class="tapi-customer__pane tapi-customer__pane--login">
      <span class="tapi-eyebrow tapi-eyebrow--line">{{ section.settings.eyebrow_login }}</span>
      <h1 class="tapi-customer__heading">{{ section.settings.heading_login }}</h1>
      {%- if section.settings.lede_login != blank -%}
        <p class="tapi-customer__lede">{{ section.settings.lede_login }}</p>
      {%- endif -%}

      {%- form 'customer_login', novalidate: 'novalidate', class: 'tapi-customer__form' -%}
        {%- if form.errors -%}
          <div class="tapi-customer__errors" role="alert">
            <strong>{{ 'templates.contact.form.error_heading' | t }}</strong>
            <ul>
              {%- for error in form.errors -%}
                <li>{{ form.errors.messages[error] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <label class="tapi-customer__label" for="CustomerEmail">Email</label>
        <input
          type="email"
          name="customer[email]"
          id="CustomerEmail"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
          placeholder="you@example.com"
          class="tapi-customer__input{% if form.errors contains 'form' %} tapi-customer__input--error{% endif %}"
        >

        <div class="tapi-customer__label-row">
          <label class="tapi-customer__label" for="CustomerPassword">Password</label>
          <a href="#recover" class="tapi-customer__link">Forgot?</a>
        </div>
        <input
          type="password"
          name="customer[password]"
          id="CustomerPassword"
          autocomplete="current-password"
          required
          placeholder="••••••••"
          class="tapi-customer__input"
        >

        <button type="submit" class="button button--primary tapi-customer__submit">
          Sign in
        </button>
      {%- endform -%}

      <div class="tapi-customer__divider"><span>or</span></div>

      <a href="{{ routes.account_register_url }}" class="button button--outline tapi-customer__alt">
        Create an account
      </a>

      <p class="tapi-customer__help">
        Need help? <a href="https://wa.me/{{ section.settings.whatsapp_number }}" target="_blank" rel="noopener" class="tapi-underline">Message us on WhatsApp</a>.
      </p>
    </div>

    <div id="recover" class="tapi-customer__pane tapi-customer__pane--recover">
      <span class="tapi-eyebrow tapi-eyebrow--line">{{ section.settings.eyebrow_recover }}</span>
      <h1 class="tapi-customer__heading">{{ section.settings.heading_recover }}</h1>
      <p class="tapi-customer__lede">{{ section.settings.lede_recover }}</p>

      {%- form 'recover_customer_password', novalidate: 'novalidate', class: 'tapi-customer__form' -%}
        {%- if form.errors -%}
          <div class="tapi-customer__errors" role="alert">
            <ul>
              {%- for error in form.errors -%}
                <li>{{ form.errors.messages[error] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <div class="tapi-customer__success" role="status">
            We sent you a link. Check your inbox in a moment.
          </div>
        {%- endif -%}

        <label class="tapi-customer__label" for="RecoverEmail">Email</label>
        <input
          type="email"
          name="email"
          id="RecoverEmail"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
          placeholder="you@example.com"
          class="tapi-customer__input"
        >

        <button type="submit" class="button button--primary tapi-customer__submit">
          Send reset link
        </button>
      {%- endform -%}

      <p class="tapi-customer__help">
        <a href="#login" class="tapi-underline">← Back to sign in</a>
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tapi login",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow_login", "label": "Login eyebrow", "default": "— A warm return" },
    { "type": "text", "id": "heading_login", "label": "Login heading", "default": "Welcome back." },
    { "type": "textarea", "id": "lede_login", "label": "Login description", "default": "Sign in to see your orders, saved fits, and pickup notes." },
    { "type": "text", "id": "eyebrow_recover", "label": "Recover eyebrow", "default": "— Reset password" },
    { "type": "text", "id": "heading_recover", "label": "Recover heading", "default": "Forgot your password?" },
    { "type": "textarea", "id": "lede_recover", "label": "Recover description", "default": "Enter your email and we'll send a link to reset it." },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number (with country code, digits only)", "default": "919876543210" }
  ],
  "enabled_on": { "templates": ["customers/login"] }
}
{% endschema %}
