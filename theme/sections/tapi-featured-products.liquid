{%- assign coll = section.settings.collection -%}
{%- assign max = section.settings.products_to_show | default: 8 -%}
<section class="tapi-featured">
  <div class="tapi-featured__inner">
    <header class="tapi-featured__head" data-tapi-reveal>
      <div>
        <span class="tapi-eyebrow tapi-eyebrow--line">{{ section.settings.eyebrow }}</span>
        <h2 class="tapi-featured__heading">{{ section.settings.heading }}</h2>
      </div>
      {%- if coll != blank -%}
        <a class="tapi-featured__viewall tapi-arrow-slide" href="{{ coll.url }}">
          {{- section.settings.view_all_text | default: 'View all' }}
          <em>→</em></a
        >
      {%- endif -%}
    </header>

    <div class="tapi-featured__grid" data-tapi-stagger="100">
      {%- if coll != blank -%}
        {%- for product in coll.products limit: max -%}
          <div data-tapi-reveal>
            {%- comment -%} The New Arrivals section already signals "new", so suppress the per-card New tag here only. Every other surface (collection, search, related, recently-viewed) still shows it. {%- endcomment -%}
            {%- render 'card-product-tapi', product: product, suppress_new: true -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..max) -%}
          <div data-tapi-reveal>
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  /* Paint the morpaankh pattern on the section's OWN box so it rides with the
     content on scroll, matching the testimonials section. The body carries the
     pattern with background-attachment: fixed (Dawn's .gradient), which pins it
     to the viewport and made the logos drift through this otherwise-transparent
     section as you scrolled. An opaque cream fill (= the body colour, so the
     look is unchanged) hides that fixed layer; default attachment: scroll then
     anchors this copy to the section. */
  .tapi-featured {
    width: 100%;
    padding-block: clamp(48px, 8vw, 96px);
    background-color: var(--mor-cream);
    background-image: var(--mor-pattern);
    background-size: 200px 200px;
  }
  .tapi-featured__inner { width: 100%; padding-inline: clamp(16px, 4vw, 48px); }
  .tapi-featured__head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: clamp(2.4rem, 3.4vw, 4rem); gap: 2.4rem; flex-wrap: wrap; }
  /* inline-flex (not block) so the .tapi-eyebrow--line ::before bar keeps its
     width/height and animates on hover, matching every other section's eyebrow */
  .tapi-featured__head .tapi-eyebrow { margin-bottom: 1.2rem; display: inline-flex; }
  .tapi-featured__heading { font-family: var(--font-heading-family); font-size: var(--mor-h2); line-height: var(--mor-leading-snug); letter-spacing: -0.01em; font-weight: 500; margin: 0; }
  .tapi-featured__viewall {
    display: inline-flex; align-items: center; gap: 10px;
    height: 48px; padding: 0;
    font-size: var(--mor-text-sm); font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--mor-text); background: transparent; border: none;
    text-decoration: none; transition: color var(--mor-dur-base) var(--mor-ease);
  }
  .tapi-featured__viewall:hover { color: var(--mor-accent); }
  .tapi-featured__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--tapi-card-gap, 24px); }
  @media (max-width: 989px) { .tapi-featured__grid { grid-template-columns: 1fr 1fr; gap: 2rem; } }
  @media (max-width: 749px)  { .tapi-featured__grid { grid-template-columns: 1fr 1fr; column-gap: 1.4rem; row-gap: 2.8rem; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Tapi featured products",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Just arrived" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This week, from our table to yours." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    { "type": "text", "id": "view_all_text", "label": "View all label", "default": "View all" }
  ],
  "presets": [{ "name": "Tapi featured products" }]
}
{% endschema %}
