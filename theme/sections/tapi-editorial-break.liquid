<section class="tapi-editorial-band" data-tapi-reveal aria-label="A note from the studio">
  <div class="tapi-editorial-band__inner">
    <span class="tapi-eyebrow tapi-editorial-band__eyebrow">— A note from the studio</span>
    <blockquote class="tapi-editorial-band__quote">"{{ section.settings.quote }}"</blockquote>
    <p class="tapi-editorial-band__body">{{ section.settings.body }}</p>
    {%- if section.settings.cta_text != blank -%}
      <a href="{{ section.settings.link | default: '/pages/fabric-guide' }}" class="tapi-editorial-band__cta">
        <span>{{ section.settings.cta_text }}</span>
        <span class="tapi-editorial-band__arrow" aria-hidden="true">→</span>
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .tapi-editorial-band {
    background: var(--tapi-cream-2);
    width: 100%;
  }
  .tapi-editorial-band__inner {
    max-width: 72rem;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
  }
  .tapi-editorial-band__eyebrow {
    color: var(--tapi-terracotta);
    letter-spacing: 0.22em;
  }
  .tapi-editorial-band__quote {
    font-family: var(--font-heading-family);
    font-size: clamp(2.6rem, 3.6vw, 4rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.012em;
    color: var(--tapi-charcoal);
    margin: 0;
    max-width: 22ch;
  }
  .tapi-editorial-band__body {
    color: var(--tapi-warm-grey);
    margin: 0;
    line-height: 1.75;
    font-size: 1.5rem;
    max-width: 56ch;
  }
  .tapi-editorial-band__cta {
    margin-top: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0;
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tapi-charcoal);
    text-decoration: none;
    background: transparent;
    border: 0;
    cursor: pointer;
    position: relative;
  }
  .tapi-editorial-band__cta::after {
    content: "";
    position: absolute;
    left: 0; bottom: -6px;
    width: 100%;
    height: 1px;
    background: var(--tapi-terracotta);
    transform: scaleX(0.3);
    transform-origin: left;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .tapi-editorial-band__cta:hover::after { transform: scaleX(1); }
  .tapi-editorial-band__arrow {
    display: inline-block;
    font-style: normal;
    font-size: 1.6rem;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .tapi-editorial-band__cta:hover .tapi-editorial-band__arrow { transform: translateX(8px); }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial break",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "quote", "label": "Quote", "default": "If it isn't in the fabric, it isn't worth the price." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Every kurta set lists its GSM, the weight of the fabric per square metre. Higher isn't always better; it depends on the season and the silhouette." },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Read our fabric guide" },
    { "type": "url", "id": "link", "label": "CTA link" }
  ],
  "presets": [{ "name": "Editorial break" }]
}
{% endschema %}
