{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'tapi-offers.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'tapi-offers.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'tapi-cart-sticky.js' | asset_url }}" defer="defer"></script>

<cart-items class="gradient color-{{ section.settings.color_scheme }} isolate{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}">
  <div class="page-width">
    <div class="title-wrapper-with-link">
      <h1 class="title title--primary">{{ 'sections.cart.title' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="underlined-link">
        {{- 'general.continue_shopping' | t -}}
      </a>
    </div>

    <div class="cart__warnings">
      <h1 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="button">
        {{ 'general.continue_shopping' | t }}
      </a>

      {%- if shop.customer_accounts_enabled and customer == null -%}
        <h2 class="cart__login-title">{{ 'sections.cart.login.title' | t }}</h2>
        <p class="cart__login-paragraph">
          {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
        </p>
      {%- endif -%}
    </div>

    <div class="tapi-cart-grid">
    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden tapi-cart-grid__items" method="post" id="cart">
      <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
        <div class="js-contents">
          {%- if cart != empty -%}
            {%- if section.settings.show_shipping_meter and section.settings.shipping_threshold > 0 -%}
              {%- assign ship_threshold = section.settings.shipping_threshold | times: 100 -%}
              <div class="tapi-ship-meter" role="status">
                {%- if cart.total_price >= ship_threshold -%}
                  <p class="tapi-ship-meter__msg tapi-ship-meter__msg--done">
                    <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true" focusable="false"><path d="M2.5 8.5l3.5 3.5 7.5-8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span>{{ section.settings.shipping_meter_done_text | default: 'Your order ships free.' }}</span>
                  </p>
                  <div class="tapi-ship-meter__track"><span class="tapi-ship-meter__fill" style="width: 100%"></span></div>
                {%- else -%}
                  {%- assign ship_remaining = ship_threshold | minus: cart.total_price | money -%}
                  {%- assign ship_pct = cart.total_price | times: 100.0 | divided_by: ship_threshold | round | at_most: 96 | at_least: 4 -%}
                  <p class="tapi-ship-meter__msg">
                    {{- section.settings.shipping_meter_text | default: 'Add [amount] more for free shipping' | replace: '[amount]', ship_remaining -}}
                  </p>
                  <div class="tapi-ship-meter__track"><span class="tapi-ship-meter__fill" style="width: {{ ship_pct }}%"></span></div>
                {%- endif -%}
              </div>
            {%- endif -%}
            <table class="cart-items">
              <caption class="visually-hidden">
                {{ 'sections.cart.title' | t }}
              </caption>
              <thead>
                <tr>
                  <th class="caption-with-letter-spacing" colspan="2" scope="col">
                    {{ 'sections.cart.headings.product' | t }}
                  </th>
                  <th class="medium-hide large-up-hide right caption-with-letter-spacing" colspan="1" scope="col">
                    {{ 'sections.cart.headings.total' | t }}
                  </th>
                  <th
                    class="cart-items__heading--wide cart-items__heading--quantity small-hide caption-with-letter-spacing"
                    colspan="1"
                    scope="col"
                  >
                    {{ 'sections.cart.headings.quantity' | t }}
                  </th>
                  <th class="small-hide right caption-with-letter-spacing" colspan="1" scope="col">
                    {{ 'sections.cart.headings.total' | t }}
                  </th>
                </tr>
              </thead>

              <tbody>
                {%- for item in cart.items -%}
                  <tr
                    class="cart-item {% if item.parent_relationship.parent != null %}cart-item__nested-line{% endif %}"
                    id="CartItem-{{ item.index | plus: 1 }}"
                    {% if item.parent_relationship.parent != null %}
                      aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
                    {% endif %}
                  >
                    <td class="cart-item__media">
                      {% if item.image %}
                        {% comment %} Leave empty space due to a:empty CSS display: none rule {% endcomment %}
                        <a href="{{ item.url }}" class="cart-item__link" aria-hidden="true" tabindex="-1"> </a>
                        <div class="cart-item__image-container gradient {% if item.parent_relationship.parent == null %}global-media-settings{% endif %}">
                          <img
                            src="{{ item.image | image_url: width: 300 }}"
                            class="cart-item__image {% if item.parent_relationship.parent != null %}global-media-settings{% endif %}"
                            alt="{{ item.image.alt | escape }}"
                            loading="lazy"
                            width="150"
                            height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                          >
                        </div>
                      {% endif %}
                    </td>

                    <td class="cart-item__details">
                      {%- if settings.show_vendor -%}
                        <p class="caption-with-letter-spacing">{{ item.product.vendor }}</p>
                      {%- endif -%}

                      <a href="{{ item.url }}" class="cart-item__name h4 break">{{ item.product.title | escape }}</a>

                      {%- if item.original_price != item.final_price -%}
                        <div class="cart-item__discounted-prices">
                          <span class="visually-hidden">
                            {{ 'products.product.price.regular_price' | t }}
                          </span>
                          <s class="cart-item__old-price product-option">
                            {{- item.original_price | money -}}
                          </s>
                          <span class="visually-hidden">
                            {{ 'products.product.price.sale_price' | t }}
                          </span>
                          <strong class="cart-item__final-price product-option">
                            {{ item.final_price | money }}
                          </strong>
                        </div>
                      {%- else -%}
                        <div class="product-option">
                          {{ item.original_price | money }}
                        </div>
                      {%- endif -%}

                      {%- if item.product.has_only_default_variant == false
                        or item.properties.size != 0
                        or item.selling_plan_allocation != null
                      -%}
                        <dl>
                          {%- if item.product.has_only_default_variant == false -%}
                            {%- for option in item.options_with_values -%}
                              <div class="product-option">
                                <dt>{{ option.name }}:</dt>
                                <dd>{{ option.value }}</dd>
                              </div>
                            {%- endfor -%}
                          {%- endif -%}

                          {%- for property in item.properties -%}
                            {%- assign property_first_char = property.first | slice: 0 -%}
                            {%- if property.last != blank and property_first_char != '_' -%}
                              <div class="product-option">
                                <dt>{{ property.first }}:</dt>
                                <dd>
                                  {%- if property.last contains '/uploads/' -%}
                                    <a href="{{ property.last }}" class="link" target="_blank">
                                      {{ property.last | split: '/' | last }}
                                    </a>
                                  {%- else -%}
                                    {{ property.last }}
                                  {%- endif -%}
                                </dd>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </dl>

                        <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                      {%- endif -%}

                      <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                        {%- for discount in item.line_level_discount_allocations -%}
                          <li class="discounts__discount">
                            {{- 'icon-discount.svg' | inline_asset_content -}}
                            {{ discount.discount_application.title | escape }}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </td>

                    <td class="cart-item__totals right medium-hide large-up-hide">
                      {%- render 'loading-spinner' -%}
                      <div class="cart-item__price-wrapper">
                        {%- if item.original_line_price != item.final_line_price -%}
                          <dl class="cart-item__discounted-prices">
                            <dt class="visually-hidden">
                              {{ 'products.product.price.regular_price' | t }}
                            </dt>
                            <dd>
                              <s class="cart-item__old-price price price--end">
                                {{ item.original_line_price | money }}
                              </s>
                            </dd>
                            <dt class="visually-hidden">
                              {{ 'products.product.price.sale_price' | t }}
                            </dt>
                            <dd class="price price--end">
                              {{ item.final_line_price | money }}
                            </dd>
                          </dl>
                        {%- else -%}
                          <span class="price price--end">
                            {{ item.original_line_price | money }}
                          </span>
                        {%- endif -%}

                        {%- if item.variant.available and item.unit_price_measurement -%}
                          {% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}
                        {%- endif -%}
                      </div>
                    </td>
                    {%- liquid
                      assign has_qty_rules = false
                      if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                        assign has_qty_rules = true
                      endif

                      assign has_vol_pricing = false
                      if item.variant.quantity_price_breaks.size > 0
                        assign has_vol_pricing = true
                      endif
                    -%}
                    <td class="cart-item__quantity{% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}">
                      <quantity-popover>
                        <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                          <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
                            {{ 'products.product.quantity.label' | t }}
                          </label>
                          <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                            {%- if has_qty_rules or has_vol_pricing -%}
                              <button
                                type="button"
                                aria-expanded="false"
                                class="quantity-popover__info-button quantity-popover__info-button--icon-only button button--tertiary small-hide medium-hide"
                              >
                                {{- 'icon-info.svg' | inline_asset_content -}}
                              </button>
                            {%- endif -%}
                            <quantity-input class="quantity cart-quantity">
                              {% assign can_update_quantity = item.instructions.can_update_quantity | default: true %}
                              <button
                                class="quantity__button"
                                name="minus"
                                type="button"
                                {% if can_update_quantity == false %}
                                  disabled
                                {% endif %}
                              >
                                <span class="visually-hidden">
                                  {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
                                </span>
                                <span class="svg-wrapper">
                                  {{- 'icon-minus.svg' | inline_asset_content -}}
                                </span>
                              </button>
                              <input
                                class="quantity__input"
                                data-quantity-variant-id="{{ item.variant.id }}"
                                type="number"
                                name="updates[]"
                                value="{{ item.quantity }}"
                                {% # theme-check-disable %}
                                data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                min="0"
                                data-min="{{ item.variant.quantity_rule.min }}"
                                {% if item.variant.quantity_rule.max != null %}
                                  max="{{ item.variant.quantity_rule.max }}"
                                {% endif %}
                                step="{{ item.variant.quantity_rule.increment }}"
                                {% # theme-check-enable %}
                                aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                id="Quantity-{{ item.index | plus: 1 }}"
                                data-index="{{ item.index | plus: 1 }}"
                                {% if can_update_quantity == false %}
                                  disabled
                                {% endif %}
                              >
                              <button
                                class="quantity__button"
                                name="plus"
                                type="button"
                                {% if can_update_quantity == false %}
                                  disabled
                                {% endif %}
                              >
                                <span class="visually-hidden">
                                  {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
                                </span>
                                <span class="svg-wrapper">
                                  {{- 'icon-plus.svg' | inline_asset_content -}}
                                </span>
                              </button>
                            </quantity-input>
                          </div>
                          <cart-remove-button
                            id="Remove-{{ item.index | plus: 1 }}"
                            data-index="{{ item.index | plus: 1 }}"
                            {% assign can_remove = item.instructions.can_remove | default: true %}
                            {% if can_remove == false %}
                              class="hidden"
                            {% endif %}
                          >
                            <a
                              href="{{ item.url_to_remove }}"
                              class="button button--tertiary"
                              aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                            >
                              <span class="svg-wrapper">
                                {{- 'icon-remove.svg' | inline_asset_content -}}
                              </span>
                            </a>
                          </cart-remove-button>
                        </div>
                        {%- if has_qty_rules or has_vol_pricing -%}
                          <button
                            type="button"
                            class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary large-up-hide"
                            aria-expanded="false"
                          >
                            {{- 'icon-info.svg' | inline_asset_content -}}
                            <span>
                              {%- if has_vol_pricing -%}
                                {{ 'products.product.volume_pricing.note' | t }}
                              {%- elsif has_qty_rules -%}
                                {{ 'products.product.quantity.note' | t }}
                              {%- endif -%}
                            </span>
                          </button>
                        {%- endif -%}
                        {%- if has_vol_pricing or has_qty_rules -%}
                          <div
                            class="cart-items__info global-settings-popup quantity-popover__info"
                            tabindex="-1"
                            hidden
                          >
                            {%- if has_qty_rules == false -%}
                              <span class="volume-pricing-label caption">
                                {{- 'products.product.volume_pricing.title' | t -}}
                              </span>
                            {%- endif -%}
                            <div class="quantity__rules caption">
                              {%- if item.variant.quantity_rule.increment > 1 -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.multiples_of'
                                    | t: quantity: item.variant.quantity_rule.increment
                                  -}}
                                </span>
                              {%- endif -%}
                              {%- if item.variant.quantity_rule.min > 1 -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.min_of'
                                    | t: quantity: item.variant.quantity_rule.min
                                  -}}
                                </span>
                              {%- endif -%}
                              {%- if item.variant.quantity_rule.max != null -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.max_of'
                                    | t: quantity: item.variant.quantity_rule.max
                                  -}}
                                </span>
                              {%- endif -%}
                            </div>
                            <button
                              class="button-close button button--tertiary large-up-hide"
                              type="button"
                              aria-label="{{ 'accessibility.close' | t }}"
                            >
                              <span class="svg-wrapper">
                                {{- 'icon-close.svg' | inline_asset_content -}}
                              </span>
                            </button>
                            {%- if item.variant.quantity_price_breaks.size > 0 -%}
                              <volume-pricing class="parent-display">
                                <ul class="list-unstyled">
                                  <li>
                                    <span>{{ item.variant.quantity_rule.min }}+</span>
                                    {%- assign price = item.variant.price | money_with_currency -%}
                                    <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                  </li>
                                  {%- for price_break in item.variant.quantity_price_breaks -%}
                                    <li>
                                      <span>
                                        {{- price_break.minimum_quantity -}}
                                        <span aria-hidden="true">+</span></span
                                      >
                                      {%- assign price = price_break.price | money_with_currency -%}
                                      <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </volume-pricing>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                        <div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
                          <small class="cart-item__error-text"></small>
                          <span class="svg-wrapper">
                            {{- 'icon-error.svg' | inline_asset_content -}}
                          </span>
                        </div>
                      </quantity-popover>
                    </td>

                    <td class="cart-item__totals right small-hide">
                      {%- render 'loading-spinner' -%}
                      <div class="cart-item__price-wrapper">
                        {%- if item.original_line_price != item.final_line_price -%}
                          <dl class="cart-item__discounted-prices">
                            <dt class="visually-hidden">
                              {{ 'products.product.price.regular_price' | t }}
                            </dt>
                            <dd>
                              <s class="cart-item__old-price price price--end">
                                {{ item.original_line_price | money }}
                              </s>
                            </dd>
                            <dt class="visually-hidden">
                              {{ 'products.product.price.sale_price' | t }}
                            </dt>
                            <dd class="price price--end">
                              {{ item.final_line_price | money }}
                            </dd>
                          </dl>
                        {%- else -%}
                          <span class="price price--end">
                            {{ item.original_line_price | money }}
                          </span>
                        {%- endif -%}

                        {%- if item.variant.available and item.unit_price_measurement -%}
                          {% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}
                        {%- endif -%}
                      </div>
                    </td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
            {%- comment -%} Smart offers panel: after the products (user-requested
              reading order: products, offers, then checkout). Replaced the bundle
              ladder when the Buy 2 / Buy 3 automatics became codes (automatic
              order discounts were blocking WELCOME200 at checkout). Sits inside
              .js-contents so it re-renders with the cart on every quantity
              change; tapi-offers.js auto-applies the biggest general code. {%- endcomment -%}
            {%- if section.settings.show_smart_offers -%}
              {% render 'tapi-smart-offers' %}
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>

      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p
        class="visually-hidden"
        id="shopping-cart-line-item-status"
        aria-live="polite"
        aria-hidden="true"
        role="status"
      >
        {{ 'accessibility.loading' | t }}
      </p>
    </form>

    {%- comment -%} Tapi sticky checkout aside — visible on md+ only (desktop 2-col) {%- endcomment -%}
    {%- if cart != empty -%}
      <aside class="tapi-cart-aside" id="tapi-cart-aside" aria-label="Order summary">
        <h2 class="tapi-cart-aside__title serif">Order summary</h2>

        <div class="tapi-cart-aside__row">
          <span class="tapi-cart-aside__label">Subtotal</span>
          <span class="tapi-cart-aside__value tnum">{{ cart.items_subtotal_price | money }}</span>
        </div>

        {%- if cart.cart_level_discount_applications.size > 0 -%}
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="tapi-cart-aside__row tapi-cart-aside__row--discount">
              <span class="tapi-cart-aside__label">{{ discount.title | escape }}</span>
              <span class="tapi-cart-aside__value tnum">−{{ discount.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}
        {%- endif -%}

        <div class="tapi-cart-aside__row tapi-cart-aside__row--total">
          <span class="tapi-cart-aside__label">Estimated total</span>
          <span class="tapi-cart-aside__value tnum">{{ cart.total_price | money_with_currency }}</span>
        </div>

        <p class="tapi-cart-aside__note">Taxes included. Shipping calculated at checkout.</p>

        {%- if settings.show_cod_prepaid_note and settings.cod_fee > 0 -%}
          <div class="tapi-cod-note">
            <p class="tapi-cod-note__save">
              <svg viewBox="0 0 20 20" width="15" height="15" fill="none" aria-hidden="true" focusable="false"><path d="M2 6h9v7H2zM11 8.5h3.5L17 11v2h-6zM5.5 15.5a1.3 1.3 0 100-2.6 1.3 1.3 0 000 2.6zM14 15.5a1.3 1.3 0 100-2.6 1.3 1.3 0 000 2.6z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
              Pay online for free delivery and save &#8377;{{ settings.cod_fee }}.
            </p>
            <p class="tapi-cod-note__cod">Cash on Delivery adds &#8377;{{ settings.cod_fee }} at checkout.</p>
          </div>
        {%- endif -%}

        <form action="{{ routes.cart_url }}" method="post" id="tapi-cart-checkout-form">
          <button type="submit" name="checkout" class="button button--primary tapi-cart-aside__btn">
            {{ 'sections.cart.checkout' | t }}
          </button>
        </form>
      </aside>
    {%- endif -%}

    {%- comment -%} Mobile sticky checkout bar — a premium, always-reachable CTA that
      mirrors the PDP buy bar. It carries the amount payable and a "you save" badge, and
      retracts (tapi-cart-sticky.js, IntersectionObserver) once the real footer checkout
      button is on screen, so there is never a duplicate CTA at rest. Registered in
      cart.js getSectionsToRender so the amount + badge refresh on quantity change;
      :empty + cart!=empty hide it when the cart empties. Mobile only — desktop uses the
      sticky aside above. Kept below COD King's max z-index so its OTP / partial-payment
      modal always covers this bar. {%- endcomment -%}
    {%- if cart != empty -%}
      {%- comment -%} Total saving = product markdown (MRP/compare_at minus price) PLUS
        every applied cart/line discount (promo code, automatic). Recomputed on each
        section re-render, so it tracks quantity and live promo-code switches. {%- endcomment -%}
      {%- assign tapi_compare_savings = 0 -%}
      {%- for item in cart.items -%}
        {%- if item.variant.compare_at_price and item.variant.compare_at_price > item.variant.price -%}
          {%- assign tapi_line_cs = item.variant.compare_at_price | minus: item.variant.price | times: item.quantity -%}
          {%- assign tapi_compare_savings = tapi_compare_savings | plus: tapi_line_cs -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign tapi_total_savings = tapi_compare_savings | plus: cart.total_discount -%}
      <div class="tapi-cart-stickybar" id="tapi-cart-stickybar">
        <form action="{{ routes.cart_url }}" method="post" class="tapi-cart-stickybar__form">
          {%- if tapi_total_savings > 0 -%}
            <span class="tapi-cart-stickybar__badge">
              <svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true" focusable="false"><path d="M8.6 1.6H13a1.4 1.4 0 011.4 1.4v4.4a1.4 1.4 0 01-.4 1L7.6 14a1.4 1.4 0 01-2 0L1.6 10a1.4 1.4 0 010-2l6.4-6.4a1.4 1.4 0 01.6-.4z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><circle cx="10.4" cy="5.6" r="1" fill="currentColor"/></svg>
              You save {{ tapi_total_savings | money }}
            </span>
          {%- endif -%}
          <button type="submit" name="checkout" class="tapi-cart-stickybar__btn">
            <span class="tapi-cart-stickybar__cta">
              {{ 'sections.cart.checkout' | t }}
              <svg viewBox="0 0 20 20" width="15" height="15" fill="none" aria-hidden="true" focusable="false"><path d="M4 10h11M10.5 5 15.5 10l-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span class="tapi-cart-stickybar__amt tnum">{{ cart.total_price | money }}</span>
          </button>
        </form>
      </div>
    {%- endif -%}

    </div>{%- comment -%} /.tapi-cart-grid {%- endcomment -%}
  </div>
</cart-items>

{% stylesheet %}
  .tapi-cart-grid { display: block; }
  .tapi-cart-aside { display: none; }

  @media (min-width: 990px) {
    .tapi-cart-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.7fr) minmax(320px, 1fr);
      column-gap: clamp(2.4rem, 4vw, 5.6rem);
      row-gap: 2rem;
      align-items: start;
    }
    .tapi-cart-grid__items { min-width: 0; }

    .tapi-cart-aside {
      display: flex;
      flex-direction: column;
      gap: 14px;
      position: sticky;
      top: 120px;
      background: var(--tapi-ivory, #fcfaf4);
      border: 1px solid var(--tapi-hairline, #e5ddc8);
      padding: clamp(24px, 2vw, 36px);
      box-sizing: border-box;
    }
    .tapi-cart-aside__title {
      font-family: var(--font-heading-family, "Cormorant Garamond", Georgia, serif);
      font-size: clamp(22px, 1.8vw, 28px);
      font-weight: 500;
      letter-spacing: -0.005em;
      color: var(--tapi-charcoal, #2c2826);
      margin: 0 0 4px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--tapi-hairline, #e5ddc8);
    }
    .tapi-cart-aside__row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
      font-size: var(--fs-sm);
      color: var(--tapi-charcoal, #2c2826);
    }
    .tapi-cart-aside__row--discount .tapi-cart-aside__value { color: var(--tapi-terracotta, #b7472a); }
    .tapi-cart-aside__row--total {
      margin-top: 4px;
      padding-top: 14px;
      border-top: 1px solid var(--tapi-hairline, #e5ddc8);
    }
    .tapi-cart-aside__row--total .tapi-cart-aside__value { font-size: clamp(22px, 1.8vw, 26px); }
    .tapi-cart-aside:empty { display: none !important; }
    .tapi-cart-aside__label {
      letter-spacing: 0.02em;
      color: var(--tapi-warm-grey, #6b5d54);
      text-transform: none;
    }
    .tapi-cart-aside__value {
      font-family: var(--font-heading-family, "Cormorant Garamond", Georgia, serif);
      font-size: clamp(18px, 1.4vw, 22px);
      color: var(--tapi-charcoal, #2c2826);
    }
    .tapi-cart-aside__note {
      margin: 4px 0 8px;
      font-size: var(--fs-xs);
      line-height: 1.5;
      color: var(--tapi-muted, #97887a);
    }
    .tapi-cart-aside__btn {
      width: 100% !important;
      min-height: 56px;
    }
  }

  /* On md+ the cart-footer section is redundant — hide it. The class
     .cart__footer-wrapper lives on the <section> wrapper itself, so
     target both the section id and the class to cover all renders. */
  @media (min-width: 990px) {
    #shopify-section-cart-footer,
    .shopify-section.cart__footer-wrapper { display: none !important; }
  }
  .tapi-ship-meter {
    margin: 0 0 2.4rem;
    padding: 1.4rem 1.6rem;
    background: var(--mor-cream-2, #F1EBDD);
    border: 1px solid rgba(44, 40, 38, 0.08);
    border-radius: var(--mor-radius-md, 4px);
  }

  .tapi-ship-meter__msg {
    margin: 0 0 1rem;
    font-size: var(--fs-sm);
    letter-spacing: 0.01em;
    color: var(--mor-charcoal, #2C2826);
  }

  .tapi-ship-meter__msg--done {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--mor-primary, #2E4B3C);
    font-weight: 500;
  }

  .tapi-ship-meter__track {
    height: 4px;
    background: rgba(44, 40, 38, 0.1);
    border-radius: var(--mor-radius-pill, 9999px);
    overflow: hidden;
  }

  .tapi-ship-meter__fill {
    display: block;
    height: 100%;
    background: var(--mor-primary, #2E4B3C);
    border-radius: inherit;
    transition: width 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .tapi-ship-meter__fill { transition: none; }
  }

  /* ===== Mobile sticky checkout bar (premium; mirrors the PDP buy bar) ===== */
  /* Hidden by default (desktop uses the sticky aside). :empty keeps it hidden when
     cart.js swaps in an empty cart's contents. */
  .tapi-cart-stickybar { display: none; }
  .tapi-cart-stickybar:empty { display: none !important; }

  @media (max-width: 989px) {
    .tapi-cart-stickybar {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 80;
      padding: 1rem 1.6rem;
      padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
      background-color: #f5efe1;
      background-color: var(--tapi-cream, #f5efe1);
      isolation: isolate;
      border-top: 1px solid var(--tapi-hairline-2, rgba(44, 40, 38, 0.12));
      box-shadow: 0 -10px 30px rgba(44, 40, 38, 0.10);
      /* Slide-only reveal/retract — NEVER fade opacity, or the bar goes
         semi-transparent mid-transition and cart text shows through it. The bar
         stays fully opaque at all times; it is hidden purely by sliding off-screen. */
      transition: transform 0.42s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 0.42s;
      will-change: transform;
    }
    /* Retracts once the real footer checkout button is on screen (tapi-cart-sticky.js).
       Hidden by sliding down + visibility only — opacity stays 1 so it is always opaque. */
    .tapi-cart-stickybar.is-hidden {
      transform: translateY(130%);
      visibility: hidden;
      pointer-events: none;
    }

    /* Stack the save tag ABOVE the button, both in normal flow inside the bar's
       opaque background. The tag never straddles above the bar and is never
       absolutely positioned over the button, so page content scrolling underneath
       is fully occluded — no bleed-through, no text overlapping the button. */
    .tapi-cart-stickybar__form {
      margin: 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0.7rem;
    }

    /* Save tag — a compact pill sitting on its own line above the button. */
    .tapi-cart-stickybar__badge {
      align-self: flex-end;
      max-width: 100%;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.3rem 0.9rem;
      background: var(--tapi-ivory, #fcfaf4);
      color: var(--mor-primary, #2E4B3C);
      border: 1px solid var(--tapi-hairline, #e5ddc8);
      font-size: var(--fs-xs);
      font-weight: 600;
      letter-spacing: 0.01em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .tapi-cart-stickybar__badge svg { flex: 0 0 auto; color: var(--tapi-terracotta, #b7472a); }

    /* Checkout button — full width, deep green, serif amount for a luxe feel. */
    .tapi-cart-stickybar__btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.2rem;
      min-height: 5.6rem;
      margin: 0;
      padding: 0 1.8rem;
      border: 0;
      cursor: pointer;
      background: var(--mor-primary, #2E4B3C);
      color: var(--tapi-ivory, #fcfaf4);
      transition: transform 0.14s ease, background 0.2s ease;
    }
    .tapi-cart-stickybar__btn:active { transform: scale(0.99); }
    .tapi-cart-stickybar__cta {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      font-size: var(--fs-sm);
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .tapi-cart-stickybar__cta svg { flex: 0 0 auto; }
    .tapi-cart-stickybar__amt {
      font-family: var(--font-body-family, Inter, sans-serif);
      font-size: clamp(1.9rem, 5.4vw, 2.15rem);
      font-weight: 700;
      line-height: 1;
      letter-spacing: 0.005em;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    /* Checkout intent owns the bottom edge on the cart: hide the global mobile
       bottom nav here (mirrors the PDP, where the buy bar replaces it) so there is
       one clean CTA, not two stacked bars. */
    .template-cart .tapi-botnav { display: none !important; }

    /* The "Shop with AI" assistant pill (#ads-agent-host, a fixed shadow-DOM widget
       pinned bottom-centre) sat directly on top of the checkout bar, its text
       overlapping the button. Hide it on the cart so the checkout CTA is clean — it
       still shows on every other page. */
    .template-cart #ads-agent-host { display: none !important; }

    /* Reserve space so the fixed bar never covers the last section (featured rail).
       Overrides the bottom nav's body padding (the nav is hidden here). */
    body.template-cart { padding-bottom: calc(124px + env(safe-area-inset-bottom, 0px)) !important; }
  }

  @media (max-width: 989px) and (prefers-reduced-motion: reduce) {
    /* No motion: snap in/out via the same off-screen slide (still fully opaque),
       just with no transition. Never fade opacity. */
    .tapi-cart-stickybar { transition: none; }
    .tapi-cart-stickybar__btn:active { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Free shipping meter"
    },
    {
      "type": "checkbox",
      "id": "show_shipping_meter",
      "label": "Show free shipping progress",
      "info": "Shows how close the order is to the free shipping threshold. Keep the threshold in sync with your shipping rates.",
      "default": true
    },
    {
      "type": "number",
      "id": "shipping_threshold",
      "label": "Free shipping threshold (in rupees)",
      "default": 1500
    },
    {
      "type": "text",
      "id": "shipping_meter_text",
      "label": "Progress message",
      "info": "[amount] is replaced with what is left to add.",
      "default": "Add [amount] more for free shipping"
    },
    {
      "type": "text",
      "id": "shipping_meter_done_text",
      "label": "Unlocked message",
      "default": "Your order ships free."
    },
    {
      "type": "header",
      "content": "Smart offers panel"
    },
    {
      "type": "checkbox",
      "id": "show_smart_offers",
      "label": "Show the smart offers panel",
      "info": "Lists the codes from Theme settings → Offers with the real saving for this cart, auto-applies the biggest general one and lets the shopper switch. Keep Theme settings → Offers in sync with Discounts.",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
