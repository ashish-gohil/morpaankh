{%- comment -%}
  Optional announcement bar, merchant-toggled for sale windows. OFF by default:
  renders nothing unless "Show announcement bar" is ticked, so it adds zero
  markup when inactive. Sits at the very top, above the trust marquee.
  Activate/deactivate and edit the message from Theme editor -> Announcement bar.
{%- endcomment -%}
{%- if section.settings.enabled and section.settings.text != blank -%}
  <div class="tapi-announce" style="--ta-bg: {{ section.settings.bg_color }}; --ta-fg: {{ section.settings.text_color }};" role="region" aria-label="Announcement">
    {%- if section.settings.link != blank -%}
      <a class="tapi-announce__inner" href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      <p class="tapi-announce__inner">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .tapi-announce { background: var(--ta-bg, #2C2826); color: var(--ta-fg, #F8F4ED); }
  .tapi-announce__inner {
    margin: 0; display: block; text-align: center; color: inherit; text-decoration: none;
    padding: 0.9rem 1.6rem;
    font-family: var(--font-body-family); font-size: 1.2rem; font-weight: 500;
    letter-spacing: 0.08em; text-transform: uppercase; line-height: 1.3;
  }
  a.tapi-announce__inner { transition: opacity var(--mor-dur-base, 240ms) var(--mor-ease, ease); }
  a.tapi-announce__inner:hover { opacity: 0.82; }
  @media (max-width: 749px) {
    .tapi-announce__inner { font-size: 1.1rem; letter-spacing: 0.06em; padding: 0.8rem 1.2rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show announcement bar",
      "default": false,
      "info": "Turn on once your prepaid-discount / COD app is live, or when a sale starts."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Message",
      "info": "Keep it prepaid-focused to steer orders toward online payment (don't advertise COD up here).",
      "default": "Pay online and save 5% · Free shipping over ₹2,000"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)",
      "info": "Make the whole bar clickable, e.g. a collection."
    },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#2C2826" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F8F4ED" }
  ]
}
{% endschema %}
