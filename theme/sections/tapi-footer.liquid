<div class="tapi-footer">
  <div class="page-width">
    <div class="tapi-footer__news" data-tapi-reveal>
      <div>
        <span class="tapi-eyebrow tapi-eyebrow--line tapi-footer__news-eyebrow" data-tapi-reveal>{{ section.settings.news_eyebrow }}</span>
        <h2 class="tapi-footer__news-title">{{ section.settings.news_title }}</h2>
        <p class="tapi-footer__news-body">{{ section.settings.news_body }}</p>
      </div>
      <div class="tapi-footer__form-wrap">
        {%- form 'customer', class: 'tapi-footer__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="tapi-footer__field">
            <input type="email" name="contact[email]" required placeholder="Your email address" aria-label="Email" autocomplete="email">
            <button type="submit" class="tapi-footer__submit">Subscribe →</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="tapi-footer__form-msg">Thank you. We'll write soon.</p>
          {%- endif -%}
          <span class="tapi-footer__form-hint">No spam. Unsubscribe anytime.</span>
        {%- endform -%}
      </div>
    </div>

    <div class="tapi-footer__cols" data-tapi-stagger="80">
      <div data-tapi-reveal>
        {%- render 'tapi-logo', size: 22, as_link: true, mark: 'footer-logo.svg', word_color: 'var(--mor-gold)' -%}
        <p class="tapi-footer__about">{{ section.settings.about_blurb }}</p>
        <div class="tapi-footer__social">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" aria-label="Instagram">Instagram</a>
          {%- else -%}<a aria-label="Instagram">Instagram</a>{%- endif -%}
          <span class="tapi-footer__sep">·</span>
          {%- if settings.social_whatsapp_link != blank -%}
            <a href="{{ settings.social_whatsapp_link }}" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">WhatsApp</a>
          {%- else -%}<a aria-label="WhatsApp">WhatsApp</a>{%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        <div data-tapi-reveal {{ block.shopify_attributes }}>
          <div class="tapi-footer__col-title">{{ block.settings.title }}</div>
          {%- if block.type == 'links' -%}
            <ul class="tapi-footer__links">
              {%- assign menu = block.settings.menu -%}
              {%- if menu != blank -%}
                {%- for link in linklists[menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              {%- else -%}
                {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
                {%- for it in items -%}
                  {%- assign parts = it | split: '|' -%}
                  {%- assign label = parts[0] | strip -%}
                  {%- assign url   = parts[1] | default: '#' | strip -%}
                  {%- if label != blank -%}<li><a href="{{ url }}">{{ label }}</a></li>{%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          {%- elsif block.type == 'address' -%}
            <p class="tapi-footer__address">{{ block.settings.address }}</p>
            {%- if block.settings.cta_text != blank -%}
              {%- comment -%} "Message us" opens the store's configured WhatsApp when no
                explicit CTA link is set (falls back to the contact page if WhatsApp
                isn't configured). Reuses settings.social_whatsapp_link — no new dep. {%- endcomment -%}
              {%- liquid
                assign cta_href = block.settings.cta_link
                assign cta_external = false
                if cta_href == blank
                  if settings.social_whatsapp_link != blank
                    assign cta_href = settings.social_whatsapp_link
                    assign cta_external = true
                  else
                    assign cta_href = '/pages/contact'
                  endif
                endif
              -%}
              <a href="{{ cta_href }}" class="tapi-footer__cta"{% if cta_external %} target="_blank" rel="noopener"{% endif %}>{{ block.settings.cta_text }}</a>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="tapi-footer__mark" data-tapi-reveal aria-hidden="true">
      Mor<em>Paankh</em>
    </div>

    {%- comment -%} Payment + secure-checkout trust row. Uses the store's REAL
      enabled payment types (honest — only shows what's actually accepted) and
      hides itself entirely if payments aren't configured yet. {%- endcomment -%}
    {%- if shop.enabled_payment_types.size > 0 -%}
      <div class="tapi-footer__trust">
        <span class="tapi-footer__secure">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Secure checkout
        </span>
        <ul class="tapi-footer__pay" role="list" aria-label="Accepted payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'tapi-pay-icon' }}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="tapi-footer__bottom">
      <div class="tapi-footer__copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}. Sent with care, across India.</div>
      <div class="tapi-footer__legal">
        <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy</a>
        <a href="{{ shop.terms_of_service.url | default: '/pages/terms-of-service' }}">Terms</a>
        <a href="{{ shop.refund_policy.url | default: '/pages/refund-policy' }}">Refunds</a>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .tapi-footer { background: var(--mor-charcoal); color: var(--mor-cream); margin-top: 0; overflow: hidden; border-top: 1px solid rgba(248, 244, 237, 0.09); }
  /* footer-logo.svg uses gold strokes on a transparent bg, so it reads on the dark footer with no backing/coin. */
  /* Footer newsletter eyebrow: animated line in gold, matching other sections */
  .tapi-footer__news-eyebrow.tapi-eyebrow--line::before { background: var(--mor-gold); }
  /* One vertical rhythm for the whole footer: the top-of-footer gap, the space
     around the newsletter divider, and the columns block all share 6.4rem so the
     dark zone reads as evenly spaced bands (was a scattered 9.6 / 8 / 7.2). */
  .tapi-footer .page-width { padding-top: 6.4rem; padding-bottom: 2.4rem; }
  .tapi-footer a { color: var(--mor-cream); text-decoration: none; opacity: 0.72; transition: opacity var(--mor-dur-base) var(--mor-ease), padding-left 320ms var(--mor-ease); }
  .tapi-footer a:hover { opacity: 1; padding-left: 6px; }
  /* Logo lockup is the brand mark, not a nav link: full strength always, gold wordmark, pointer only (no dim-at-rest, no hover shift). */
  .tapi-footer a.tapi-logo,
  .tapi-footer a.tapi-logo:hover { opacity: 1; padding-left: 0; }

  .tapi-footer__news { display: grid; grid-template-columns: 1.1fr 1fr; gap: 6.4rem; padding-bottom: 6.4rem; border-bottom: 1px solid rgba(248,244,237,0.10); align-items: end; }
  .tapi-footer__news-eyebrow { color: var(--mor-gold) !important; margin-bottom: 1.6rem; display: block; }
  .tapi-footer__news-title { font-family: var(--font-heading-family); font-size: var(--mor-h2); line-height: var(--mor-leading-snug); margin: 0 0 1.2rem; font-weight: 500; letter-spacing: -0.012em; color: var(--mor-cream); }
  .tapi-footer__news-body { color: var(--mor-cream); opacity: 0.62; max-width: 46rem; font-size: var(--mor-text-sm); line-height: var(--mor-leading-body); margin: 0; }
  .tapi-footer__form { display: flex; flex-direction: column; gap: 0.8rem; }
  .tapi-footer__field { display: flex; align-items: center; border-bottom: 1px solid rgba(248,244,237,0.35); padding-bottom: 0.6rem; transition: border-color 240ms; }
  .tapi-footer__field:focus-within { border-color: var(--tapi-cream); }
  .tapi-footer__field input { flex: 1; background: transparent; color: var(--tapi-cream); border: none; font-family: inherit; font-size: 1.6rem; padding: 0.8rem 0; outline: none; }
  .tapi-footer__field input::placeholder { color: rgba(248,244,237,0.45); }
  .tapi-footer__submit { background: none; border: none; color: var(--tapi-cream); font-size: 1.1rem; letter-spacing: 0.18em; text-transform: uppercase; cursor: pointer; padding: 0.4rem 0; transition: transform 360ms cubic-bezier(0.22,1,0.36,1); }
  .tapi-footer__submit:hover { transform: translateX(6px); }
  .tapi-footer__form-hint { font-size: 1.1rem; color: rgba(248,244,237,0.6); }
  .tapi-footer__form-msg  { font-size: 1.2rem; color: var(--tapi-terracotta-soft); margin: 0; }

  .tapi-footer__cols { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 5.6rem; padding: 6.4rem 0; }
  .tapi-footer__about { color: var(--tapi-cream); opacity: 0.55; font-size: 1.3rem; max-width: 28rem; line-height: 1.7; margin: 2rem 0 2.4rem; }
  .tapi-footer__social { display: flex; gap: 1.4rem; font-size: 1.4rem; align-items: center; }
  .tapi-footer__social a { display: inline-block; padding-bottom: 0.6rem; }
  .tapi-footer__sep { opacity: 0.25; }
  .tapi-footer__col-title { font-size: 1rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--mor-gold); margin-bottom: 2rem; font-weight: 500; }
  .tapi-footer__links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.6rem; font-size: 1.4rem; }
  .tapi-footer__address { font-family: var(--font-heading-family); font-style: italic; color: var(--tapi-cream); opacity: 0.72; font-size: 1.5rem; line-height: 1.7; margin: 0; }
  .tapi-footer__cta { margin-top: 1.2rem; display: inline-block; font-size: 1.3rem; }

  .tapi-footer__mark { font-family: var(--font-heading-family); font-weight: 500; font-size: clamp(5.6rem, 18vw, 22rem); line-height: 0.95; letter-spacing: -0.028em; color: rgba(248,244,237,0.08); text-align: center; user-select: none; white-space: nowrap; padding: 0; border-top: 1px solid rgba(248,244,237,0.10); padding-top: 2rem; overflow: hidden; }
  .tapi-footer__mark em { font-style: italic; color: rgba(217,122,95,0.30); }

  /* Payment + secure-checkout row. Carries the divider after the watermark so
     the trust row + copyright read as one bottom zone (bottom bar drops its own
     border to avoid a double hairline). */
  .tapi-footer__trust { display: flex; align-items: center; justify-content: space-between; gap: 1.4rem 2.4rem; flex-wrap: wrap; padding-top: 2.4rem; border-top: 1px solid rgba(248,244,237,0.08); }
  .tapi-footer__secure { display: inline-flex; align-items: center; gap: 0.7rem; font-size: 1.1rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(248,244,237,0.66); }
  .tapi-footer__secure svg { width: 15px; height: 15px; opacity: 0.85; }
  .tapi-footer__pay { list-style: none; display: flex; flex-wrap: wrap; gap: 0.7rem; margin: 0; padding: 0; }
  .tapi-footer__pay li { display: inline-flex; }
  /* Full-colour gateway SVGs need a light chip to read on the dark footer. */
  .tapi-footer__pay .tapi-pay-icon { width: 38px; height: 24px; background: #fff; border-radius: 3px; padding: 2px 3px; box-sizing: border-box; }
  .tapi-footer__bottom { padding-top: 2rem; display: flex; justify-content: space-between; align-items: center; gap: 1.6rem; flex-wrap: wrap; font-size: 1.1rem; color: rgba(248,244,237,0.66); letter-spacing: 0.04em; }
  .tapi-footer__legal { display: flex; gap: 2.4rem; }
  @media (max-width: 749px) {
    .tapi-footer__trust { justify-content: center; text-align: center; }
  }

  @media (max-width: 989px) {
    .tapi-footer .page-width { padding-top: 4.8rem; }
    .tapi-footer__news { grid-template-columns: 1fr; gap: 2.8rem; padding-bottom: 4.8rem; }
    .tapi-footer__cols { grid-template-columns: 1fr 1fr; gap: 2.8rem; padding: 4.8rem 0; }
  }
  @media (max-width: 540px) {
    .tapi-footer__cols { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tapi footer",
  "tag": "footer",
  "class": "section",
  "settings": [
    { "type": "text",     "id": "news_eyebrow", "label": "Newsletter eyebrow", "default": "Letters from the studio" },
    { "type": "text",     "id": "news_title",   "label": "Newsletter title",   "default": "Letters from the studio." },
    { "type": "textarea", "id": "news_body",    "label": "Newsletter body",    "default": "Once a fortnight: new arrivals, the story behind the fabric, and notes from our studio." },
    { "type": "textarea", "id": "about_blurb",  "label": "About blurb",        "default": "MorPaankh comes from a family raised in India's textile trade, with cloth in its hands for generations. We bring that eye to Indian ethnic wear for every day and occasion — honest fabric, a true fit, and photographs that match what arrives." }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Use menu (optional)" },
        { "type": "textarea", "id": "items", "label": "Or paste links (label | URL per line)", "default": "Kurta Sets | /collections/kurta-sets\nCo-ord Sets | /collections/co-ord-sets\nFestive Edit | /collections/festive" }
      ]
    },
    {
      "type": "address",
      "name": "Visit / address",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Visit" },
        { "type": "textarea", "id": "address", "label": "Address", "default": "Rampura, Surat\nGujarat 395003\nMon–Sat · 10am–7pm" },
        { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Message us" },
        { "type": "url",  "id": "cta_link", "label": "CTA link" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Tapi footer",
      "blocks": [
        { "type": "links", "settings": { "title": "Shop", "items": "Kurta Sets | /collections/kurta-sets\nCo-ord Sets | /collections/co-ord-sets\nFestive Edit | /collections/festive" } },
        { "type": "links", "settings": { "title": "Help", "items": "Size guide | /pages/fabric-guide#size-guide\nExchange & returns | /pages/refund-policy\nFAQ | /pages/contact#faq" } },
        { "type": "address", "settings": { "title": "Visit", "address": "Rampura, Surat\nGujarat 395003\nMon–Sat · 10am–7pm", "cta_text": "Message us" } }
      ]
    }
  ]
}
{% endschema %}
