{%- comment -%}
  Testimonials — reviews presentation layer, honest by design.

  Renders NOTHING until the merchant adds quote blocks in the editor, so it
  can sit pre-wired in a template without showing an empty section. Add only
  real customer words (name + city keeps it verifiable). No review JSON-LD
  is emitted on purpose: aggregateRating belongs to a real reviews app with
  verifiable data, not hand-entered quotes.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
<section class="tapi-testimonials" aria-labelledby="tapi-testimonials-heading-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}
      <span class="tapi-eyebrow tapi-eyebrow--line" data-tapi-reveal>{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2 class="tapi-testimonials__heading" id="tapi-testimonials-heading-{{ section.id }}" data-tapi-reveal>
      {{ section.settings.heading | default: 'Worn and loved' }}
    </h2>

    <ul class="tapi-testimonials__rail" role="list">
      {%- for block in section.blocks -%}
        <li class="tapi-testimonials__card" data-tapi-reveal {{ block.shopify_attributes }}>
          {%- if block.settings.rating > 0 -%}
            <div class="tapi-testimonials__stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" focusable="false"{% if i > block.settings.rating %} class="is-empty"{% endif %}><path d="M10 1.8l2.5 5.1 5.6.8-4 4 .9 5.5-5-2.6-5 2.6.9-5.5-4-4 5.6-.8z" fill="currentColor"/></svg>
              {%- endfor -%}
            </div>
          {%- endif -%}
          <blockquote class="tapi-testimonials__quote">{{ block.settings.quote }}</blockquote>
          <p class="tapi-testimonials__by">
            <span class="tapi-testimonials__name">{{ block.settings.name }}</span>
            {%- if block.settings.detail != blank -%}
              <span class="tapi-testimonials__detail">{{ block.settings.detail }}</span>
            {%- endif -%}
          </p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .tapi-testimonials {
    background: var(--mor-cream-2, #F1EBDD);
    padding-block: var(--tapi-section-pad, 72px);
  }

  .tapi-testimonials .tapi-eyebrow { margin-bottom: 1.4rem; }

  .tapi-testimonials__heading {
    font-family: var(--font-heading-family);
    font-weight: 500;
    font-size: clamp(2.8rem, 4vw, 4.4rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--mor-charcoal, #2C2826);
    margin: 0 0 3.2rem;
  }

  .tapi-testimonials__rail {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.4rem;
  }

  .tapi-testimonials__card {
    background: var(--mor-cream, #F8F4ED);
    border: 1px solid rgba(44, 40, 38, 0.08);
    border-radius: var(--mor-radius-sm, 2px);
    padding: 2.8rem 2.4rem;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .tapi-testimonials__stars { display: flex; gap: 0.3rem; color: var(--mor-gold, #B08947); }
  .tapi-testimonials__stars svg.is-empty { opacity: 0.25; }

  .tapi-testimonials__quote {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 1.9rem;
    line-height: 1.5;
    color: var(--mor-charcoal, #2C2826);
    flex: 1;
  }

  .tapi-testimonials__by {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .tapi-testimonials__name {
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--mor-charcoal, #2C2826);
  }

  .tapi-testimonials__detail {
    font-size: 1.2rem;
    color: var(--mor-text-muted, #6B5D54);
  }

  @media (max-width: 989px) {
    .tapi-testimonials__rail { grid-template-columns: repeat(2, 1fr); gap: 1.8rem; }
  }

  @media (max-width: 749px) {
    .tapi-testimonials__rail {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      margin-inline: calc(-1 * var(--tapi-gutter, 2rem));
      padding-inline: var(--tapi-gutter, 2rem);
      scrollbar-width: none;
    }
    .tapi-testimonials__rail::-webkit-scrollbar { display: none; }
    .tapi-testimonials__card {
      flex: 0 0 78%;
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "From our customers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Worn and loved"
    },
    {
      "type": "paragraph",
      "content": "Add only real customer words. The section stays hidden until at least one quote exists."
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The fabric feels even better than it looks in the photos."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Customer name"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail line",
          "info": "e.g. Jaipur · Kurta set"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5,
          "info": "0 hides the stars."
        }
      ]
    }
  ],
  "presets": [{ "name": "Testimonials" }],
  "enabled_on": { "templates": ["index", "page", "product"] }
}
{% endschema %}
